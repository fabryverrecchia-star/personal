---
// En-tête de chapitre d'un univers (01 Plâtrerie, 02 Peinture, 03 Carrelage)
interface Props {
  n: string;
  nom: string;
  id: string;
}
const { n, nom, id } = Astro.props;
---

<div class="wrap chap">
  <p class="chap__k" data-reveal="fade"><span class="chap__n" aria-hidden="true">{n}</span><span class="label">{nom}</span></p>
  <h2 id={id} class="display chap__t" data-split><slot name="titre" /></h2>
  <div class="chap__lead" data-reveal="fade"><slot /></div>
</div>

<style>
  .chap {
    display: grid;
    gap: 22px;
    margin-bottom: clamp(48px, 7vw, 96px);
  }
  .chap__k {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .chap__n {
    font-family: var(--serif);
    font-size: clamp(3.4rem, 8vw, 6.5rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--argile);
  }
  .chap__t {
    font-size: var(--fs-xl);
    max-width: 12ch;
  }
  .chap__lead {
    max-width: 52ch;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .chap {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      column-gap: 6vw;
    }
    .chap__k {
      grid-column: 1 / -1;
    }
  }
</style>

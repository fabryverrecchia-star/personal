---
import logo from '../assets/svg/logo.svg?raw';
import bee from '../assets/svg/bee.svg?url';
import hermine from '../assets/svg/hermine.svg?url';
---

<section class="hero" id="top" data-hero>
  <canvas class="hero__gl" data-honey-gl aria-hidden="true"></canvas>
  <svg class="hero__fallback" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
    <path
      fill="#d0912f"
      d="M0 0h1440v70c-40 0-52 40-60 110-6 50-40 50-44 0-6-80-30-110-90-110s-80 20-86 60c-6 34-34 34-40 0-10-50-40-60-110-60s-90 30-96 150c-3 60-45 60-46 0-4-120-40-150-110-150s-86 24-92 70c-5 34-35 34-40 0C580 90 560 70 480 70s-96 40-104 90c-6 40-40 40-44 0-6-60-30-90-100-90s-94 30-100 120c-4 60-46 60-48 0C80 100 60 70 0 70z"
    ></path>
  </svg>

  <div class="hero__content wrap">
    <div class="hero__top">
      <p class="label" data-hero-fade>Miel naturel<br />des Côtes-d’Armor</p>
      <p class="label hero__top-r" data-hero-fade>Récolte 2026<br />Printemps — Été</p>
    </div>

    <h1 class="hero__title">
      <span class="sr-only">Mel Ar Bescond — miel naturel des Côtes-d’Armor</span>
      <span class="hero__logo" data-hero-logo set:html={logo} />
    </h1>

    <div class="hero__bottom">
      <p class="hero__by" data-hero-fade>
        <span class="script">par</span> Nathalie &amp; Frédéric Baltzer
      </p>
      <div class="hero__ctas" data-hero-fade>
        <a href="#boutique" class="btn" data-magnetic><span class="btn__dot"></span>Composer mon panier</a>
        <a href="#manifeste" class="hero__scroll label" aria-label="Découvrir">
          <span class="hero__scroll-line"><i></i></span>Découvrir
        </a>
      </div>
    </div>
  </div>

  <img src={bee} alt="" class="flybee" data-flybee width="120" height="96" aria-hidden="true" />
</section>

<div class="marquee" data-marquee aria-hidden="true" style={`--hermine: url(${hermine})`}>
  <div class="marquee__track" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {['Production locale', 'Familiale', 'Responsable', 'Récolte limitée', 'Cristallisation naturelle'].map((w) => (
            <span class="marquee__item">
              <span>{w}</span>
              <i class="marquee__sep" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    overflow: clip;
    background:
      radial-gradient(120% 80% at 70% 110%, color-mix(in srgb, var(--gold) 22%, transparent), transparent 60%),
      var(--cream);
  }
  .hero__gl,
  .hero__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero__fallback {
    height: 40%;
    display: none;
  }
  :global(.no-webgl) .hero__fallback {
    display: block;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
    padding-top: clamp(96px, 16vh, 170px);
    padding-bottom: clamp(24px, 5vh, 48px);
  }
  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    color: var(--ink);
    mix-blend-mode: multiply;
  }
  .hero__top-r {
    text-align: right;
  }
  .hero__title {
    align-self: center;
    justify-self: center;
    width: min(100%, 1100px);
    margin-block: 4vh;
  }
  .hero__logo {
    display: block;
    color: var(--ink);
  }
  .hero__logo :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero__logo :global(.glyph) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }
  .hero__by {
    font-size: var(--fs-lead);
    font-style: italic;
    font-weight: 380;
  }
  .hero__by .script {
    font-style: normal;
    font-size: 1.3em;
    color: var(--amber);
    margin-right: 0.15em;
  }
  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .hero__scroll {
    display: flex;
    align-items: center;
    gap: 0.8em;
  }
  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 46px;
    background: color-mix(in srgb, var(--ink) 20%, transparent);
    overflow: hidden;
  }
  .hero__scroll-line i {
    position: absolute;
    left: -1px;
    width: 3px;
    height: 14px;
    border-radius: 3px;
    background: var(--amber);
    animation: drop 2.2s var(--ease-in-out) infinite;
  }
  @keyframes drop {
    0% {
      transform: translateY(-16px);
    }
    100% {
      transform: translateY(48px);
    }
  }

  .flybee {
    position: absolute;
    z-index: 3;
    left: 0;
    top: 0;
    width: clamp(46px, 5vw, 72px);
    height: auto;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 12px 10px rgb(42 31 22 / 0.18));
  }

  .marquee {
    position: relative;
    z-index: 3;
    overflow: hidden;
    background: var(--ink);
    color: var(--cream);
    padding-block: clamp(14px, 1.6vw, 22px);
  }
  .marquee__track {
    display: flex;
    width: max-content;
  }
  .marquee__group {
    display: flex;
    flex: none;
  }
  .marquee__item {
    display: flex;
    align-items: center;
    gap: clamp(1.4rem, 3vw, 3rem);
    padding-right: clamp(1.4rem, 3vw, 3rem);
    font-size: clamp(1.4rem, 2.6vw, 2.4rem);
    font-style: italic;
    font-weight: 350;
    white-space: nowrap;
  }
  .marquee__sep {
    width: 0.5em;
    height: 0.8em;
    background: var(--gold);
    mask: var(--hermine) center / contain no-repeat;
    -webkit-mask: var(--hermine) center / contain no-repeat;
  }

  @media (max-width: 700px) {
    .hero__title {
      margin-block: 0;
    }
    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
    }
    .hero__ctas {
      width: 100%;
      justify-content: space-between;
    }
    .hero__scroll {
      display: none;
    }
    .hero__ctas .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { Content } from '../content-md/mentions-legales.md';
---
<Base title="Mentions légales" description="Mentions légales et politique de confidentialité du site Il Ristorante.">
  <section class="section wrap t-dolce" style="padding-top:calc(var(--header-h) + 8vw)">
    <h1 class="display h-xxl" data-split>Mentions <span class="script">légales</span></h1>
    <div class="grid" style="margin-top:clamp(40px,6vw,90px)">
      <div class="legal" style="grid-column:3/span 8"><Content /></div>
    </div>
  </section>
</Base>
<style>
  .legal { font-size: var(--fs-m); }
  .legal :global(h2) { font: 400 clamp(1.6rem, 1rem + 1.6vw, 2.4rem) / 1 var(--f-display); text-transform: uppercase; margin: 3rem 0 1rem; color: var(--chianti); }
  .legal :global(h3), .legal :global(h4) { font-weight: 500; margin: 2rem 0 0.6rem; }
  .legal :global(p) { margin-bottom: 0.9em; max-width: 72ch; }
  .legal :global(a) { text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  @media (max-width: 900px) { .legal { grid-column: 1 / -1 !important; } }
</style>

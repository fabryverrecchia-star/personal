---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Media from '../../components/Media.astro';
// Articles d’exemple : titres et visuels à remplacer par les contenus éditoriaux réels.
const posts = [
  { cat: 'Produit', time: '5 min', title: 'Le citron de Sicile, du zeste au limoncello', img: '/img/lemons.webp', alt: 'Citrons coupés en deux' },
  { cat: 'Recette', time: '4 min', title: 'La bruschetta, une affaire de pain grillé', img: '/img/bruschetta.webp', alt: 'Bruschetta tomate basilic' },
  { cat: 'Dolci', time: '3 min', title: 'Gelato : pourquoi il est plus dense', img: '/img/gelato.webp', alt: 'Vitrine de glaces' },
  { cat: 'Gestes', time: '6 min', title: 'Étaler une pâte à pizza, sans rouleau', img: '/img/dough.webp', alt: 'Pâte étalée à la main' },
  { cat: 'Cave', time: '4 min', title: 'Du Piémont aux Pouilles, lire une étiquette', img: '/img/wine.webp', alt: 'Bouteilles de vin italien' },
  { cat: 'Rencontre', time: '7 min', title: 'Une journée en cuisine avec la brigade', img: '/img/chef.webp', alt: 'Un chef en cuisine' },
];
---
<Base title="Blog" description="Produits, gestes, recettes : le blog Il Ristorante.">
  <PageHero image="/img/lake.webp" alt="Forêt d’automne au bord d’un lac des Dolomites" crumbs={[{ label: 'News & Fidélité', href: '/news-fidelite' }, { label: 'Blog', href: '/news-fidelite/blog' }]} short>
    <Fragment slot="title">L’Italie, ses saveurs,<br /><span class="script">ses recettes</span></Fragment>
    <Fragment slot="lead">Des produits, des gestes et des personnes. On vous raconte ?</Fragment>
  </PageHero>
  <section class="section wrap t-dolce">
    <div class="sec-head"><span class="eyebrow">Derniers articles</span><span class="idx">{posts.length}</span></div>
    <div class="cards">
      {posts.map((p, i) => (
        <a class="card" href="#" data-cursor="Lire" style={i % 3 === 1 ? 'margin-top:8vh' : undefined} data-reveal>
          <Media src={p.img} alt={p.alt} />
          <div class="meta"><span>{p.cat}</span><span>{p.time}</span></div>
          <h3>{p.title}</h3>
        </a>
      ))}
    </div>
  </section>
</Base>

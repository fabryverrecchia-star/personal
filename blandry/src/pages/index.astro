---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { site, services, zones, etapes, selection, galerie, heroPhotos, photos, palette, faqGenerale } from '../data/site';
import { u } from '../lib/url';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGenerale.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
};
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
// Positions des photos flottantes : bureau (x, y, largeur en vw) puis mobile
const spots = [
  { x: 3, y: 12, w: 10, mx: -4, my: 10, mw: 30, d: 0.6 },
  { x: 9, y: 60, w: 9, mx: 72, my: 8, mw: 27, d: 1.1 },
  { x: 76, y: 9, w: 13, mx: -6, my: 78, mw: 34, d: 0.8 },
  { x: 85, y: 55, w: 10, mx: 74, my: 80, mw: 26, d: 1.3 },
  { x: 19, y: 84, w: 8, mx: -99, my: 0, mw: 0, d: 0.9 },
  { x: 71, y: 83, w: 8, mx: -99, my: 0, mw: 0, d: 1.2 },
  { x: 21, y: 12, w: 6, mx: -99, my: 0, mw: 0, d: 0.7 },
  { x: 62, y: 11, w: 6, mx: -99, my: 0, mw: 0, d: 1 },
];
const svcImg = (slug: string) => (galerie.find((p) => p.src.src.includes(slug)) ?? galerie[0]).src;
---

<Base
  title={`${site.nom} — Peintre en bâtiment, peinture et finitions | Puy-de-Dôme`}
  description="Artisan peintre à Saint-Georges-de-Mons : peinture intérieure et extérieure, préparation des supports, boiseries et décoration. Interventions dans les Combrailles, à Riom et à Clermont-Ferrand. Visite et devis gratuits."
  schema={[faqLd]}
>
  <!-- ─── Ouverture ──────────────────────────── -->
  <section class="hero" data-hero>
    <div class="hero__floats" aria-hidden="true">
      {
        heroPhotos.map((p, i) => {
          const s = spots[i];
          return (
            <div
              class:list={['float', { 'float--desk': s.mw === 0 }]}
              data-float
              data-depth={s.d}
              style={`--x:${s.x}%;--y:${s.y}%;--w:${s.w}vw;--mx:${s.mx}%;--my:${s.my}%;--mw:${s.mw}vw`}
            >
              <Image src={p.src} alt="" widths={[320, 520]} sizes="(min-width: 900px) 14vw, 34vw" loading="eager" class="float__img" />
            </div>
          );
        })
      }
    </div>

    <div class="hero__center">
      <p class="label hero__kicker" data-hero-fade>{site.nom} · Peintre en bâtiment · Puy-de-Dôme</p>
      <h1 class="display hero__t" data-hero-title>
        <span class="line"><span class="line-inner">La peinture,</span></span>
        <span class="line"><span class="line-inner"><em>sans</em> approximation</span></span>
      </h1>
      <p class="hero__p" data-hero-fade>
        Peinture intérieure et extérieure, préparation des supports et finitions, pour les particuliers et les
        professionnels du Puy-de-Dôme.
      </p>
      <div class="hero__ctas" data-hero-fade>
        <a href="#contact" class="btn btn--solid" data-magnetic>Demander un devis</a>
        <a href="#atelier" class="cta">Découvrir l’atelier</a>
      </div>
    </div>

    <p class="hero__scroll label" data-hero-fade aria-hidden="true"><span></span>Défiler</p>
  </section>

  <!-- ─── L'atelier ──────────────────────────── -->
  <section class="atelier" id="atelier" aria-labelledby="atelier-t">
    <div class="atelier__text">
      <p class="label muted" data-reveal="fade">L’atelier</p>
      <h2 id="atelier-t" class="title atelier__t" data-split>Un artisan, une exigence, <em>chaque mètre carré.</em></h2>
      <p class="atelier__p" data-reveal="fade">
        Blandry est une entreprise de peinture en bâtiment installée à {site.adresse.ville}. Nous intervenons chez
        les particuliers comme chez les professionnels, avec une conviction : la qualité d’une finition se décide
        bien avant la dernière couche.
      </p>
      <ul class="atelier__list">
        <li data-reveal="fade"><span>I.</span> Visite et devis détaillé, gratuits</li>
        <li data-reveal="fade"><span>II.</span> Un seul interlocuteur, du devis à la réception</li>
        <li data-reveal="fade"><span>III.</span> Garantie décennale, attestation jointe au devis</li>
      </ul>
    </div>
    <figure class="atelier__media" data-parallax-wrap data-reveal="img">
      <video
        class="atelier__video"
        data-autovideo
        data-parallax
        muted
        loop
        playsinline
        preload="none"
        poster={u('/videos/metier-poster.jpg')}
        aria-label="Au travail : ponçage d’un plafond, application d’enduit, reprise des joints"
      >
        <source src={u('/videos/metier-1280.mp4')} type="video/mp4" data-src-sm={u('/videos/metier-720.mp4')} />
      </video>
      <figcaption class="label atelier__cap">Ponçage, enduit, reprise des joints</figcaption>
    </figure>
  </section>

  <!-- ─── Philosophie ────────────────────────── -->
  <section class="philo section alt" aria-labelledby="philo-t">
    <div class="wrap philo__in">
      <figure class="philo__img" data-reveal="img">
        <Image src={photos.finition.src} alt={photos.finition.alt} widths={[400, 700]} sizes="(min-width: 900px) 18vw, 48vw" />
      </figure>
      <h2 id="philo-t" class="title philo__t" data-split>La lumière ne pardonne rien</h2>
      <p class="philo__p" data-reveal="fade">
        Une lumière rasante révèle la moindre reprise, le moindre défaut de ponçage. C’est pourquoi nous consacrons à la
        préparation des supports autant de soin qu’à la peinture elle-même.
      </p>
    </div>
  </section>

  <!-- ─── Savoir-faire ───────────────────────── -->
  <section class="skills" id="savoir-faire" aria-labelledby="skills-t" data-skills>
    <p class="skills__giant display" aria-hidden="true" data-giant>
      <span>Savoir-faire&nbsp;·&nbsp;Savoir-faire&nbsp;·&nbsp;Savoir-faire&nbsp;·&nbsp;</span>
    </p>
    <div class="wrap skills__grid">
      <figure class="skills__media" data-reveal="img">
        {
          services.map((s, i) => (
            <Image
              src={svcImg(s.photo)}
              alt=""
              widths={[500, 900]}
              sizes="(min-width: 1024px) 38vw, 92vw"
              class:list={['skills__img', { 'is-on': i === 0 }]}
              data-skill-img={i}
            />
          ))
        }
      </figure>
      <div class="skills__body">
        <h2 id="skills-t" class="sr-only">Savoir-faire</h2>
        <p class="skills__intro" data-reveal="fade">
          Cinq métiers réunis autour d’un même objectif : une surface juste, durable et belle à la lumière du jour.
        </p>
        <ol class="skills__list">
          {
            services.map((s, i) => (
              <li class="skill" data-skill={i}>
                <button class="skill__head" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`skill-${s.id}`}>
                  <span class="skill__n">{roman[i]}.</span>
                  <span class="skill__t">{s.titre}</span>
                  <span class="skill__plus" aria-hidden="true" />
                </button>
                <div class="skill__body" id={`skill-${s.id}`} hidden={i !== 0}>
                  <p>{s.texte}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ─── Avant, après ───────────────────────── -->
  <section class="ba-sec section dark" id="avant-apres" aria-labelledby="ba-t">
    <div class="wrap ba-sec__in">
      <h2 id="ba-t" class="display ba-sec__t" data-split>Avant, après</h2>
      <div class="ba-sec__slider" data-reveal="fade"><BeforeAfter /></div>
      <p class="script ba-sec__sign" aria-hidden="true">la preuve par l’image</p>
    </div>
  </section>

  <!-- ─── Réalisations ───────────────────────── -->
  <section class="works section" id="realisations" aria-labelledby="works-t">
    <div class="wrap">
      <div class="works__head">
        <p class="label muted" data-reveal="fade">Réalisations</p>
        <h2 id="works-t" class="display works__t" data-split>Chantiers <em>livrés</em></h2>
      </div>
      <ul class="works__grid">
        {
          selection.map((p, i) => (
            <li class={`work work--${i}`}>
              <figure>
                <div class="work__media" data-reveal="img" data-view>
                  <Image src={p.src} alt={p.titre} widths={[500, 900, 1400]} sizes={i === 0 ? '(min-width: 1024px) 60vw, 92vw' : '(min-width: 1024px) 30vw, 80vw'} class="work__img" />
                </div>
                <figcaption class="work__cap">
                  <span class="label muted">{p.cat}</span>
                  <span class="work__t">{p.titre}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <div class="works__more" data-reveal="fade">
        <a href={u('/realisations/')} class="btn" data-magnetic>Voir toutes les réalisations</a>
      </div>
    </div>
  </section>

  <!-- ─── Déroulement ────────────────────────── -->
  <section class="proc dark" id="etapes" aria-labelledby="proc-t" data-proc>
    <div class="proc__sticky">
      <div class="wrap proc__grid">
        <div class="proc__aside">
          <p class="label muted">Déroulement</p>
          <h2 id="proc-t" class="title proc__t">De la demande de devis à la livraison</h2>
          <ol class="proc__index" aria-hidden="true">
            {etapes.map((e, i) => <li class:list={{ 'is-on': i === 0 }} data-proc-dot={i}><span>{roman[i]}.</span>{e.titre}</li>)}
          </ol>
        </div>
        <ol class="proc__list">
          {
            etapes.map((e, i) => (
              <li class:list={['pstep', { 'is-on': i === 0 }]} data-pstep={i}>
                <span class="pstep__n display" aria-hidden="true">{roman[i]}</span>
                <div class="pstep__body">
                  <span class="label pstep__d">{e.duree}</span>
                  <h3 class="title pstep__t">{e.titre}</h3>
                  <p class="pstep__p">{e.texte}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ─── Territoire ─────────────────────────── -->
  <section class="terre section" aria-labelledby="terre-t">
    <div class="wrap terre__grid">
      <div class="terre__text">
        <p class="label muted" data-reveal="fade">Territoire</p>
        <h2 id="terre-t" class="title terre__t" data-split>Une palette née <em>du Puy-de-Dôme</em></h2>
        <p class="prose" data-reveal="fade">
          Basalte des volcans, pierre de Volvic, terres de Limagne, enduits à la chaux des Combrailles : les teintes
          que nous proposons s’accordent au bâti de la région. Nous intervenons depuis {site.adresse.ville} dans un
          rayon d’une quarantaine de kilomètres.
        </p>
        <p class="terre__zones" data-reveal="fade">
          {zones.map((z) => <a href={u(`/${z.slug}/`)} class="cta">Peintre {z.dans}</a>)}
        </p>
      </div>
      <ul class="swatches" data-reveal="fade">
        {
          palette.map((c) => (
            <li class="swatch" style={`--c:${c.hex}`} tabindex="0">
              <span class="swatch__chip" />
              <span class="swatch__txt">
                <span class="title swatch__n">{c.nom}</span>
                <span class="label swatch__o">{c.origine}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq items={faqGenerale} />
  <Contact />
</Base>

<style>
  /* ─── Ouverture ─── */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .hero__floats {
    position: absolute;
    inset: 0;
  }
  .float {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    width: var(--mw);
    will-change: transform;
  }
  .float--desk {
    display: none;
  }
  .float :global(.float__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  @media (min-width: 900px) {
    .float {
      left: var(--x);
      top: var(--y);
      width: var(--w);
    }
    .float--desk {
      display: block;
    }
  }
  .hero__center {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 22px;
    text-align: center;
    padding-inline: var(--gutter);
    max-width: 1100px;
  }
  .hero__kicker {
    color: var(--muted);
  }
  .hero__t {
    font-size: clamp(2.5rem, 9.6vw, 6.6rem);
    line-height: 0.95;
  }
  .hero__t em {
    font-weight: 400;
  }
  .hero__p {
    max-width: 44ch;
    color: var(--muted);
    font-size: var(--fs-s);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 28px;
    margin-top: 6px;
  }
  .hero__scroll {
    position: absolute;
    bottom: calc(24px + env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
  }
  .hero__scroll span {
    width: 40px;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: scrollhint 2.4s var(--ease) infinite;
  }
  @keyframes scrollhint {
    0% {
      transform: scaleX(0);
    }
    50% {
      transform: scaleX(1);
      transform-origin: left;
    }
    51% {
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }

  /* ─── L'atelier ─── */
  .atelier {
    display: grid;
  }
  .atelier__text {
    display: grid;
    gap: 24px;
    align-content: center;
    padding: clamp(96px, 12vw, 160px) var(--gutter) clamp(56px, 8vw, 96px);
  }
  .atelier__t {
    font-size: var(--fs-l);
    max-width: 14ch;
  }
  .atelier__p {
    max-width: 46ch;
    color: var(--muted);
  }
  .atelier__list {
    margin-top: 12px;
    border-top: 1px solid var(--line);
    max-width: 480px;
  }
  .atelier__list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 1.05rem;
  }
  .atelier__list span {
    display: inline-block;
    width: 2.6em;
    color: var(--muted);
  }
  .atelier__media {
    position: relative;
    height: 80svh;
    overflow: hidden;
  }
  .atelier__video {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }
  .atelier__cap {
    position: absolute;
    left: 18px;
    bottom: 16px;
    color: var(--lin);
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.4);
  }
  @media (min-width: 1024px) {
    .atelier {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
    .atelier__text {
      padding-inline: var(--gutter) 6vw;
    }
    .atelier__media {
      height: auto;
    }
  }

  /* ─── Philosophie ─── */
  .philo__in {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 28px;
  }
  .philo__img {
    width: clamp(160px, 20vw, 260px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .philo__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .philo__t {
    font-size: var(--fs-l);
    max-width: 16ch;
  }
  .philo__p {
    max-width: 50ch;
    color: var(--muted);
  }

  /* ─── Savoir-faire ─── */
  .skills {
    position: relative;
    padding-block: clamp(96px, 12vw, 180px);
    overflow: hidden;
  }
  .skills__giant {
    position: relative;
    z-index: 2;
    white-space: nowrap;
    font-size: clamp(4.4rem, 17vw, 16rem);
    line-height: 1;
    pointer-events: none;
    will-change: transform;
    margin-bottom: clamp(-3rem, -5vw, -1.4rem);
  }
  .skills__giant span {
    display: inline-block;
  }
  .skills__grid {
    display: grid;
    gap: 40px;
  }
  .skills__media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
  }
  .skills__media :global(.skills__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.05);
    transition:
      opacity 0.8s var(--ease),
      transform 1.4s var(--ease-out);
  }
  .skills__media :global(.skills__img.is-on) {
    opacity: 1;
    transform: none;
  }
  .skills__body {
    display: grid;
    gap: 36px;
    align-content: end;
  }
  .skills__intro {
    max-width: 38ch;
    color: var(--muted);
  }
  .skills__list {
    border-top: 1px solid var(--line);
  }
  .skill {
    border-bottom: 1px solid var(--line);
  }
  .skill__head {
    width: 100%;
    display: grid;
    grid-template-columns: 2.8rem 1fr auto;
    align-items: baseline;
    gap: 8px;
    padding: 20px 0;
    text-align: left;
  }
  .skill__n {
    font-family: var(--serif);
    color: var(--muted);
  }
  .skill__t {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.2;
    transition: transform 0.6s var(--ease);
  }
  .skill__head[aria-expanded='true'] .skill__t {
    font-style: italic;
  }
  @media (hover: hover) {
    .skill__head:hover .skill__t {
      transform: translateX(10px);
    }
  }
  .skill__plus {
    position: relative;
    width: 12px;
    height: 12px;
    align-self: center;
    transition: transform 0.6s var(--ease);
  }
  .skill__plus::before,
  .skill__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 1px;
    background: currentColor;
  }
  .skill__plus::after {
    transform: rotate(90deg);
  }
  .skill__head[aria-expanded='true'] .skill__plus {
    transform: rotate(135deg);
  }
  .skill__body {
    overflow: hidden;
  }
  .skill__body p {
    padding: 0 0 24px 2.8rem;
    max-width: 54ch;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .skills__grid {
      grid-template-columns: 5fr 6fr;
      gap: 7vw;
      align-items: end;
    }
  }

  /* ─── Avant, après ─── */
  .ba-sec__in {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .ba-sec__t {
    position: relative;
    z-index: 2;
    font-size: clamp(3.4rem, 13vw, 12rem);
    text-align: center;
    margin-bottom: clamp(-3rem, -4vw, -1rem);
    pointer-events: none;
  }
  .ba-sec__slider {
    width: min(100%, 520px);
  }
  .ba-sec__sign {
    position: relative;
    z-index: 2;
    margin-top: 22px;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1;
    color: var(--argile);
  }

  /* ─── Réalisations ─── */
  .works__head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(48px, 7vw, 96px);
  }
  .works__t {
    font-size: var(--fs-xl);
  }
  .works__grid {
    display: grid;
    gap: clamp(40px, 6vw, 80px) 4vw;
  }
  .work figure {
    display: grid;
    gap: 14px;
  }
  .work__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 100%;
  }
  .work--0 .work__media {
    aspect-ratio: 4 / 3;
  }
  .work__media :global(.work__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }
  @media (hover: hover) {
    .work:hover :global(.work__img) {
      transform: scale(1.04);
    }
  }
  .work__cap {
    display: grid;
    gap: 2px;
  }
  .work__t {
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  /* Mobile : rythme éditorial décalé */
  .work--1,
  .work--3 {
    width: 78%;
    justify-self: end;
  }
  .work--2,
  .work--4 {
    width: 84%;
  }
  @media (min-width: 900px) {
    .works__grid {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }
    .work {
      width: auto !important;
    }
    .work--0 {
      grid-column: 1 / 8;
    }
    .work--1 {
      grid-column: 9 / 13;
      margin-top: 18vw;
    }
    .work--2 {
      grid-column: 1 / 5;
    }
    .work--3 {
      grid-column: 5 / 9;
      margin-top: 8vw;
    }
    .work--4 {
      grid-column: 9 / 13;
    }
  }
  .works__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(56px, 8vw, 110px);
  }


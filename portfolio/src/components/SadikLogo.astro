---
// Logo SADIK : SVG exact (rendu serveur) + composition WebGL au défilement.
// Sans JavaScript, sans WebGL ou avec « mouvement réduit », le SVG reste affiché tel quel.
import { sadikSvg } from '../brand/sadik';

interface Props {
  id?: string;
}
const { id = 'sadik' } = Astro.props;
const svg = sadikSvg({ id, attrs: 'class="sadik__svg" preserveAspectRatio="xMidYMid meet"' });
---

<section class="sadik" data-sadik aria-label="Logo SADIK">
  <div class="sadik__stage" data-sadik-stage>
    <div class="sadik__logo" data-sadik-logo set:html={svg} />
    <p class="sadik__hint label" data-sadik-hint aria-hidden="true">(Défiler pour composer)</p>
  </div>
</section>

<style>
  .sadik {
    --sadik-bg: #0f110e;
    position: relative;
    /* Passe sous l'en-tête fixe (main réserve sa hauteur) */
    margin-top: calc(var(--header-h) * -1);
    background: var(--sadik-bg);
    color: #efede8;
  }
  /* Piste de défilement : n'existe que lorsque la composition WebGL est active */
  .sadik.is-live {
    height: 320svh;
  }
  .sadik__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + 1rem) var(--margin) var(--margin);
    overflow: hidden;
  }
  .sadik.is-live .sadik__stage {
    position: sticky;
    top: 0;
    height: 100svh;
  }
  .sadik__stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Emplacement final du logo (proportions 1662 × 442), aussi utilisé comme repère par le WebGL */
  .sadik__logo {
    position: relative;
    z-index: 1;
    width: min(100%, 1400px, (100svh - var(--header-h) - 6rem) * 3.76);
    aspect-ratio: 1662 / 442;
  }
  .sadik__logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sadik.is-live .sadik__logo {
    opacity: 0;
  }
  .sadik__hint {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: var(--margin);
    translate: -50% 0;
    color: rgb(239 237 232 / 0.6);
    white-space: nowrap;
  }
  .sadik:not(.is-live) .sadik__hint {
    display: none;
  }

  @media (max-width: 800px), (orientation: portrait) {
    .sadik.is-live {
      height: 260svh;
    }
    .sadik__stage {
      padding-inline: 16px;
    }
    .sadik__logo {
      width: 100%;
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Media from '../../components/Media.astro';
import Sticker from '../../components/Sticker.astro';
import CtaBand from '../../components/CtaBand.astro';

const commitments = [
  { title: 'Sourcing direct', script: 'en Italie', text: 'On achète directement auprès de producteurs italiens que l’on connaît. Nos partenariats AOP : Parmigiano Reggiano et Prosciutto di Parma.' },
  { title: 'Fait maison', script: 'chaque jour', text: 'Des chefs de cuisine et des brigades dans chaque restaurant. Les sauces mijotent ici, la pâte est étalée à la main.' },
  { title: 'La saison', script: 'avant tout', text: 'Une carte qui change avec les saisons, des produits bruts mis en avant, et le temps qu’il faut : affinage, maturation, cuisson.' },
];
---
<Base title="Nos engagements" description="Sourcing direct en Italie, AOP, cuisine faite maison et respect des saisons : les engagements Il Ristorante.">
  <PageHero image="/img/parmesan.webp" alt="Meules de Parmigiano Reggiano en cave d’affinage" crumbs={[{ label: 'News & Fidélité', href: '/news-fidelite' }, { label: 'Nos engagements', href: '/news-fidelite/nos-engagements' }]} short>
    <Fragment slot="title">L’ingrédient<br /><span class="script">au centre</span></Fragment>
    <Fragment slot="lead">Dire d’où vient un produit et comment on le travaille, sans artifice. C’est notre façon de prendre soin de vous.</Fragment>
    <Sticker shape="stickers-04" style="right:calc(var(--gutter) + 3vw);top:26vh;width:clamp(150px,15vw,220px)">AOP<small>Parme · Reggio</small></Sticker>
  </PageHero>

  <section class="section wrap t-dolce">
    <div class="sec-head"><span class="eyebrow">Noi cuciniamo</span><span class="idx">I.</span></div>
    <div class="cols">
      {commitments.map((c) => (
        <div class="col" data-reveal>
          <h3>{c.title}<span class="script">{c.script}</span></h3>
          <p>{c.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap t-dolce" style="padding-top:0">
    <div class="split">
      <Media src="/img/chef-2.webp" alt="Un chef prépare des champignons en cuisine" />
      <div class="txt">
        <p class="eyebrow">Durer</p>
        <h2 class="display h-xl" data-split>Bon, propre <span class="script">et juste</span></h2>
        <div class="body-text" data-reveal>
          <p>Un sourcing responsable, le respect de la saisonnalité, la valorisation du produit brut : on cuisine comme on aime manger.</p>
          <p>Et on prend le temps d’expliquer nos choix, à table comme ici.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand href="/decouvrir" label="Découvrir la carte" theme="t-giardino">Le vrai <span class="script">dans l’assiette</span></CtaBand>
</Base>

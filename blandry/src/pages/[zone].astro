---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { site, zones, services, etapes, realisations, teinte, type Zone } from '../data/site';
import { u } from '../lib/url';

export function getStaticPaths() {
  return zones.map((z) => ({ params: { zone: z.slug }, props: { z } }));
}
const { z } = Astro.props as { z: Zone };
const autres = zones.filter((o) => o.slug !== z.slug);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const listeCommunes = z.communes.slice(0, -1).join(', ') + ' et ' + z.communes.at(-1);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Peinture en bâtiment',
    name: `Peintre en bâtiment ${z.dans}`,
    provider: { '@id': `${site.url}/#entreprise` },
    areaServed: z.communes.map((c) => ({ '@type': 'City', name: c })),
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: z.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: `Peintre ${z.dans}`, item: pageUrl },
    ],
  },
];
---

<Base title={`${z.titreSeo} | ${site.nom}`} description={z.descriptionSeo} schema={schema}>
  <section class="zhero">
    <div class="wrap zhero__grid">
      <div class="zhero__text">
        <nav class="crumbs" aria-label="Fil d’Ariane" data-hero-fade>
          <a href={u('/')} class="link-u">Accueil</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Peintre {z.dans}</span>
        </nav>
        <h1 class="zhero__t serif" data-hero-title>
          <span class="line"><span class="line-inner">Peintre en bâtiment</span></span>
          <span class="line"><span class="line-inner"><em>{z.dans}</em></span></span>
        </h1>
        <p class="zhero__lede" data-hero-fade>{z.intro}</p>
        <div class="zhero__ctas" data-hero-fade>
          <a href="#contact" class="btn" data-magnetic>
            Demander un devis gratuit
            <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
          </a>
          <a href={u('/#realisations')} class="btn btn--ghost">Nos réalisations</a>
        </div>
      </div>
      <div class="zhero__ba" data-hero-fade>
        <BeforeAfter eager />
      </div>
    </div>
  </section>

  <section class="section zterrain" aria-labelledby="terrain-t">
    <div class="wrap">
      <p class="eyebrow eyebrow--dot muted">Notre approche</p>
      <h2 id="terrain-t" class="serif zsec__t" data-split>
        Un travail adapté <em>à votre logement.</em>
      </h2>
      <ul class="tcards">
        {
          z.terrain.map((c) => (
            <li class="tcard" data-reveal="fade">
              <h3 class="tcard__t">{c.titre}</h3>
              <p class="muted">{c.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section zworks" aria-labelledby="zworks-t">
    <div class="wrap">
      <p class="eyebrow eyebrow--dot muted">Réalisations</p>
      <h2 id="zworks-t" class="serif zsec__t" data-split>Quelques chantiers <em>récents.</em></h2>
      <ul class="zworks__grid">
        {
          realisations.slice(0, 2).map((r) => (
            <li class="zwork" data-reveal="fade">
              <div class="zwork__media">
                <Image src={r.image} alt={r.alt} widths={[400, 800]} sizes="(min-width: 800px) 45vw, 100vw" />
              </div>
              <p class="zwork__t">{r.titre}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section zserv" aria-labelledby="zserv-t">
    <div class="wrap zserv__grid">
      <div>
        <p class="eyebrow eyebrow--dot muted">Savoir-faire</p>
        <h2 id="zserv-t" class="serif zsec__t" data-split>Nos prestations <em>{z.dans}</em></h2>
      </div>
      <ul class="slist">
        {
          services.map((s) => (
            <li data-reveal="fade">
              <a href={u(`/#${s.id}`)} class="srow">
                <span class="srow__dot" style={`--c:${teinte(s.teinte).hex}`} />
                <span class="srow__t">{s.titre}</span>
                <span class="srow__c muted">{s.court}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section zsteps" aria-labelledby="zsteps-t">
    <div class="wrap">
      <p class="eyebrow eyebrow--dot">Déroulement</p>
      <h2 id="zsteps-t" class="serif zsec__t" data-split>De la demande <em>à la livraison.</em></h2>
      <ol class="zsteps__list">
        {
          etapes.map((e, i) => (
            <li data-reveal="fade">
              <span class="zsteps__n serif">{String(i + 1).padStart(2, '0')}</span>
              <strong>{e.titre}</strong>
              <span class="zsteps__d">{e.duree}</span>
            </li>
          ))
        }
      </ol>
      <p class="zsteps__more"><a href={u('/#etapes')} class="link-u">Voir le détail de chaque étape</a></p>
    </div>
  </section>

  <section class="section zcom" aria-labelledby="zcom-t">
    <div class="wrap zcom__in">
      <h2 id="zcom-t" class="eyebrow eyebrow--dot muted">Communes desservies</h2>
      <p class="zcom__p" data-reveal="fade">
        Nous intervenons notamment à {listeCommunes}. Votre commune n’apparaît pas ? Contactez-nous :
        la visite reste gratuite dans un rayon d’environ quarante kilomètres autour de {site.adresse.ville}.
      </p>
    </div>
  </section>

  <Faq items={z.faq} titre="Questions fréquentes" />

  <section class="section zother" aria-labelledby="zother-t">
    <div class="wrap">
      <p id="zother-t" class="eyebrow eyebrow--dot muted">Nous intervenons également</p>
      <ul class="olist">
        {
          autres.map((o) => (
            <li>
              <a href={u(`/${o.slug}/`)} class="orow">
                <span class="serif">Peintre {o.dans}</span>
                <span class="muted">{o.court}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Contact zone={z.dans} />
</Base>

<style>
  .zhero {
    padding-top: calc(110px + env(safe-area-inset-top));
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .zhero__grid {
    display: grid;
    gap: 40px;
  }
  .zhero__text {
    display: grid;
    gap: 24px;
    align-content: center;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: var(--fs-s);
    color: var(--muted);
  }
  .zhero__t {
    font-size: clamp(2.8rem, 10vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }
  .zhero__t em {
    color: var(--tuile);
  }
  .zhero__lede {
    max-width: 50ch;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .zhero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (min-width: 1024px) {
    .zhero__grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .zhero__ba {
      max-width: 460px;
      width: 100%;
      justify-self: end;
    }
  }

  .zsec__t {
    font-size: var(--fs-xl);
    max-width: 16ch;
    margin-top: 16px;
    text-wrap: balance;
  }
  .zterrain,
  .zworks,
  .zserv,
  .zcom {
    padding-top: 0;
  }
  .tcards {
    display: grid;
    gap: 14px;
    margin-top: 40px;
  }
  .tcard {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 28px;
    border-radius: calc(var(--radius) * 1.3);
    background: #f7f4ee;
    box-shadow: 0 0 0 1px var(--line);
  }
  .tcard__t {
    font-size: var(--fs-m);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  @media (min-width: 900px) {
    .tcards {
      grid-template-columns: repeat(3, 1fr);
    }
    .tcard {
      padding: 36px;
    }
  }

  .zworks__grid {
    display: grid;
    gap: 24px;
    margin-top: 40px;
  }
  .zwork {
    display: grid;
    gap: 12px;
  }
  .zwork__media {
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--chaux-2);
  }
  .zwork__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zwork__t {
    font-weight: 500;
  }
  @media (min-width: 800px) {
    .zworks__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .zserv__grid {
    display: grid;
    gap: 32px;
  }
  .slist {
    border-top: 1px solid var(--line);
  }
  .srow {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease);
  }
  .srow__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }
  .srow__t {
    font-size: 1.15rem;
    font-weight: 500;
  }
  .srow__c {
    grid-column: 2;
    font-size: var(--fs-s);
  }
  @media (hover: hover) {
    .srow:hover {
      padding-left: 10px;
    }
  }
  @media (min-width: 1024px) {
    .zserv__grid {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }

  .zsteps {
    background: var(--ink);
    color: var(--chaux);
    --line: rgb(255 255 255 / 0.14);
  }
  .zsteps .zsec__t em {
    color: var(--limagne);
  }
  .zsteps__list {
    display: grid;
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .zsteps__list li {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .zsteps__n {
    font-size: 1.6rem;
    font-style: italic;
    color: var(--limagne);
  }
  .zsteps__d {
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
    text-align: right;
  }
  .zsteps__more {
    margin-top: 28px;
    font-size: var(--fs-s);
  }
  @media (min-width: 900px) {
    .zsteps__list {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 32px;
    }
  }

  .zcom__in {
    display: grid;
    gap: 16px;
    max-width: 900px;
  }
  .zcom__p {
    font-size: 1.1rem;
    color: var(--muted);
  }

  .olist {
    margin-top: 24px;
    display: grid;
    gap: 12px;
  }
  .orow {
    display: grid;
    gap: 6px;
    padding: 28px;
    border-radius: calc(var(--radius) * 1.3);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.4s;
  }
  .orow .serif {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1;
  }
  @media (hover: hover) {
    .orow:hover {
      background: #f7f4ee;
    }
  }
  @media (min-width: 900px) {
    .olist {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Fan from '../components/Fan.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Marquee from '../components/Marquee.astro';
import { site, services, nuancier, zones, methode, faqGenerale, teinte } from '../data/site';
import { u } from '../lib/url';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGenerale.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
const communesVedette = [
  'Saint-Gervais-d’Auvergne', 'Riom', 'Pontaumur', 'Chamalières', 'Saint-Éloy-les-Mines', 'Châtel-Guyon',
  'Pontgibaud', 'Volvic', 'Manzat', 'Clermont-Ferrand', 'Combronde', 'Royat', 'Les Ancizes-Comps', 'Mozac',
];
---

<Base
  title={`${site.nom} — Peintre en bâtiment dans les Combrailles, à Riom et Clermont-Ferrand`}
  description="Artisan peintre installé dans les Combrailles : peinture intérieure, façades, volets et boiseries, conseil couleur. On intervient de Saint-Gervais-d’Auvergne à Riom et Clermont-Ferrand. Devis gratuit."
  schema={[faqLd]}
>
  <!-- ─── Hero ─────────────────────────────────── -->
  <section class="hero" data-hero>
    <div class="wrap hero__grid">
      <p class="eyebrow eyebrow--dot hero__eye" data-hero-fade>
        Artisan peintre · Puy-de-Dôme
      </p>

      <h1 class="hero__t serif" data-hero-title>
        <span class="line"><span class="line-inner">Peintre</span></span>
        <span class="line hero__brushline">
          <span class="line-inner">
            <em class="hero__brushword">
              des Combrailles,
              <svg class="brush" viewBox="0 0 600 70" preserveAspectRatio="none" aria-hidden="true">
                <path
                  data-brush
                  d="M8 44 C 90 30, 170 52, 260 38 S 430 30, 520 40 S 580 36, 592 34"
                  pathLength="1"></path>
              </svg>
            </em>
          </span>
        </span>
        <span class="line"><span class="line-inner">de Riom à Clermont.</span></span>
      </h1>

      <div class="hero__fan" data-hero-fan>
        <Fan />
      </div>

      <div class="hero__foot" data-hero-fade>
        <p class="hero__lede">
          Peinture intérieure, façades, volets et boiseries. Préparés avec soin, posés juste — par un
          artisan d’ici, qui connaît vos murs.
        </p>
        <div class="hero__ctas">
          <a href="#contact" class="btn" data-magnetic>
            Demander un devis
            <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
          </a>
          <a href="#services" class="btn btn--ghost">Nos services</a>
        </div>
      </div>
    </div>
  </section>

  <Marquee items={communesVedette} label="Communes où nous intervenons" />

  <!-- ─── Manifeste ────────────────────────────── -->
  <section class="manifesto section" aria-label="Notre approche">
    <div class="wrap grid">
      <p class="eyebrow eyebrow--dot muted manifesto__eye">Le métier</p>
      <p class="manifesto__t serif" data-words>
        On n’est pas une entreprise de rénovation qui fait aussi de la peinture. <em>On est peintres.</em>
        On prépare, on protège, on pose la couleur — et on connaît les murs d’ici, du granit des
        Combrailles à la pierre de Volvic.
      </p>
    </div>
  </section>

  <!-- ─── Services ─────────────────────────────── -->
  <section class="services" id="services" aria-labelledby="services-t">
    <div class="wrap services__head">
      <p class="eyebrow eyebrow--dot muted">Services</p>
      <h2 id="services-t" class="serif services__t" data-split>
        Tout ce qui touche <em>à la couleur.</em>
      </h2>
    </div>
    <div class="wrap stack" data-stack>
      {
        services.map((s, i) => {
          const t = teinte(s.teinte);
          return (
            <article
              class="card"
              id={s.id}
              data-card
              style={`--c:${t.hex};--ink:${t.ink};--i:${i}`}
            >
              <div class="card__in">
                <div class="card__top">
                  <span class="card__n">0{i + 1} / 0{services.length}</span>
                  <span class="card__swatch">
                    <i />
                    {t.nom}
                  </span>
                </div>
                <span class="card__big serif" aria-hidden="true">{i + 1}</span>
                <div class="card__body">
                  <h3 class="serif card__t">{s.titre}</h3>
                  <div class="card__text">
                    <p class="card__court">{s.court}</p>
                    <p>{s.texte}</p>
                    <ul class="card__pts">
                      {s.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- ─── Nuancier ─────────────────────────────── -->
  <section class="nuancier section" id="nuancier" data-nuancier aria-labelledby="nuancier-t">
    <div class="wrap">
      <div class="nuancier__head">
        <p class="eyebrow eyebrow--dot">Le nuancier du pays</p>
        <h2 id="nuancier-t" class="serif nuancier__t" data-split>
          Des teintes qu’on croise <em>en allant au chantier.</em>
        </h2>
      </div>

      <div class="nuancier__stage" aria-live="polite">
        <p class="nuancier__name serif" data-nu-name>{nuancier[1].nom}</p>
        <p class="nuancier__meta">
          <span data-nu-lieu>{nuancier[1].lieu}</span>
          <span data-nu-hex>{nuancier[1].hex}</span>
        </p>
      </div>

      <div class="nuancier__row" role="radiogroup" aria-label="Choisir une teinte">
        {
          nuancier.map((t, i) => (
            <button
              class="nu"
              role="radio"
              aria-checked={i === 1 ? 'true' : 'false'}
              data-nu
              data-hex={t.hex}
              data-ink={t.ink}
              data-nom={t.nom}
              data-lieu={t.lieu}
              style={`--c:${t.hex}`}
            >
              <span class="nu__dot" />
              <span class="nu__lab">{t.nom}</span>
            </button>
          ))
        }
      </div>
      <p class="nuancier__note">
        On vient avec de vrais échantillons, et on les pose au mur chez vous : une couleur se choisit à la
        lumière de la pièce.
      </p>
    </div>
  </section>

  <!-- ─── Secteurs ─────────────────────────────── -->
  <section class="zones section" id="secteurs" aria-labelledby="zones-t">
    <div class="wrap">
      <div class="zones__head grid">
        <p class="eyebrow eyebrow--dot muted zones__eye">Secteurs</p>
        <h2 id="zones-t" class="serif zones__t" data-split>
          D’ici, <em>pour ici.</em>
        </h2>
        <p class="zones__lede" data-reveal="fade">
          Installés dans les Combrailles, on travaille dans un rayon qu’on connaît par cœur : le plateau,
          la vallée de la Sioule, Riom et la Limagne, Clermont et ses Puys. Pas de sous-traitance, pas de
          déplacement facturé.
        </p>
      </div>

      <ul class="zlist">
        {
          zones.map((z, i) => {
            const t = teinte(z.teinte);
            return (
              <li style={`--c:${t.hex};--ink:${t.ink}`}>
                <a href={u(`/${z.slug}/`)} class="zrow" data-zrow>
                  <span class="zrow__fill" aria-hidden="true" />
                  <span class="zrow__n">0{i + 1}</span>
                  <span class="zrow__name serif">{z.nom}</span>
                  <span class="zrow__court">{z.court}</span>
                  <span class="zrow__go" aria-hidden="true">
                    <svg viewBox="0 0 16 16"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                  </span>
                  <span class="sr-only">— voir la page peintre {z.nom}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- ─── Méthode ──────────────────────────────── -->
  <section class="method section" aria-labelledby="method-t">
    <div class="wrap">
      <p class="eyebrow eyebrow--dot muted">Méthode</p>
      <h2 id="method-t" class="serif method__t" data-split>
        Quatre temps, <em>zéro surprise.</em>
      </h2>
      <div class="steps" data-steps>
        <span class="steps__line" aria-hidden="true"><span data-steps-line></span></span>
        <ol class="steps__list">
        {
          methode.map((m) => (
            <li class="step" data-reveal="fade">
              <span class="step__n serif">{m.n}</span>
              <h3 class="step__t">{m.titre}</h3>
              <p class="muted">{m.texte}</p>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </section>

  <Faq items={faqGenerale} />
  <Contact />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(96px + env(safe-area-inset-top));
    padding-bottom: 32px;
    display: flex;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr auto;
    gap: 24px;
  }
  .hero__eye {
    color: var(--muted);
  }
  .hero__t {
    font-size: clamp(3.1rem, 12.4vw, 11.5rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .hero__brushline {
    overflow: visible;
  }
  .hero__brushline .line-inner {
    clip-path: inset(-10% -10% 0 -10%);
  }
  .hero__brushword {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .brush {
    position: absolute;
    left: -2%;
    right: -3%;
    bottom: 0.02em;
    width: 105%;
    height: 0.34em;
    z-index: -1;
    overflow: visible;
  }
  .brush path {
    fill: none;
    stroke: var(--limagne);
    stroke-width: 26;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0.9;
  }
  .js .brush path {
    stroke-dashoffset: 1;
  }
  .hero__fan {
    display: grid;
    place-items: center;
    padding-top: 12px;
    min-height: clamp(240px, 58vw, 460px);
  }
  .hero__foot {
    display: grid;
    gap: 22px;
    align-self: end;
  }
  .hero__lede {
    max-width: 38ch;
    font-size: 1.05rem;
    color: var(--muted);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: auto 1fr auto;
      column-gap: 28px;
    }
    .hero__eye {
      grid-column: 1 / -1;
    }
    .hero__t {
      grid-column: 1 / 9;
      grid-row: 2;
      align-self: center;
      font-size: min(9.6vw, 11rem);
    }
    .hero__fan {
      grid-column: 9 / -1;
      grid-row: 2;
      min-height: 0;
    }
    .hero__fan :global(.fan) {
      --w: min(6.4vw, 96px);
      --h: min(29vw, 420px);
    }
    .hero__foot {
      grid-column: 1 / -1;
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  /* Manifeste */
  .manifesto__eye {
    grid-column: 1 / -1;
    margin-bottom: 28px;
  }
  .manifesto__t {
    grid-column: 1 / -1;
    font-size: clamp(2rem, 5.2vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .manifesto__t em {
    color: var(--tuile);
  }
  @media (min-width: 1024px) {
    .manifesto__eye {
      grid-column: 1 / 3;
      margin-top: 1.2em;
    }
    .manifesto__t {
      grid-column: 3 / -1;
    }
  }

  /* Services : cartes empilées */
  .services {
    padding-bottom: clamp(80px, 12vw, 160px);
  }
  .services__head {
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .services__t {
    font-size: var(--fs-xl);
    margin-top: 16px;
    max-width: 14ch;
  }
  .stack {
    display: grid;
    gap: 16px;
  }
  .card {
    position: sticky;
    top: calc(84px + var(--i) * 12px);
    scroll-margin-top: 90px;
  }
  .card__in {
    background: var(--c);
    color: var(--ink);
    border-radius: calc(var(--radius) * 1.6);
    padding: clamp(22px, 4vw, 56px);
    min-height: min(640px, calc(100svh - 120px));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    transform-origin: 50% 0;
    box-shadow: 0 -20px 60px -30px rgb(0 0 0 / 0.35);
    will-change: transform;
  }
  .card__in {
    position: relative;
    overflow: hidden;
  }
  .card__big {
    position: absolute;
    right: -0.04em;
    top: -0.12em;
    font-size: clamp(14rem, 44vw, 34rem);
    line-height: 1;
    font-style: italic;
    opacity: 0.12;
    pointer-events: none;
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .card__swatch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .card__swatch i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 1px currentColor;
  }
  .card__body {
    display: grid;
    gap: 28px;
  }
  .card__t {
    font-size: clamp(2.6rem, 8.4vw, 7.4rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .card__text {
    display: grid;
    gap: 16px;
    max-width: 46ch;
  }
  .card__court {
    font-size: var(--fs-m);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .card__text > p:not(.card__court) {
    opacity: 0.8;
  }
  .card__pts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .card__pts li {
    font-size: var(--fs-s);
    padding: 7px 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 30%, transparent);
  }
  @media (min-width: 1024px) {
    .card__body {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
    }
  }

  /* Nuancier */
  .nuancier {
    --nu: #56595c;
    --nu-ink: #f3efe7;
    background: var(--nu);
    color: var(--nu-ink);
    transition: background-color 0.9s var(--ease), color 0.9s var(--ease);
    overflow: hidden;
  }
  .nuancier__t {
    font-size: var(--fs-l);
    margin-top: 16px;
    max-width: 18ch;
  }
  .nuancier__stage {
    margin-top: clamp(48px, 9vw, 120px);
    min-height: 1.8em;
  }
  .nuancier__name {
    font-size: clamp(3.6rem, 15vw, 15rem);
    line-height: 0.85;
    letter-spacing: -0.045em;
    font-style: italic;
  }
  .nuancier__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    font-size: var(--fs-s);
  }
  .nuancier__meta [data-nu-hex] {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .nuancier__row {
    display: flex;
    gap: 10px;
    margin: 40px calc(var(--gutter) * -1) 0;
    padding: 4px var(--gutter) 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .nuancier__row::-webkit-scrollbar {
    display: none;
  }
  .nu {
    flex: none;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 8px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 28%, transparent);
    font-size: var(--fs-s);
    transition: background-color 0.4s, box-shadow 0.4s;
  }
  .nu[aria-checked='true'] {
    background: color-mix(in srgb, currentColor 14%, transparent);
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .nu__dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 1.5px color-mix(in srgb, currentColor 50%, transparent);
  }
  .nuancier__note {
    margin-top: 32px;
    max-width: 44ch;
    opacity: 0.75;
  }

  /* Secteurs */
  .zones__eye {
    grid-column: 1 / -1;
  }
  .zones__t {
    grid-column: 1 / -1;
    font-size: var(--fs-xxl);
    margin-top: 16px;
  }
  .zones__lede {
    grid-column: 1 / -1;
    margin-top: 24px;
    max-width: 44ch;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .zones__t {
      grid-column: 1 / 8;
    }
    .zones__lede {
      grid-column: 9 / -1;
      align-self: end;
    }
  }
  .zlist {
    margin-top: clamp(48px, 7vw, 96px);
    border-top: 1px solid var(--line);
  }
  .zrow {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'n name go' 'n court go';
    align-items: center;
    column-gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
    overflow: hidden;
    transition: color 0.5s var(--ease), padding 0.6s var(--ease);
  }
  .zrow__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.6s var(--ease);
  }
  .zrow__n {
    grid-area: n;
    align-self: start;
    font-size: var(--fs-xs);
    padding-top: 0.8em;
    color: var(--muted);
  }
  .zrow__name {
    grid-area: name;
    font-size: clamp(2.6rem, 9.5vw, 8.6rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .zrow__court {
    grid-area: court;
    color: var(--muted);
    font-size: var(--fs-s);
    margin-top: 6px;
  }
  .zrow__go {
    grid-area: go;
    width: clamp(44px, 6vw, 72px);
    height: clamp(44px, 6vw, 72px);
    border-radius: 50%;
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 0.6s var(--ease), background 0.4s;
  }
  .zrow__go svg {
    width: 38%;
  }
  .zrow__n::before {
    content: '';
    display: block;
    width: 10px;
    height: 10px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--c);
  }
  @media (min-width: 1024px) {
    .zrow {
      grid-template-columns: 80px 1fr 320px auto;
      grid-template-areas: 'n name court go';
      column-gap: 24px;
      padding: 30px 0;
    }
    .zrow__court {
      margin: 0;
    }
  }
  @media (hover: hover) {
    .zrow:hover {
      color: var(--ink);
      padding-inline: 24px;
    }
    .zrow:hover .zrow__fill {
      clip-path: inset(0 0 0 0);
    }
    .zrow:hover .zrow__n,
    .zrow:hover .zrow__court {
      color: inherit;
      opacity: 0.75;
    }
    .zrow:hover .zrow__go {
      transform: rotate(45deg);
      background: var(--ink);
      color: var(--c);
    }
  }

  /* Méthode */
  .method__t {
    font-size: var(--fs-xl);
    margin-top: 16px;
  }
  .steps {
    position: relative;
    margin-top: clamp(48px, 7vw, 96px);
    padding-left: 32px;
  }
  .steps__list {
    display: grid;
    gap: 40px;
  }
  .steps__line {
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--line);
  }
  .steps__line span {
    position: absolute;
    inset: 0;
    background: var(--tuile);
    transform-origin: 0 0;
    transform: scaleY(var(--p, 1));
  }
  .step {
    display: grid;
    gap: 10px;
  }
  .step__n {
    font-size: 3.4rem;
    line-height: 1;
    font-style: italic;
    color: var(--tuile);
  }
  .step__t {
    font-size: var(--fs-m);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  @media (min-width: 900px) {
    .steps {
      padding: 40px 0 0;
    }
    .steps__list {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
    .steps__line {
      top: 0;
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 1px;
    }
    .steps__line span {
      transform: scaleX(var(--p, 1));
    }
  }
</style>

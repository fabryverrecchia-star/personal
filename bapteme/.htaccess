# Baptême de Lou — réglages Apache
# (no "Options" line on purpose: many shared hosts forbid it and answer 500 for the whole site)
DirectoryIndex index.html

# Private files
<FilesMatch "^(config|lib)\.php$|\.(md|jsonl|ini)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(.*/)?storage(/|$)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Polices et images : gardées 7 jours. Scripts et styles : toujours revérifiés
  # (sinon, après une mise à jour, un navigateur mélange l'ancien script et la nouvelle page).
  <FilesMatch "\.(woff2|svg|webp|jpg|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

AddType font/woff2 .woff2

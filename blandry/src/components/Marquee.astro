---
interface Props {
  items: string[];
  label: string;
}
const { items, label } = Astro.props;
---

<div class="marquee" data-marquee>
  <p class="sr-only">{label} : {items.join(', ')}.</p>
  <div class="marquee__track" aria-hidden="true" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {items.map((c) => (
            <span class="marquee__item">
              <span class="display">{c}</span>
              <svg viewBox="0 0 40 16">
                <path d="M2 10c6-6 12-6 18-2s12 4 18-2" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--bordeaux);
    color: var(--craie);
    padding-block: 14px 10px;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__group {
    display: flex;
    flex: none;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding-right: 22px;
    white-space: nowrap;
  }
  .marquee__item .display {
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    line-height: 0.9;
  }
  .marquee__item svg {
    width: clamp(28px, 4vw, 48px);
    opacity: 0.6;
  }
</style>

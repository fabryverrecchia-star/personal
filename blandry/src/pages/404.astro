---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---

<Base title={`Page introuvable | ${site.nom}`} description="Cette page n’existe pas.">
  <section class="nf">
    <div class="wrap">
      <p class="eyebrow eyebrow--dot muted">Erreur 404</p>
      <h1 class="serif nf__t" data-hero-title>
        <span class="line"><span class="line-inner">Il manque</span></span>
        <span class="line"><span class="line-inner"><em>une couche.</em></span></span>
      </h1>
      <a href={u('/')} class="btn" data-hero-fade>Retour à l’accueil</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 90svh;
    display: flex;
    align-items: center;
    padding-top: 100px;
  }
  .nf__t {
    font-size: var(--fs-xxl);
    margin: 20px 0 40px;
  }
</style>

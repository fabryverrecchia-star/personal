---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { Image } from 'astro:assets';
import { site, zones, services, heroPhotos } from '../data/site';
import { u } from '../lib/url';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  theme?: string;
}
const { title, description, schema = [], theme = '#f3efe8' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const business = {
  '@context': 'https://schema.org',
  '@type': ['HomeAndConstructionBusiness', 'HousePainter'],
  '@id': `${site.url}/#entreprise`,
  name: site.nom,
  description: `${site.metier} dans les Combrailles, à Riom et à Clermont-Ferrand : cloisons et plafonds en plaques de plâtre, isolation, bandes et enduits, peinture, carrelage et faïence.`,
  knowsAbout: ['Plâtrerie', 'Plaques de plâtre', 'Cloisons sèches', 'Faux plafonds', 'Isolation intérieure', 'Peinture en bâtiment', 'Carrelage'],
  url: site.url + '/',
  telephone: site.telephone.replace(/\s/g, ''),
  email: site.email,
  image: `${site.url}/og.png`,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adresse.rue || undefined,
    postalCode: site.adresse.codePostal,
    addressLocality: site.adresse.ville,
    addressRegion: site.adresse.region,
    addressCountry: 'FR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Combrailles' },
    ...zones.flatMap((z) => z.communes.map((c) => ({ '@type': 'City', name: c }))),
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '18:00',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Travaux de peinture',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.titre, description: s.court },
    })),
  },
  ...(site.siret ? { identifier: { '@type': 'PropertyValue', name: 'SIRET', value: site.siret } } : {}),
  ...(Object.keys(site.reseaux).length ? { sameAs: Object.values(site.reseaux) } : {}),
};
const ld = [business, ...schema];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="geo.region" content="FR-63" />
    <meta name="geo.placename" content={`${site.adresse.ville}, Puy-de-Dôme`} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={theme} />
    <link rel="icon" href={u('/favicon.png')} type="image/png" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a href="#main" class="skip">Aller au contenu</a>

    <div class="loader" data-loader aria-hidden="true">
      <div class="loader__bg" data-loader-bg></div>
      <div class="loader__stack" data-loader-stack>
        {
          heroPhotos.slice(0, 6).map((p) => (
            <Image src={p.src} alt="" widths={[360]} sizes="200px" loading="eager" class="loader__img" />
          ))
        }
      </div>
      <p class="loader__mono" data-loader-mono><Logo class="loader__logo" /></p>
      <div class="loader__foot label">
        <span>{site.nom} — Plâtrerie, peinture &amp; carrelage</span>
        <span class="loader__count" data-loader-count>000</span>
      </div>
    </div>

    <div class="cursor" data-cursor aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__txt label" data-cursor-txt></span></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 500;
    padding: 0.7em 1em;
    background: var(--basalte);
    color: var(--lin);
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }

  /* Préchargement */
  .loader {
    position: fixed;
    inset: 0;
    z-index: 400;
    display: grid;
    place-items: center;
    pointer-events: none;
    visibility: hidden;
    color: var(--basalte);
  }
  .js .loader {
    visibility: visible;
  }
  .js:not(.ready) .loader {
    animation: loader-safety 0s 5s forwards;
  }
  @keyframes loader-safety {
    to {
      visibility: hidden;
    }
  }
  .loader__bg {
    position: absolute;
    inset: 0;
    background: var(--lin);
  }
  .loader__stack {
    position: relative;
    width: clamp(150px, 34vw, 230px);
    aspect-ratio: 3 / 4;
  }
  .loader__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .loader__mono {
    position: absolute;
    z-index: 2;
    font-size: clamp(6rem, 30vw, 13rem);
    line-height: 1;
    mix-blend-mode: difference;
    color: var(--lin);
  }
  .loader__mono :global(.loader__logo) {
    display: block;
  }
  .loader__foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(24px + env(safe-area-inset-bottom));
    display: flex;
    justify-content: space-between;
  }
  .loader__count {
    font-variant-numeric: tabular-nums;
  }

  /* Curseur (souris uniquement) */
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 350;
    pointer-events: none;
    display: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cursor.is-on {
    opacity: 1;
  }
  .cursor__dot {
    display: block;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--argile);
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.4s;
  }
  .cursor__txt {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s;
    color: var(--basalte);
    font-size: 0.6rem;
  }
  .cursor.is-link .cursor__dot {
    transform: scale(5);
  }
  .cursor.is-view .cursor__dot {
    transform: scale(11);
    background: var(--lin);
  }
  .cursor.is-view .cursor__txt {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .has-cursor .cursor {
      display: block;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Fan from '../components/Fan.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Marquee from '../components/Marquee.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { Image } from 'astro:assets';
import { site, services, nuancier, zones, etapes, realisations as reals, photos, faqGenerale, teinte } from '../data/site';
// La chambre sous combles (photo HD) en premier
const realisations = [...reals].sort((a, b) => Number(b.titre.includes('combles')) - Number(a.titre.includes('combles')));
import { u } from '../lib/url';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGenerale.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
const savoirFaire = [
  'Peinture intérieure', 'Enduits & préparation', 'Façades', 'Boiseries & volets', 'Conseil couleur', 'Finitions soignées',
];
// Une teinte du nuancier par réalisation et par étape
const teintesChantiers = ['sioule', 'limagne', 'puys'];
const teintesEtapes = ['chaux', 'puys', 'limagne', 'sioule', 'tuile', 'volvic'];
const n2 = (i: number) => String(i + 1).padStart(2, '0');
---

<Base
  title={`${site.nom} — Peintre en bâtiment, peinture et finitions | Puy-de-Dôme`}
  description="Artisan peintre à Saint-Georges-de-Mons : peinture intérieure, préparation des supports, façades et boiseries. Interventions dans les Combrailles, à Riom et à Clermont-Ferrand. Visite et devis gratuits."
  schema={[faqLd]}
>
  <!-- ─── Hero ─────────────────────────────────── -->
  <section class="hero" data-hero>
    <div class="wrap hero__grid">
      <p class="eyebrow eyebrow--dot hero__eye" data-hero-fade>
        Artisan peintre · Puy-de-Dôme
      </p>

      <h1 class="hero__t serif" data-hero-title>
        <span class="line"><span class="line-inner">Peinture</span></span>
        <span class="line hero__brushline">
          <span class="line-inner">
            <em class="hero__brushword">
              &amp; finitions,
              <svg class="brush" viewBox="0 0 600 70" preserveAspectRatio="none" aria-hidden="true">
                <path
                  data-brush
                  d="M8 44 C 90 30, 170 52, 260 38 S 430 30, 520 40 S 580 36, 592 34"
                  pathLength="1"></path>
              </svg>
            </em>
          </span>
        </span>
        <span class="line"><span class="line-inner">du sol au plafond.</span></span>
      </h1>

      <div class="hero__fan" data-hero-fan>
        <Fan />
      </div>

      <div class="hero__foot" data-hero-fade>
        <p class="hero__lede">
          Nous préparons, protégeons et mettons en peinture votre intérieur avec la rigueur d’un artisan.
          Un seul interlocuteur, de la demande de devis à la livraison du chantier.
        </p>
        <div class="hero__ctas">
          <a href="#contact" class="btn" data-magnetic>
            Demander un devis gratuit
            <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
          </a>
          <a href="#avant-apres" class="btn btn--ghost">Avant / après</a>
        </div>
      </div>
    </div>
  </section>

  <Marquee items={savoirFaire} label="Nos savoir-faire" />

  <!-- ─── Avant / après ────────────────────────── -->
  <section class="bas section" id="avant-apres" data-ba-scope aria-labelledby="bas-t">
    <p class="bas__word bas__word--l serif" aria-hidden="true">Avant</p>
    <p class="bas__word bas__word--r serif" aria-hidden="true"><em>Après</em></p>
    <div class="wrap bas__grid">
      <div class="bas__head">
        <p class="eyebrow eyebrow--dot">Avant / après</p>
        <h2 id="bas-t" class="serif bas__t" data-split>
          La différence, <em>au curseur.</em>
        </h2>
        <p class="bas__p" data-reveal="fade">
          Faites glisser pour comparer. Préparation des supports, reprise des murs et des plafonds :
          la qualité d’une peinture se joue avant la première couche.
        </p>
        <a href="#realisations" class="btn btn--light bas__cta" data-reveal="fade">Voir nos réalisations</a>
      </div>
      <div class="bas__slider" data-reveal="fade">
        <BeforeAfter />
      </div>
    </div>
  </section>

  <!-- ─── Réalisations : cartes-échantillons ───── -->
  <section class="works section" id="realisations" aria-labelledby="works-t" data-works>
    <div class="wrap works__head">
      <p class="eyebrow eyebrow--dot muted">Réalisations</p>
      <h2 id="works-t" class="serif works__t" data-split>
        Des chantiers <em>livrés avec soin.</em>
      </h2>
    </div>
    <div class="works__viewport" data-works-viewport>
      <ul class="works__track" data-works-track>
        {
          realisations.map((r, i) => {
            const t = teinte(teintesChantiers[i % teintesChantiers.length]);
            return (
              <li class="wcard" style={`--c:${t.hex};--ink:${t.ink};--r:${i % 2 ? 1.6 : -1.8}deg`}>
                <div class="wcard__media">
                  <Image src={r.image} alt={r.alt} widths={[400, 800]} sizes="(min-width: 1024px) 34vw, 82vw" class="wcard__img" />
                </div>
                <div class="wcard__band">
                  <span class="wcard__n">N° {n2(i)}{r.lieu && ` — ${r.lieu}`}</span>
                  <h3 class="wcard__t serif">{r.titre}</h3>
                  <p class="wcard__tags">{r.travaux.join(' · ')}</p>
                </div>
              </li>
            );
          })
        }
        <li class="wcard wcard--cta" style="--r:1.2deg">
          <a href="#contact" class="wcard__ctalink">
            <span class="serif">Votre projet <em>sera le prochain ?</em></span>
            <span class="btn">Demander un devis gratuit</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ─── Déroulement ──────────────────────────── -->
  <section class="proc section" id="etapes" aria-labelledby="proc-t" data-proc>
    <div class="wrap proc__grid">
      <div class="proc__aside">
        <p class="eyebrow eyebrow--dot">Déroulement</p>
        <h2 id="proc-t" class="serif proc__t" data-split>
          De la demande de devis <em>à la livraison.</em>
        </h2>
        <div class="proc__pot" aria-hidden="true" data-proc-pot style={`--pc:${teinte(teintesEtapes[0]).hex};--pi:${teinte(teintesEtapes[0]).ink}`}>
          <span class="proc__num serif" data-proc-num>01</span>
          <span class="proc__of">/ {n2(etapes.length - 1)}</span>
        </div>
      </div>
      <ol class="proc__list">
        {
          etapes.map((e, i) => {
            const t = teinte(teintesEtapes[i]);
            return (
              <li class="pstep" data-pstep data-pc={t.hex} data-pi={t.ink} style={`--c:${t.hex};--pi-ink:${t.ink}`}>
                <div class="pstep__top">
                  <span class="pstep__n serif">{n2(i)}</span>
                  <span class="pstep__badge">{e.duree}</span>
                </div>
                <h3 class="pstep__t serif">{e.titre}</h3>
                <p class="pstep__p">{e.texte}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- ─── Manifeste ────────────────────────────── -->
  <section class="manifesto section" aria-label="Notre approche">
    <div class="wrap grid">
      <figure class="manifesto__photo" data-parallax-wrap>
        <Image src={photos.artisan.src} alt={photos.artisan.alt} widths={[600, 1200, 1587]} sizes="(min-width: 1024px) 40vw, 92vw" class="manifesto__img" data-parallax />
      </figure>
      <p class="eyebrow eyebrow--dot muted manifesto__eye">Notre métier</p>
      <p class="manifesto__t serif" data-words>
        Notre spécialité n’est pas la rénovation générale : <em>notre métier est la peinture.</em>
        Nous préparons, protégeons et mettons en couleur chaque pièce avec l’exigence d’un artisan,
        du sol au plafond.
      </p>
    </div>
  </section>

  <!-- ─── Bande : la lumière révèle tout ───────── -->
  <section class="band" aria-label="Finitions" data-parallax-wrap>
    <Image src={photos.finition.src} alt={photos.finition.alt} widths={[800, 1587]} sizes="100vw" class="band__img" data-parallax />
    <div class="wrap band__in">
      <p class="band__t serif" data-split>
        La lumière révèle chaque défaut. <em>Nous préparons en conséquence.</em>
      </p>
    </div>
  </section>

  <!-- ─── Services ─────────────────────────────── -->
  <section class="services" id="services" aria-labelledby="services-t">
    <div class="wrap services__head">
      <p class="eyebrow eyebrow--dot muted">Savoir-faire</p>
      <h2 id="services-t" class="serif services__t" data-split>
        La peinture, <em>et tout ce qui la prépare.</em>
      </h2>
    </div>
    <div class="wrap stack" data-stack>
      {
        services.map((s, i) => {
          const t = teinte(s.teinte);
          return (
            <article
              class="card"
              id={s.id}
              data-card
              style={`--c:${t.hex};--ink:${t.ink};--i:${i}`}
            >
              <div class="card__in">
                <div class="card__top">
                  <span class="card__n">0{i + 1} / 0{services.length}</span>
                  <span class="card__swatch">
                    <i />
                    {t.nom}
                  </span>
                </div>
                <span class="card__big serif" aria-hidden="true">{i + 1}</span>
                <div class="card__body">
                  <h3 class="serif card__t">{s.titre}</h3>
                  <div class="card__text">
                    <p class="card__court">{s.court}</p>
                    <p>{s.texte}</p>
                    <ul class="card__pts">
                      {s.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- ─── Nuancier ─────────────────────────────── -->
  <section class="nuancier section" id="nuancier" data-nuancier aria-labelledby="nuancier-t">
    <div class="wrap">
      <div class="nuancier__head">
        <p class="eyebrow eyebrow--dot">Conseil couleur</p>
        <h2 id="nuancier-t" class="serif nuancier__t" data-split>
          Des teintes inspirées <em>des matériaux de la région.</em>
        </h2>
      </div>

      <div class="nuancier__stage" aria-live="polite">
        <p class="nuancier__name serif" data-nu-name>{nuancier[1].nom}</p>
        <p class="nuancier__meta">
          <span data-nu-lieu>{nuancier[1].lieu}</span>
          <span data-nu-hex>{nuancier[1].hex}</span>
        </p>
      </div>

      <div class="nuancier__row" role="radiogroup" aria-label="Choisir une teinte">
        {
          nuancier.map((t, i) => (
            <button
              class="nu"
              role="radio"
              aria-checked={i === 1 ? 'true' : 'false'}
              data-nu
              data-hex={t.hex}
              data-ink={t.ink}
              data-nom={t.nom}
              data-lieu={t.lieu}
              style={`--c:${t.hex}`}
            >
              <span class="nu__dot" />
              <span class="nu__lab">{t.nom}</span>
            </button>
          ))
        }
      </div>
      <p class="nuancier__note">
        Nous apportons de vrais échantillons et les posons chez vous : une couleur se choisit dans la
        lumière réelle de la pièce.
      </p>
    </div>
  </section>

  <!-- ─── Secteurs ─────────────────────────────── -->
  <section class="zones section" id="secteurs" aria-labelledby="zones-t">
    <div class="wrap">
      <div class="zones__head grid">
        <p class="eyebrow eyebrow--dot muted zones__eye">Zone d’intervention</p>
        <h2 id="zones-t" class="serif zones__t" data-split>
          Où nous <em>intervenons.</em>
        </h2>
        <p class="zones__lede" data-reveal="fade">
          Installés à {site.adresse.ville}, nous intervenons dans un rayon d’environ quarante kilomètres.
          Le déplacement pour la visite et le devis est gratuit.
        </p>
      </div>

      <ul class="zlist">
        {
          zones.map((z, i) => {
            const t = teinte(z.teinte);
            return (
              <li style={`--c:${t.hex};--ink:${t.ink}`}>
                <a href={u(`/${z.slug}/`)} class="zrow" data-zrow>
                  <span class="zrow__fill" aria-hidden="true" />
                  <span class="zrow__n">0{i + 1}</span>
                  <span class="zrow__name serif">{z.nom}</span>
                  <span class="zrow__court">{z.court}</span>
                  <span class="zrow__go" aria-hidden="true">
                    <svg viewBox="0 0 16 16"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                  </span>
                  <span class="sr-only">— voir la page peintre {z.nom}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <Faq items={faqGenerale} />
  <Contact />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(96px + env(safe-area-inset-top));
    padding-bottom: 32px;
    display: flex;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr auto;
    gap: 24px;
  }
  .hero__eye {
    color: var(--muted);
  }
  .hero__t {
    font-size: clamp(3.1rem, 12.4vw, 11.5rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .hero__brushline {
    overflow: visible;
  }
  .hero__brushline .line-inner {
    clip-path: inset(-10% -10% 0 -10%);
  }
  .hero__brushword {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .brush {
    position: absolute;
    left: -2%;
    right: -3%;
    bottom: 0.02em;
    width: 105%;
    height: 0.34em;
    z-index: -1;
    overflow: visible;
  }
  .brush path {
    fill: none;
    stroke: var(--limagne);
    stroke-width: 26;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0.9;
  }
  .js .brush path {
    stroke-dashoffset: 1;
  }
  .hero__fan {
    display: grid;
    place-items: center;
    padding-top: 12px;
    min-height: clamp(240px, 58vw, 460px);
  }
  .hero__foot {
    display: grid;
    gap: 22px;
    align-self: end;
  }
  .hero__lede {
    max-width: 38ch;
    font-size: 1.05rem;
    color: var(--muted);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: auto 1fr auto;
      column-gap: 28px;
    }
    .hero__eye {
      grid-column: 1 / -1;
    }
    .hero__t {
      grid-column: 1 / 9;
      grid-row: 2;
      align-self: center;
      font-size: min(9.6vw, 11rem);
    }
    .hero__fan {
      grid-column: 9 / -1;
      grid-row: 2;
      min-height: 0;
    }
    .hero__fan :global(.fan) {
      --w: min(6.4vw, 96px);
      --h: min(29vw, 420px);
    }
    .hero__foot {
      grid-column: 1 / -1;
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  /* Manifeste */
  .manifesto__eye {
    grid-column: 1 / -1;
    margin-bottom: 28px;
  }
  .manifesto__t {
    grid-column: 1 / -1;
    font-size: clamp(2rem, 5.2vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .manifesto__t em {
    color: var(--tuile);
  }
  @media (min-width: 1024px) {
    .manifesto__eye {
      grid-column: 1 / 3;
      margin-top: 1.2em;
    }
    .manifesto__t {
      grid-column: 3 / -1;
    }
  }

  /* Services : cartes empilées */
  .services {
    padding-bottom: clamp(80px, 12vw, 160px);
  }
  .services__head {
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .services__t {
    font-size: var(--fs-xl);
    margin-top: 16px;
    max-width: 14ch;
  }
  .stack {
    display: grid;
    gap: 16px;
  }
  .card {
    position: sticky;
    top: calc(84px + var(--i) * 12px);
    scroll-margin-top: 90px;
  }
  .card__in {
    background: var(--c);
    color: var(--ink);
    border-radius: calc(var(--radius) * 1.6);
    padding: clamp(22px, 4vw, 56px);
    min-height: min(640px, calc(100svh - 120px));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    transform-origin: 50% 0;
    box-shadow: 0 -20px 60px -30px rgb(0 0 0 / 0.35);
    will-change: transform;
  }
  .card__in {
    position: relative;
    overflow: hidden;
  }
  .card__big {
    position: absolute;
    right: -0.04em;
    top: -0.12em;
    font-size: clamp(14rem, 44vw, 34rem);
    line-height: 1;
    font-style: italic;
    opacity: 0.12;
    pointer-events: none;
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .card__swatch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .card__swatch i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 1px currentColor;
  }
  .card__body {
    display: grid;
    gap: 28px;
  }
  .card__t {
    font-size: clamp(2.6rem, 8.4vw, 7.4rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .card__text {
    display: grid;
    gap: 16px;
    max-width: 46ch;
  }
  .card__court {
    font-size: var(--fs-m);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .card__text > p:not(.card__court) {
    opacity: 0.8;
  }
  .card__pts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .card__pts li {
    font-size: var(--fs-s);
    padding: 7px 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 30%, transparent);
  }
  @media (min-width: 1024px) {
    .card__body {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
    }
  }

  /* Nuancier */
  .nuancier {
    --nu: #56595c;
    --nu-ink: #f3efe7;
    background: var(--nu);
    color: var(--nu-ink);
    transition: background-color 0.9s var(--ease), color 0.9s var(--ease);
    overflow: hidden;
  }
  .nuancier__t {
    font-size: var(--fs-l);
    margin-top: 16px;
    max-width: 18ch;
  }
  .nuancier__stage {
    margin-top: clamp(48px, 9vw, 120px);
    min-height: 1.8em;
  }
  .nuancier__name {
    font-size: clamp(3.6rem, 15vw, 15rem);
    line-height: 0.85;
    letter-spacing: -0.045em;
    font-style: italic;
  }
  .nuancier__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    font-size: var(--fs-s);
  }
  .nuancier__meta [data-nu-hex] {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .nuancier__row {
    display: flex;
    gap: 10px;
    margin: 40px calc(var(--gutter) * -1) 0;
    padding: 4px var(--gutter) 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .nuancier__row::-webkit-scrollbar {
    display: none;
  }
  .nu {
    flex: none;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 8px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 28%, transparent);
    font-size: var(--fs-s);
    transition: background-color 0.4s, box-shadow 0.4s;
  }
  .nu[aria-checked='true'] {
    background: color-mix(in srgb, currentColor 14%, transparent);
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .nu__dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 1.5px color-mix(in srgb, currentColor 50%, transparent);
  }
  .nuancier__note {
    margin-top: 32px;
    max-width: 44ch;
    opacity: 0.75;
  }

  /* Secteurs */
  .zones__eye {
    grid-column: 1 / -1;
  }
  .zones__t {
    grid-column: 1 / -1;
    font-size: var(--fs-xxl);
    margin-top: 16px;
  }
  .zones__lede {
    grid-column: 1 / -1;
    margin-top: 24px;
    max-width: 44ch;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .zones__t {
      grid-column: 1 / 8;
    }
    .zones__lede {
      grid-column: 9 / -1;
      align-self: end;
    }
  }
  .zlist {
    margin-top: clamp(48px, 7vw, 96px);
    border-top: 1px solid var(--line);
  }
  .zrow {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'n name go' 'n court go';
    align-items: center;

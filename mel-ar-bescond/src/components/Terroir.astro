---
import { getImage } from 'astro:assets';
import { photo } from '../lib/photos';
import { site } from '../site.config';
// grand bandeau : Nathalie et Frédéric au rucher, dans la fumée de l'enfumoir
const poster = await getImage({ src: photo('fumee-poster'), width: 1280, format: 'webp' });
---

<section class="terroir" id="terroir">
  <figure class="terroir__band" data-band data-reveal-img>
    <video class="terroir__video" data-autoplay poster={poster.src} muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="videos/fumee.mp4" type="video/mp4" />
      <source src="videos/fumee.webm" type="video/webm" />
    </video>
  </figure>

  <div class="wrap terroir__grid">
    <p class="label muted" data-reveal>Le terroir</p>
    <div class="terroir__body">
      <h2 class="h2" data-split>Né en Bretagne, <em>au pied du Menez Bré</em></h2>
      <p class="lead muted" data-reveal>
        Nos ruches vivent à Coat ar Bescond, sur la commune de Louargat, entre bocage, landes et talus fleuris.
      </p>
      <dl class="terroir__facts" data-reveal>
        <div><dt class="label muted">Lieu-dit</dt><dd>{site.address.street}</dd></div>
        <div><dt class="label muted">Commune</dt><dd>{site.address.zip} {site.address.city}</dd></div>
        <div><dt class="label muted">Coordonnées</dt><dd>48°34′ N · 3°20′ O</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  .terroir {
    padding-bottom: clamp(120px, 16vw, 240px);
  }
  .terroir__band {
    position: relative;
    height: 78svh;
    overflow: hidden;
    margin-bottom: clamp(80px, 10vw, 160px);
    background: var(--paper);
  }
  .terroir__video {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }
  .terroir__rule {
    margin-bottom: clamp(80px, 10vw, 140px);
  }
  .terroir__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 2rem;
  }
  .terroir__body {
    display: grid;
    gap: 1.8rem;
    max-width: 900px;
  }
  .terroir__body .h2 em {
    color: var(--gold);
  }
  .terroir__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .terroir__facts div {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .terroir__facts dd {
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 300;
  }

  @media (max-width: 800px) {
    .terroir__grid {
      grid-template-columns: 1fr;
    }
    .terroir__facts {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .terroir__band {
      height: 56svh;
    }
  }
</style>

---
// Section pinnée : le miel passe de liquide à cristallisé au fil du défilement.
const steps = [
  { k: 'À la récolte', t: 'Un miel fluide, doré, qui coule comme un fil de lumière.' },
  { k: 'Avec le temps', t: 'Il cristallise naturellement : de fins cristaux se forment et le rendent onctueux.' },
  { k: 'Gage de qualité', t: 'C’est le signe d’un miel naturel. À conserver dans un endroit frais et sec.' },
];
---

<section class="crystal" data-crystal>
  <div class="crystal__pin" data-crystal-pin>
    <div class="wrap crystal__grid">
      <div class="crystal__visual">
        <div class="crystal__disc" data-crystal-disc>
          <div class="crystal__liquid"><span class="crystal__spec" data-crystal-spec></span></div>
          <div class="crystal__solid" data-crystal-solid>
            <svg viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true">
              <filter id="crystal-grain">
                <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="3" seed="7"></feTurbulence>
                <feColorMatrix values="0 0 0 0 0.99  0 0 0 0 0.93  0 0 0 0 0.78  0 0 0 2.2 -0.9"></feColorMatrix>
              </filter>
              <rect width="400" height="400" fill="#e9c77f"></rect>
              <rect width="400" height="400" filter="url(#crystal-grain)"></rect>
            </svg>
          </div>
          <div class="crystal__rim"></div>
        </div>
        <p class="crystal__state label" aria-hidden="true">
          <span data-crystal-pct>0</span>% cristallisé
        </p>
      </div>

      <div class="crystal__txt">
        <p class="label crystal__kicker">La cristallisation</p>
        <h2 class="h2 crystal__title">Un miel <em>vivant</em> change de visage</h2>
        <ol class="crystal__steps">
          {
            steps.map((s, i) => (
              <li class="crystal__step" data-crystal-step>
                <span class="label">
                  0{i + 1} — {s.k}
                </span>
                <p>{s.t}</p>
              </li>
            ))
          }
        </ol>
        <p class="crystal__tip muted">
          <span class="script">Astuce</span> Pour le retrouver liquide, placez le pot quelques minutes au bain-marie tiède.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .crystal {
    background: var(--paper);
  }
  .crystal__pin {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 90px 40px;
  }
  .crystal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(30px, 6vw, 110px);
    align-items: center;
  }
  .crystal__visual {
    display: grid;
    justify-items: center;
    gap: 1.4rem;
  }
  .crystal__disc {
    --p: 0;
    position: relative;
    width: min(100%, 520px, 58svh);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 40px 80px -30px rgb(110 74 42 / 0.55),
      inset 0 0 0 1px rgb(255 255 255 / 0.4);
  }
  .crystal__liquid,
  .crystal__solid {
    position: absolute;
    inset: 0;
  }
  .crystal__liquid {
    background:
      radial-gradient(60% 50% at 35% 30%, rgb(255 236 180 / 0.9), transparent 60%),
      radial-gradient(90% 90% at 60% 70%, #b86e1c, #d8962f 55%, #f0c261);
  }
  .crystal__spec {
    position: absolute;
    width: 36%;
    height: 12%;
    left: 20%;
    top: 16%;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
    filter: blur(10px);
    transform: rotate(-24deg);
  }
  .crystal__solid {
    /* germes de cristallisation qui s'étendent avec --p */
    -webkit-mask:
      radial-gradient(circle at 28% 32%, #000 calc(var(--p) * 70%), transparent calc(var(--p) * 70% + 10%)),
      radial-gradient(circle at 72% 58%, #000 calc(var(--p) * 62%), transparent calc(var(--p) * 62% + 10%)),
      radial-gradient(circle at 40% 80%, #000 calc(var(--p) * 55%), transparent calc(var(--p) * 55% + 10%));
    mask:
      radial-gradient(circle at 28% 32%, #000 calc(var(--p) * 70%), transparent calc(var(--p) * 70% + 10%)),
      radial-gradient(circle at 72% 58%, #000 calc(var(--p) * 62%), transparent calc(var(--p) * 62% + 10%)),
      radial-gradient(circle at 40% 80%, #000 calc(var(--p) * 55%), transparent calc(var(--p) * 55% + 10%));
  }
  .crystal__solid svg {
    width: 100%;
    height: 100%;
  }
  .crystal__rim {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 10px rgb(255 255 255 / 0.18),
      inset 0 -30px 60px rgb(80 40 10 / 0.25);
  }
  .crystal__state {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .crystal__txt {
    display: grid;
    gap: 1.6rem;
  }
  .crystal__kicker {
    color: var(--amber);
  }
  .crystal__title em {
    color: var(--amber);
  }
  .crystal__steps {
    list-style: none;
    display: grid;
    gap: 0;
    margin-top: 1rem;
  }
  .crystal__step {
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
    opacity: 0.28;
    transition: opacity 0.6s var(--ease);
  }
  :global(.crystal__step.is-on) {
    opacity: 1;
  }
  .crystal__step .label {
    color: var(--amber);
  }
  .crystal__step p {
    font-size: var(--fs-lead);
    line-height: 1.3;
  }
  .crystal__tip .script {
    font-size: 1.8em;
    color: var(--brown);
    margin-right: 0.3em;
    vertical-align: -0.1em;
  }

  @media (max-width: 800px) {
    .crystal__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .crystal__disc {
      width: min(62vw, 38svh);
    }
    .crystal__title {
      font-size: 2rem;
    }
    .crystal__step {
      padding: 0.6rem 0;
    }
    .crystal__step p {
      font-size: 1.05rem;
    }
    .crystal__tip {
      display: none;
    }
    .crystal__state {
      display: none;
    }
  }
</style>

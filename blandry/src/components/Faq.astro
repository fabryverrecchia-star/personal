---
interface Props {
  items: readonly { q: string; r: string }[];
  titre?: string;
}
const { items, titre = 'Questions fréquentes' } = Astro.props;
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
---

<section class="faq section" aria-labelledby="faq-t">
  <div class="wrap faq__grid">
    <div class="faq__head">
      <p class="label muted">Questions</p>
      <h2 id="faq-t" class="title faq__t" data-split>{titre}</h2>
    </div>
    <div class="faq__list">
      {
        items.map((it, i) => (
          <details class="faq__item" data-reveal="fade">
            <summary>
              <span class="faq__n">{roman[i]}.</span>
              <h3>{it.q}</h3>
              <span class="faq__plus" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{it.r}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: 40px;
  }
  .faq__head {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .faq__t {
    font-size: var(--fs-l);
    max-width: 12ch;
  }
  @media (min-width: 1024px) {
    .faq__grid {
      grid-template-columns: 5fr 7fr;
      gap: 80px;
    }
    .faq__head {
      position: sticky;
      top: 120px;
      align-self: start;
    }
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    align-items: baseline;
    gap: 10px;
    padding: 24px 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__n {
    font-family: var(--serif);
    color: var(--muted);
  }
  summary h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.3;
  }
  .faq__plus {
    position: relative;
    width: 14px;
    height: 14px;
    align-self: center;
    transition: transform 0.6s var(--ease);
  }
  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 14px;
    height: 1px;
    background: currentColor;
  }
  .faq__plus::after {
    transform: rotate(90deg);
  }
  details.is-open .faq__plus,
  html:not(.js) details[open] .faq__plus {
    transform: rotate(135deg);
  }
  .faq__a {
    overflow: hidden;
  }
  .faq__a > p {
    max-width: 58ch;
    padding: 0 0 26px 2.6rem;
    color: var(--muted);
  }
</style>

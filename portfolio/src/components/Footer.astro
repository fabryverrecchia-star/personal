---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<!-- Pied de page : carte sauge découpée par des filets -->
<footer class="footer">
  <div class="footer__panel">
    <div class="footer__main">
      <p class="label" data-reveal>Un projet en tête ?</p>
      <a href={`mailto:${site.email}`} class="footer__mail display caps" data-reveal="lines">
        Écrivons <em>ensemble</em>
      </a>
      <p class="footer__address label">{site.email}</p>
    </div>
    <p class="footer__vertical vertical italic" aria-hidden="true">
      <span class="ornament">1</span>
    </p>
    <div class="footer__side">
      <ul class="label footer__list">
        {
          site.socials.map((s) => (
            <li>
              <a href={s.href} class="link" target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="footer__meta">
        <button class="label link" type="button" data-scroll-top>Haut de page ↑</button>
        <p class="label">© <span class="figures">{year}</span> <span class="name">{site.name}</span></p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: var(--margin);
    background: var(--bg);
  }
  .footer__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(13rem, 22%);
    min-height: 70svh;
    background: var(--sage);
    border: 1px solid var(--line);
  }
  .footer__main {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.25rem, 2.5vw, 2.5rem);
  }
  .footer__mail {
    display: block;
    font-size: clamp(3rem, 1rem + 8vw, 10rem);
    line-height: 0.88;
  }
  .footer__address {
    user-select: all;
  }
  .footer__vertical {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 0.9rem;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
    font-size: var(--fs-xl);
  }
  .footer__side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.25rem, 2vw, 2rem);
  }
  .footer__list,
  .footer__meta {
    display: grid;
    gap: 0.3rem;
  }
  .footer__meta button {
    justify-self: start;
  }
  .footer :global(.name) {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.75rem;
  }
  @media (max-width: 800px) {
    .footer__panel {
      grid-template-columns: 1fr;
    }
    .footer__vertical {
      display: none;
    }
    .footer__side {
      border-top: 1px solid var(--line);
    }
  }
</style>

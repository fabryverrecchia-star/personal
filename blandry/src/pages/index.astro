---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Chapitre from '../components/Chapitre.astro';
import { site, services, zones, etapes, selection, galerie, heroPhotos, photos, palette, faqGenerale, garanties, marques, instagram, chaine, visuel, univers, peinture, carrelage } from '../data/site';
import { u } from '../lib/url';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGenerale.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
};
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
// Positions des photos flottantes : bureau (x, y, largeur en vw) puis mobile
const spots = [
  { x: 3, y: 12, w: 10, mx: -6, my: 7, mw: 24, d: 0.6 },
  { x: 9, y: 60, w: 9, mx: 76, my: 6, mw: 24, d: 1.1 },
  { x: 79, y: 10, w: 12, mx: -6, my: 78, mw: 34, d: 0.8 },
  { x: 85, y: 55, w: 10, mx: 74, my: 80, mw: 26, d: 1.3 },
  { x: 19, y: 84, w: 8, mx: -99, my: 0, mw: 0, d: 0.9 },
  { x: 71, y: 83, w: 8, mx: -99, my: 0, mw: 0, d: 1.2 },
  { x: 21, y: 12, w: 6, mx: -99, my: 0, mw: 0, d: 0.7 },
  { x: 16, y: 40, w: 6, mx: -99, my: 0, mw: 0, d: 1 },
];
const svcImg = visuel;
---

<Base
  title={`${site.nom} — Plaquiste et peintre : placo, peinture, carrelage | Combrailles, Riom, Clermont-Ferrand`}
  description="Artisan plaquiste et peintre aux Ancizes-Comps : cloisons et plafonds en plaques de plâtre, isolation, bandes et enduits, peinture et carrelage. Combrailles, Riom, Clermont-Ferrand. Visite et devis gratuits."
  schema={[faqLd]}
>
  <!-- ─── Ouverture ──────────────────────────── -->
  <section class="hero" data-hero>
    <div class="hero__floats" aria-hidden="true">
      {
        heroPhotos.map((p, i) => {
          const s = spots[i];
          return (
            <div
              class:list={['float', { 'float--desk': s.mw === 0 }]}
              data-float
              data-depth={s.d}
              style={`--x:${s.x}%;--y:${s.y}%;--w:${s.w}vw;--mx:${s.mx}%;--my:${s.my}%;--mw:${s.mw}vw`}
            >
              <Image src={p.src} alt="" widths={[320, 520]} sizes="(min-width: 900px) 14vw, 34vw" loading="eager" class="float__img" />
            </div>
          );
        })
      }
    </div>

    <div class="hero__center">
      <p class="label hero__kicker" data-hero-fade>Artisan aux Ancizes-Comps</p>
      <h1 class="display hero__t" data-hero-title>
        <span class="line"><span class="line-inner">Plâtrerie,</span></span>
        <span class="line"><span class="line-inner">peinture</span></span>
        <span class="line"><span class="line-inner"><em>&amp; carrelage</em></span></span>
      </h1>
      <p class="hero__p" data-hero-fade>
        Trois métiers, un seul artisan : de l’ossature en plaques de plâtre à la dernière couche de peinture ou au
        dernier joint de carrelage, des Combrailles à Clermont-Ferrand.
      </p>
      <nav class="hero__uni" aria-label="Les trois métiers" data-hero-fade>
        {univers.map((x) => (
          <a href={`#${x.id}`} class="hero__u">
            <span class="hero__un">{x.n}</span>
            <span class="hero__ut">{x.nom}</span>
            <span class="hero__uc">{x.court}</span>
          </a>
        ))}
      </nav>
      <div class="hero__ctas" data-hero-fade>
        <a href="#contact" class="btn btn--solid" data-magnetic>Demander un devis</a>
        <a href="#atelier" class="cta">Découvrir l’artisan</a>
      </div>
    </div>

    <p class="hero__scroll label" data-hero-fade aria-hidden="true"><span></span>Défiler</p>
  </section>

  <!-- ─── L'atelier ──────────────────────────── -->
  <section class="atelier" id="atelier" aria-labelledby="atelier-t">
    <div class="atelier__text">
      <p class="label muted" data-reveal="fade">L’atelier</p>
      <h2 id="atelier-t" class="title atelier__t" data-split>Un artisan, une exigence, <em>de l’ossature à la finition.</em></h2>
      <p class="atelier__p" data-reveal="fade">
        {site.nom} est une entreprise de plâtrerie, peinture et carrelage installée aux Ancizes-Comps, au cœur des
        Combrailles. Nous montons les cloisons, posons les plafonds, isolons, jointons, puis peignons ou carrelons :
        la qualité d’une finition se décide bien avant la dernière couche, et nous maîtrisons chaque étape.
      </p>
      <ul class="atelier__list">
        <li data-reveal="fade"><span>I.</span> Visite et devis détaillé, gratuits</li>
        <li data-reveal="fade"><span>II.</span> Un seul artisan pour le placo, la peinture et le carrelage</li>
        <li data-reveal="fade"><span>III.</span> Garantie décennale, attestation jointe au devis</li>
      </ul>
    </div>
    <figure class="atelier__media" data-parallax-wrap data-reveal="img">
      <video
        class="atelier__video"
        data-autovideo
        data-parallax
        muted
        loop
        playsinline
        preload="none"
        poster={u('/videos/metier-poster.jpg')}
        aria-label="Au travail : ponçage d’un plafond, application d’enduit, reprise des joints"
      >
        <source src={u('/videos/metier-1280.mp4')} type="video/mp4" data-src-sm={u('/videos/metier-720.mp4')} />
      </video>
      <figcaption class="label atelier__cap">Ponçage, enduit, reprise des joints</figcaption>
    </figure>
  </section>

  <!-- ─── Le placo : de l'ossature à la dernière couche ─── -->
  <section class="chain" id="placo" aria-labelledby="chain-t" data-chain>
    <Chapitre n="01" nom="Plâtrerie" id="chain-t">
      <Fragment slot="titre">Le placo, <em>notre cœur de métier</em></Fragment>
      <p>
        Cloisons, doublages, faux plafonds, isolation : une plâtrerie bien faite, c’est un mur qui reste droit et une
        finition qui tient. Voici comment une pièce est menée, de l’ossature à la dernière couche.
      </p>
    </Chapitre>
    <div class="wrap chain__grid">
      <div class="chain__media" aria-hidden="true">
        <div class="chain__frame">
          {chaine.map((c, i) => (
            <Image src={c.photo} alt="" widths={[600, 1100]} sizes="(min-width: 1024px) 42vw, 92vw" class:list={['chain__img', { 'is-on': i === 0 }]} data-chain-img={i} />
          ))}
        </div>
        <p class="chain__count label"><span data-chain-n>01</span> / {String(chaine.length).padStart(2, '0')}</p>
      </div>
      <ol class="chain__list">
        {chaine.map((c, i) => (
          <li class="cstep" data-chain-step={i}>
            <figure class="cstep__img" data-reveal="img">
              <Image src={c.photo} alt={c.alt} widths={[500, 900]} sizes="92vw" />
            </figure>
            <span class="cstep__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="title cstep__t">{c.titre}</h3>
            <p class="cstep__p">{c.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>



  <!-- ─── 02 Peinture ────────────────────────── -->
  <section class="uni uni--peinture" id="peinture" aria-labelledby="peinture-t">
    <Chapitre n="02" nom="Peinture" id="peinture-t">
      <Fragment slot="titre">Peinture <em>intérieure et extérieure</em></Fragment>
      <p>
        Murs, plafonds, boiseries, volets et façades. Chaque support reçoit l’impression qui lui convient, puis deux
        couches croisées, dans la finition adaptée à l’usage de la pièce et à sa lumière.
      </p>
    </Chapitre>
    <div class="wrap pein">
      <figure class="pein__a" data-reveal="img" data-parallax-wrap>
        <Image src={peinture.photos[0].src} alt={peinture.photos[0].alt} widths={[600, 1100]} sizes="(min-width: 1024px) 40vw, 92vw" data-parallax />
      </figure>
      <figure class="pein__b" data-reveal="img">
        <Image src={peinture.photos[1].src} alt={peinture.photos[1].alt} widths={[500, 900]} sizes="(min-width: 1024px) 26vw, 60vw" />
      </figure>
      <figure class="pein__c" data-reveal="img">
        <Image src={peinture.photos[2].src} alt={peinture.photos[2].alt} widths={[500, 900]} sizes="(min-width: 1024px) 22vw, 50vw" />
      </figure>
      <ul class="uni__points pein__pts">
        {peinture.points.map((x) => <li data-reveal="fade"><span class="uni__dot" aria-hidden="true"></span>{x}</li>)}
      </ul>
    </div>
  </section>

  <!-- ─── Territoire : nuancier du Puy-de-Dôme ─── -->
  <section class="terre" aria-labelledby="terre-t" data-terre>
    <div class="terre__pin">
      <div class="wrap terre__grid">
        <div class="terre__text">
          <p class="label muted" data-reveal="fade">Territoire et couleur</p>
          <h2 id="terre-t" class="title terre__t" data-split>Un nuancier né <em>du Puy-de-Dôme</em></h2>
          <p class="prose" data-reveal="fade">
            Le ciel des Puys, la pierre de Volvic, les forêts de la Sioule, les terres de Limagne, les toits de tuile des
            villages : la région inspire nos harmonies. Pour les mettre en œuvre, nous travaillons exclusivement avec les
            nuanciers professionnels des fabricants, des centaines de teintes référencées et reproductibles à l’identique.
          </p>
          <ul class="terre__points" data-reveal="fade">
            <li><span class="terre__dot" aria-hidden="true"></span>Teintes référencées chez le fabricant</li>
            <li><span class="terre__dot" aria-hidden="true"></span>Échantillons posés chez vous, à la lumière réelle</li>
            <li><span class="terre__dot" aria-hidden="true"></span>Conseil couleur lors de la visite</li>
          </ul>
          <p class="terre__zones" data-reveal="fade">
            {zones.map((z) => <a href={u(`/${z.slug}/`)} class="cta">{site.metierCourt} {z.dans}</a>)}
          </p>
        </div>

        <figure class="terre__stage" data-terre-stage>
          <svg class="land" viewBox="0 0 600 640" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <rect class="land__l" data-c="puys" width="600" height="640" fill="#8DA3B3" />
            <path class="land__l" data-c="volvic" fill="#56595C" d="M0 330 L40 300 Q70 280 95 296 L130 318 L175 262 Q205 226 235 258 L262 288 L300 238 Q330 150 360 232 L392 286 L430 252 Q455 232 482 256 L520 290 L560 270 L600 284 V640 H0Z" />
            <path class="land__l" data-c="basalte" fill="#1F1D1A" d="M0 372 L60 352 Q110 336 160 356 L220 378 Q260 392 300 372 L360 344 Q400 330 450 350 L520 374 Q560 386 600 370 V640 H0Z" />
            <path class="land__l" data-c="sioule" fill="#3F5A45" d="M0 410 Q60 384 120 402 T240 404 T360 398 T480 406 T600 396 V640 H0Z" />
            <path class="land__l" data-c="limagne" fill="#C08A3E" d="M0 468 Q150 440 300 462 T600 452 V640 H0Z" />
            <path class="land__l" data-c="tuile" fill="#9B4B34" d="M0 524 L30 500 L60 524 L84 504 L110 526 L150 494 L190 526 L220 506 L250 528 L292 498 L334 528 L360 508 L392 530 L430 500 L470 530 L500 510 L530 530 L566 502 L600 526 V640 H0Z" />
            <path class="land__l" data-c="chaux" fill="#E2DACB" d="M0 548 H600 V640 H0Z" />
            <path class="land__ridge" d="M262 288 L300 238 Q330 150 360 232 L392 286" />
          </svg>
          <div class="fan" aria-hidden="true">
            {
              palette.map((c, i) => (
                <span class="fan__card" style={`--c:${c.hex};--i:${i}`} data-fan>
                  <span class="fan__main" />
                  <span class="fan__tint" style="--m:72%" />
                  <span class="fan__tint" style="--m:50%" />
                  <span class="fan__tint" style="--m:28%" />
                  <span class="fan__foot"><span class="fan__line" /><span class="fan__line fan__line--s" /></span>
                </span>
              ))
            }
            <span class="fan__pin" />
          </div>
          <figcaption class="terre__note label muted">
            Couleurs d’inspiration. La teinte exacte est choisie avec vous sur nuancier fabricant.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
  <!-- ─── 03 Carrelage ───────────────────────── -->
  <section class="uni uni--carrelage dark" id="carrelage" aria-labelledby="carrelage-t">
    <Chapitre n="03" nom="Carrelage" id="carrelage-t">
      <Fragment slot="titre">Carrelage <em>et faïence</em></Fragment>
      <p>
        Sols, salles de bains, douches à l’italienne, crédences. Un carrelage se juge à la régularité de ses joints et
        à la netteté de ses coupes : tout se prépare avant la première colle.
      </p>
    </Chapitre>
    <div class="wrap">
      <div class="tiles" data-tiles>
        {carrelage.photos.map((x, i) => (
          <figure class={`tile tile--${i}`} data-tile>
            <Image src={x.src} alt={x.alt} widths={[500, 1000]} sizes={i === 0 ? '(min-width: 1024px) 40vw, 92vw' : '(min-width: 1024px) 26vw, 46vw'} />
          </figure>
        ))}
      </div>
      <ul class="uni__points carr__pts">
        {carrelage.points.map((x) => <li data-reveal="fade"><span class="uni__dot" aria-hidden="true"></span>{x}</li>)}
      </ul>
    </div>
  </section>

  <!-- ─── Lumière rasante ────────────────────── -->
  <section class="light dark" aria-labelledby="light-t" data-light>
    <div class="light__sticky">
      <figure class="light__img" data-light-img aria-hidden="true">
        <Image src={photos.detail.src} alt="" widths={[800, 1500]} sizes="100vw" class="light__photo" />
      </figure>
      <div class="light__txt wrap">
        <p class="label light__k">Le souci du détail</p>
        <h2 id="light-t" class="display light__t" data-light-t>La qualité<br />se joue au millimètre</h2>
        <p class="light__p" data-light-p>
          Un angle net, un mur parfaitement plan, une découpe impeccable au ras d’un plafond ou d’une applique :
          ce sont ces détails, souvent invisibles au premier regard, qui distinguent un travail d’artisan. Ils
          demandent du temps, de la méthode et l’habitude du geste juste.
        </p>
      </div>
    </div>
  </section>
  <!-- ─── Avant, après ───────────────────────── -->
  <section class="ba-sec section dark" id="avant-apres" aria-labelledby="ba-t">
    <div class="wrap ba-sec__in">
      <h2 id="ba-t" class="display ba-sec__t" data-split>Avant, après</h2>
      <div class="ba-sec__slider" data-reveal="fade"><BeforeAfter /></div>
      <p class="script ba-sec__sign" aria-hidden="true">la preuve par l’image</p>
    </div>
  </section>

  <!-- ─── Réalisations ───────────────────────── -->
  <section class="works section" id="realisations" aria-labelledby="works-t">
    <div class="wrap">
      <div class="works__head">
        <p class="label muted" data-reveal="fade">Réalisations</p>
        <h2 id="works-t" class="display works__t" data-split>Chantiers <em>livrés</em></h2>
      </div>
      <ul class="works__grid">
        {
          selection.map((p, i) => (
            <li class={`work work--${i}`}>
              <figure>
                <div class="work__media" data-reveal="img" data-view>
                  <Image src={p.src} alt="Chantier de peinture réalisé par Benjamin Landry" widths={[500, 900, 1400]} sizes={i === 0 ? '(min-width: 1024px) 60vw, 92vw' : '(min-width: 1024px) 30vw, 80vw'} class="work__img" />
                </div>
              </figure>
            </li>
          ))
        }
      </ul>
      <div class="works__more" data-reveal="fade">
        <a href={u('/realisations/')} class="btn" data-magnetic>Voir toutes les réalisations</a>
      </div>
    </div>
  </section>

  <!-- ─── Garanties ──────────────────────────── -->
  <section class="guar section" id="garanties" aria-labelledby="guar-t">
    <div class="wrap">
      <div class="guar__head">
        <p class="label muted" data-reveal="fade">Garanties et engagements</p>
        <h2 id="guar-t" class="display guar__t" data-split>Des travaux <em>garantis</em></h2>
        <p class="prose" data-reveal="fade">
          Faire appel à un artisan assuré, c’est la certitude d’être couvert pendant et après le chantier. Voici ce
          qui vous est acquis dès la signature du devis.
        </p>
      </div>
      <ul class="guar__grid">
        {
          garanties.map((g, i) => (
            <li class="gcard" data-reveal="fade">
              <span class="gcard__n">{roman[i]}.</span>
              <h3 class="title gcard__t">{g.titre}</h3>
              <p class="muted">{g.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ─── Marques ────────────────────────────── -->
  <section class="brands" aria-labelledby="brands-t">
    <div class="wrap brands__head">
      <p id="brands-t" class="label muted">Produits et fournisseurs</p>
      <p class="brands__p" data-reveal="fade">
        Nous travaillons exclusivement avec des gammes professionnelles, choisies pour leur tenue dans le temps.
      </p>
    </div>
    <div class="brands__rail" data-brands>
      <ul class="brands__track" data-brands-track>
        {
          [0, 1, 2, 3].map((k) =>
            marques.map((m) => (
              <li class="brand" aria-hidden={k > 0 ? 'true' : undefined}>
                {m.logo ? <img src={m.logo.src} alt={k > 0 ? '' : m.nom} class={`brand__logo brand__logo--${m.id}`} loading="lazy" /> : <span class="display brand__name">{m.nom}</span>}
              </li>
            )),
          )
        }
      </ul>
    </div>
  </section>

  <!-- ─── Déroulement ────────────────────────── -->
  <section class="proc dark" id="etapes" aria-labelledby="proc-t" data-proc>
    <div class="proc__sticky">
      <div class="wrap proc__grid">
        <div class="proc__aside">
          <p class="label muted">Déroulement</p>
          <h2 id="proc-t" class="title proc__t">De la demande de devis à la livraison</h2>
          <ol class="proc__index" aria-hidden="true">
            {etapes.map((e, i) => <li class:list={{ 'is-on': i === 0 }} data-proc-dot={i}><span>{roman[i]}.</span>{e.titre}</li>)}
          </ol>
        </div>
        <ol class="proc__list">
          {
            etapes.map((e, i) => (
              <li class:list={['pstep', { 'is-on': i === 0 }]} data-pstep={i} style={`--i:${i}`}>
                <span class="pstep__n display" aria-hidden="true">{roman[i]}</span>
                <div class="pstep__body">
                  <span class="label pstep__d">{e.duree}</span>
                  <h3 class="title pstep__t">{e.titre}</h3>
                  <p class="pstep__p">{e.texte}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>


  <!-- ─── Instagram ──────────────────────────── -->
  <section class="insta section" aria-labelledby="insta-t">
    <div class="wrap">
      <div class="insta__head">
        <div>
          <p class="label muted" data-reveal="fade">Instagram</p>
          <h2 id="insta-t" class="display insta__t" data-split>Les chantiers <em>au fil des jours</em></h2>
        </div>
        <p class="insta__p" data-reveal="fade">
          Préparations, teintes, finitions : retrouvez nos chantiers en cours et terminés sur notre compte
          <a href={instagram.url} class="link-u" target="_blank" rel="noopener me">{instagram.compte}</a>.
        </p>
      </div>
      <ul class="insta__grid">
        {
          instagram.photos.map((src, i) => (
            <li class={`insta__item insta__item--${i}`}>
              <a href={instagram.url} target="_blank" rel="noopener" class="insta__link" aria-label={`Voir ${instagram.compte} sur Instagram`} tabindex={i > 0 ? -1 : undefined}>
                <span class="insta__media" data-reveal="img">
                  <Image src={src} alt="" widths={[400, 700]} sizes="(min-width: 900px) 24vw, 46vw" class="insta__img" />
                </span>
                <span class="insta__ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.4" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.4" /><circle cx="17.3" cy="6.7" r="1" fill="currentColor" /></svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="insta__more" data-reveal="fade">
        <a href={instagram.url} target="_blank" rel="noopener" class="btn" data-magnetic>Suivre sur Instagram</a>
      </div>
    </div>
  </section>

  <Faq items={faqGenerale} />
  <Contact />
</Base>

<style>
  /* ─── Ouverture ─── */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .hero__floats {
    position: absolute;
    inset: 0;
  }
  .float {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    width: var(--mw);
    will-change: transform;
  }
  .float--desk {
    display: none;
  }
  .float :global(.float__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  @media (min-width: 900px) {
    .float {
      left: var(--x);
      top: var(--y);
      width: var(--w);
    }
    .float--desk {
      display: block;
    }
  }
  .hero__center {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 22px;
    text-align: center;
    padding-inline: var(--gutter);
    max-width: 1100px;
  }
  .hero__kicker {
    color: var(--muted);
  }
  .hero__t {
    font-size: clamp(2.3rem, 9.2vw, 5.4rem);
    line-height: 0.95;
  }
  .hero__t em {
    font-weight: 400;
  }
  .hero__uni {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: min(100%, 640px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .hero__u {
    display: grid;
    gap: 2px;
    padding: 12px 10px;
    text-align: left;
    border-left: 1px solid var(--line);
    transition: background 0.4s var(--ease);
  }
  .hero__u:first-child {
    border-left: 0;
  }
  .hero__un {
    font-family: var(--serif);
    color: var(--argile);
    font-size: 0.95rem;
  }
  .hero__ut {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }
  .hero__uc {
    display: none;
    font-size: var(--fs-xs, 0.75rem);
    color: var(--muted);
  }
  @media (min-width: 700px) {
    .hero__u {
      padding: 16px 18px;
    }
    .hero__uc {
      display: block;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__u:hover {
      background: rgb(255 255 255 / 0.4);
    }
  }
  .hero__p {
    max-width: 44ch;
    color: var(--muted);
    font-size: var(--fs-s);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 28px;
    margin-top: 6px;
  }
  .hero__scroll {
    position: absolute;
    bottom: calc(24px + env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
  }
  .hero__scroll span {
    width: 40px;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: scrollhint 2.4s var(--ease) infinite;
  }
  @keyframes scrollhint {
    0% {
      transform: scaleX(0);
    }
    50% {
      transform: scaleX(1);
      transform-origin: left;
    }
    51% {
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }

  /* ─── L'atelier ─── */
  .atelier {
    display: grid;
  }
  .atelier__text {
    display: grid;
    gap: 24px;
    align-content: center;
    padding: clamp(96px, 12vw, 160px) var(--gutter) clamp(56px, 8vw, 96px);
  }
  .atelier__t {
    font-size: var(--fs-l);
    max-width: 14ch;
  }
  .atelier__p {
    max-width: 46ch;
    color: var(--muted);
  }
  .atelier__list {
    margin-top: 12px;
    border-top: 1px solid var(--line);
    max-width: 480px;
  }
  .atelier__list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 1.05rem;
  }
  .atelier__list span {
    display: inline-block;
    width: 2.6em;
    color: var(--muted);
  }
  .atelier__media {
    position: relative;
    height: 80svh;
    overflow: hidden;
  }
  .atelier__video {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }
  .atelier__cap {
    position: absolute;
    left: 18px;
    bottom: 16px;
    color: var(--lin);
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.4);
  }
  @media (min-width: 1024px) {
    .atelier {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
    .atelier__text {
      padding-inline: var(--gutter) 6vw;
    }
    .atelier__media {
      height: auto;
    }
  }

  /* ─── Univers : peinture et carrelage ─── */
  .uni {
    padding-block: clamp(96px, 12vw, 170px);
  }
  .uni__points {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .uni__points li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .uni__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--argile);
  }
  .pein {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }
  .pein figure {
    margin: 0;
    overflow: hidden;
  }
  .pein :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pein__a {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 5;
    position: relative;
  }
  .pein__a :global(img) {
    position: absolute;
    inset: -8% 0;
    height: 116%;
  }
  .pein__b {
    grid-column: 1 / 5;
    aspect-ratio: 4 / 5;
  }
  .pein__c {
    grid-column: 4 / 7;
    aspect-ratio: 3 / 4;
    margin-top: -30% !important;
  }
  .pein__pts {
    grid-column: 1 / -1;
    margin-top: 32px;
  }
  @media (min-width: 1024px) {
    .pein {
      grid-template-columns: repeat(12, 1fr);
      gap: 2vw;
      align-items: start;
    }
    .pein__a {
      grid-column: 1 / 6;
      grid-row: 1 / 3;
    }
    .pein__b {
      grid-column: 7 / 10;
      margin-top: 6vw !important;
    }
    .pein__c {
      grid-column: 10 / 13;
      margin-top: 16vw !important;
    }
    .pein__pts {
      grid-column: 7 / 13;
      margin-top: 4vw;
    }
  }
  /* Carrelage : la grille de photos dessine des joints */
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    padding: 6px;
    background: rgb(243 239 232 / 0.16);
  }
  .tile {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 1;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile--0 {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 5;
  }
  .tile--1,
  .tile--4 {
    grid-column: 1 / -1;
    aspect-ratio: 3 / 2;
  }
  .carr__pts {
    margin-top: 40px;
  }
  @media (min-width: 1024px) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, 22vw);
      gap: 8px;
      padding: 8px;
    }
    .tile {
      aspect-ratio: auto !important;
    }
    .tile--0 {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
    }
    .tile--1 {
      grid-column: 2 / 4;
      grid-row: 1 / 2;
    }
    .tile--2 {
      grid-column: 4 / 5;
      grid-row: 1 / 2;
    }
    .tile--3 {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
    }
    .tile--4 {
      grid-column: 3 / 5;
      grid-row: 2 / 3;
    }
    .carr__pts {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 4vw;
    }
  }

  /* ─── Le placo ─── */
  .chain {
    padding-block: clamp(96px, 12vw, 170px);
    background: var(--lin-2);
  }
  .chain__media {
    display: none;
  }
  .chain__list {
    display: grid;
    gap: 56px;
  }
  .cstep {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 16px;
    align-items: baseline;
  }
  .cstep__img {
    grid-column: 1 / -1;
    margin: 0 0 10px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .cstep__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cstep__n {
    font-family: var(--serif);
    font-size: 2.6rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--argile);
  }
  .cstep__t {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }
  .cstep__p {
    grid-column: 1 / -1;
    max-width: 44ch;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .chain__grid {
      display: grid;
      grid-template-columns: 6fr 5fr;
      gap: 7vw;
      align-items: start;
    }
    .chain__media {
      display: grid;
      gap: 16px;
      position: sticky;
      top: 12vh;
    }
    .chain__frame {
      position: relative;
      height: 76vh;
      overflow: hidden;
    }
    .chain__frame :global(.chain__img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      clip-path: inset(100% 0 0 0);
      transform: scale(1.08);
      transition:
        clip-path 1.1s var(--ease),
        transform 1.6s var(--ease-out);
    }
    .chain__frame :global(.chain__img.is-on) {
      clip-path: inset(0 0 0 0);
      transform: none;
    }
    .chain__count {
      color: var(--muted);
    }
    .chain__list {
      gap: 0;
      padding-block: 20vh 30vh;
    }
    .cstep {
      min-height: 62vh;
      align-content: center;
      opacity: 0.25;
      transition: opacity 0.6s var(--ease);
    }
    .cstep.is-on {
      opacity: 1;
    }
    .cstep__img {
      display: none;
    }
    .cstep__n {
      font-size: 4rem;
    }
  }

  /* ─── Le souci du détail ─── */
  .light {
    height: 240vh;
  }
  .light__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-rows: 58% 1fr;
  }
  .light__img {
    position: relative;
    overflow: hidden;
    clip-path: inset(12% 10% 12% 10%);
    will-change: clip-path;
  }
  .light__img :global(.light__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
    transform: scale(1.25);
    will-change: transform;
  }
  .light__txt {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    text-align: center;
    padding-block: 18px calc(80px + env(safe-area-inset-bottom));
  }
  .light__k {
    color: rgb(243 239 232 / 0.6);
  }
  /* Le titre s'éclaire comme sous un faisceau de lumière */
  .light__t {
    --lx: -40%;
    --base: 0.14;
    font-size: clamp(1.9rem, 8vw, 6rem);
    line-height: 1.02;
    color: transparent;
    background-image:
      radial-gradient(38% 140% at var(--lx) 55%, #fffdf8 0%, rgb(243 239 232 / 0.95) 35%, rgb(243 239 232 / 0) 72%),
      linear-gradient(rgb(243 239 232 / var(--base)), rgb(243 239 232 / var(--base)));
    -webkit-background-clip: text;
    background-clip: text;
  }
  .light__p {
    max-width: 44ch;
    font-size: var(--fs-s);
    color: rgb(243 239 232 / 0.75);
    opacity: 0;
  }
  @media (min-width: 1024px) {
    .light__sticky {
      grid-template-rows: none;
      grid-template-columns: 5fr 6fr;
    }
    .light__img {
      order: 2;
    }
    .light__txt {
      justify-items: start;
      text-align: left;
      padding: 0 5vw 0 var(--gutter);
      gap: 26px;
    }
    .light__p {
      font-size: var(--fs-body);
    }
  }

  /* ─── Savoir-faire ─── */
  .skills {
    position: relative;
    padding-block: clamp(96px, 12vw, 180px);
    overflow: hidden;
  }
  .skills__giant {
    position: relative;
    z-index: 2;
    white-space: nowrap;
    font-size: clamp(4.4rem, 17vw, 16rem);
    line-height: 1;
    pointer-events: none;
    will-change: transform;
    margin-bottom: clamp(-3rem, -5vw, -1.4rem);
  }
  .skills__giant span {
    display: inline-block;
  }
  .skills__grid {
    display: grid;
    gap: 40px;
  }
  .skills__media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
  }
  .skills__media :global(.skills__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.05);
    transition:
      opacity 0.8s var(--ease),
      transform 1.4s var(--ease-out);
  }
  .skills__media :global(.skills__img.is-on) {
    opacity: 1;
    transform: none;
  }
  .skills__body {
    display: grid;
    gap: 36px;
    align-content: end;
  }
  .skills__intro {
    max-width: 38ch;
    color: var(--muted);
  }
  .skills__list {
    border-top: 1px solid var(--line);
  }
  .skill {
    border-bottom: 1px solid var(--line);
  }
  .skill__head {
    width: 100%;
    display: grid;
    grid-template-columns: 2.8rem 1fr auto;
    align-items: baseline;
    gap: 8px;
    padding: 20px 0;
    text-align: left;
  }
  .skill__n {
    font-family: var(--serif);
    color: var(--muted);
  }
  .skill__t {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.2;
    transition: transform 0.6s var(--ease);
  }
  .skill__head[aria-expanded='true'] .skill__t {
    font-style: italic;
  }
  @media (hover: hover) {
    .skill__head:hover .skill__t {
      transform: translateX(10px);
    }
  }
  .skill__plus {
    position: relative;
    width: 12px;
    height: 12px;
    align-self: center;
    transition: transform 0.6s var(--ease);
  }
  .skill__plus::before,
  .skill__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 1px;
    background: currentColor;
  }
  .skill__plus::after {
    transform: rotate(90deg);
  }
  .skill__head[aria-expanded='true'] .skill__plus {
    transform: rotate(135deg);
  }
  .skill__body {
    overflow: hidden;
  }
  .skill__body p {
    padding: 0 0 24px 2.8rem;
    max-width: 54ch;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .skills__grid {
      grid-template-columns: 5fr 6fr;
      gap: 7vw;
      align-items: end;
    }
  }

  /* ─── Avant, après ─── */
  .ba-sec__in {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .ba-sec__t {
    position: relative;
    z-index: 2;
    font-size: clamp(3.4rem, 13vw, 12rem);
    text-align: center;
    margin-bottom: clamp(-3rem, -4vw, -1rem);
    pointer-events: none;
  }
  .ba-sec__slider {
    width: min(100%, 520px);
  }
  .ba-sec__sign {
    position: relative;
    z-index: 2;
    margin-top: 22px;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1;
    color: var(--argile);
  }

  /* ─── Réalisations ─── */
  .works__head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(48px, 7vw, 96px);
  }
  .works__t {
    font-size: var(--fs-xl);
  }
  .works__grid {
    display: grid;
    gap: clamp(40px, 6vw, 80px) 4vw;
  }
  .work figure {
    display: grid;
    gap: 14px;
  }
  .work__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 100%;
  }
  .work--0 .work__media {
    aspect-ratio: 4 / 3;
  }
  .work__media :global(.work__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .work__cap {
    display: grid;
    gap: 2px;
  }
  .work__t {
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  /* Mobile : rythme éditorial décalé */
  .work--1,
  .work--3 {
    width: 78%;
    justify-self: end;
  }
  .work--2,
  .work--4 {
    width: 84%;
  }
  @media (min-width: 900px) {
    .works__grid {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }
    .work {
      width: auto !important;
    }
    .work--0 {
      grid-column: 1 / 8;
    }
    .work--1 {
      grid-column: 9 / 13;
      margin-top: 18vw;
    }
    .work--2 {
      grid-column: 1 / 5;
    }
    .work--3 {
      grid-column: 5 / 9;
      margin-top: 8vw;
    }
    .work--4 {
      grid-column: 9 / 13;
    }
  }
  .works__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(56px, 8vw, 110px);
  }

  /* ─── Garanties ─── */
  .guar__head {
    display: grid;
    gap: 20px;
    justify-items: start;
    margin-bottom: clamp(44px, 6vw, 80px);
  }
  .guar__t {
    font-size: var(--fs-xl);
  }
  .guar__grid {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .gcard {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--line);
  }
  .gcard__n {
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--argile);
  }
  .gcard__t {
    font-size: clamp(1.45rem, 2.2vw, 1.9rem);
  }
  .gcard p {
    max-width: 40ch;
  }
  @media (min-width: 800px) {
    .guar__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 48px;
    }
  }
  @media (min-width: 1100px) {
    .guar__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .gcard {
      padding: 36px 32px 40px 0;
    }
  }

  /* ─── Marques ─── */
  .brands {
    padding-block: clamp(64px, 9vw, 120px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .brands__head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .brands__p {
    max-width: 52ch;
    color: var(--muted);
  }
  .brands__rail {
    -webkit-mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .brands__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .brand {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(170px, 24vw, 320px);
    height: clamp(84px, 10vw, 128px);
    padding-inline: 24px;
    border-left: 1px solid var(--line);
  }
  .brand__name {
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    letter-spacing: 0.08em;
    color: var(--fg);
    opacity: 0.55;
    transition: opacity 0.4s;
  }
  .brand__logo {
    display: block;
    height: clamp(44px, 5.2vw, 66px);
    width: auto;
    max-width: 74%;
    object-fit: contain;
    transition:
      filter 0.4s,
      opacity 0.4s;
  }
  .brand__logo--caparol {
    height: clamp(68px, 8vw, 102px);
  }
  @media (hover: hover) and (pointer: fine) {
    .brand__logo {
      filter: grayscale(1);
      opacity: 0.6;
    }
    .brand:hover .brand__name {
      opacity: 1;
    }
    .brand:hover .brand__logo {
      filter: none;
      opacity: 1;
    }
  }

  /* ─── Déroulement ─── */
  .proc__grid {
    display: grid;
    gap: 40px;
    padding-block: clamp(96px, 12vw, 160px);
  }
  .proc__aside {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .proc__t {
    font-size: var(--fs-l);
    max-width: 14ch;
  }
  .proc__index {
    display: none;
  }
  .proc__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .pstep {
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 16px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  /* Mobile : cartes qui s'empilent au défilement */
  @media (max-width: 1023px) {
    .proc__list {
      border: 0;
      gap: 14px;
    }
    .pstep {
      position: sticky;
      top: calc(88px + var(--i) * 12px);
      grid-template-columns: 1fr;
      min-height: 46svh;
      align-content: space-between;
      padding: 26px 22px 28px;
      background: var(--basalte-2);
      border: 1px solid var(--line);
      transform-origin: 50% 0;
      will-change: transform;
    }
    .pstep__n {
      font-size: 4.6rem;
      color: transparent;
      -webkit-text-stroke: 1px var(--argile);
    }
  }
  .pstep__n {
    font-size: 2.4rem;
    line-height: 1;
    color: var(--argile);
  }
  .pstep__body {
    display: grid;
    gap: 8px;
  }
  .pstep__d {
    color: var(--muted);
  }
  .pstep__t {
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
  }
  .pstep__p {
    color: var(--muted);
    max-width: 46ch;
  }

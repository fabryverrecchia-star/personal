---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Rows from '../components/Rows.astro';
import Sticker from '../components/Sticker.astro';
import CtaBand from '../components/CtaBand.astro';
import { ext } from '../data/site';
const rows = [
  { title: 'Les plats traiteur à partager', text: 'Pour vos petits et grands événements, notre chef vous propose des plats cuisinés maison, à partir de 4 personnes, à commander 24 h à l’avance.', img: '/img/site/plats-partage.webp', href: '/notre-cuisine-italienne/notre-offre-traiteur-italien' },
  { title: 'Le Click & Collect', text: 'Une pizza à la maison ? Un repas italien au bureau ? Pizzas, spécialités, plateaux repas et produits de la boutique vous attendent.', img: '/img/site/pizza.webp', href: '/notre-cuisine-italienne/vente-a-emporter' },
  { title: 'L’épicerie fine', text: 'Les vins de la cave, une sélection d’épicerie fine, nos fromages et charcuteries italiennes.', img: '/img/site/board.webp', href: '/notre-cuisine-italienne/notre-boutique' },
  { title: 'Oenoteca, nos vins en ligne', text: 'Notre cave à vin italienne en ligne : rouges, blancs, bières et packs à offrir.', img: '/img/site/cave.webp', href: '/oenoteca' },
];
---
<Base title="Il Ristorante chez vous" label="Chez vous" description="Traiteur, Click & Collect, épicerie fine et vins en ligne : la cucina italiana chez vous.">
  <PageHero image="/img/site/plats-selection.webp" alt="Plats italiens prêts à partager" crumbs={[{ label: 'Il Ristorante chez vous', href: '/il-ristorante-chez-vous' }]}>
    <Fragment slot="title">La cucina italiana <span class="script">chez vous !</span></Fragment>
    <Fragment slot="lead">À la maison, au bureau et pour tous vos moments de convivialité.</Fragment>
    <Sticker shape="stickers-03" style="right:calc(var(--gutter) + 4vw);top:24vh;color:var(--giardino)">A casa</Sticker>
  </PageHero>
  <section class="section wrap t-dolce">
    <div class="sec-head"><span class="eyebrow">Quatre façons d’en profiter</span><span class="idx">4</span></div>
    <Rows rows={rows} />
  </section>
  <CtaBand href={ext.commander} label="Commander en Click & Collect" theme="t-giardino" eyebrow="Ce soir, on reste à la maison ?">On vous <span class="script">prépare tout</span></CtaBand>
</Base>

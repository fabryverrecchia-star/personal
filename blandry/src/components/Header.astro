---
import { Image } from 'astro:assets';
import { site, zones, telHref, instagram, selection } from '../data/site';
import { u } from '../lib/url';
import Logo from './Logo.astro';
const nav = [
  { href: u('/#placo'), label: 'Plâtrerie' },
  { href: u('/#peinture'), label: 'Peinture' },
  { href: u('/#carrelage'), label: 'Carrelage' },
  { href: u('/#avant-apres'), label: 'Avant, après' },
  { href: u('/realisations/'), label: 'Réalisations' },
  { href: u('/#contact'), label: 'Contact' },
];
---

<header class="header" data-header>
  <div class="header__in wrap">
    <a href={u('/')} class="logo" aria-label={`${site.nom}, accueil`}>
      <Logo class="logo__mark" />
      <span class="logo__name label">{site.nom}</span>
    </a>

    <nav class="header__nav label" aria-label="Navigation principale">
      {nav.map((l) => <a href={l.href} class="link-u">{l.label}</a>)}
    </nav>

    <div class="header__right label">
      <a href={u('/#contact')} class="header__quote link-u">Devis gratuit</a>
      <button class="burger" data-burger aria-expanded="false" aria-controls="menu">
        <span data-burger-label>Menu</span>
        <span class="burger__i" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu aria-hidden="true">
  <div class="menu__bg" data-menu-bg></div>
  <div class="menu__in wrap">
    <nav class="menu__nav" aria-label="Menu">
      <ul>
        {
          nav.map((l, i) => (
            <li class="menu__li">
              <a href={l.href} class="menu__a" data-menu-link data-menu-i={i}>
                <span class="label menu__n">{['I', 'II', 'III', 'IV', 'V', 'VI'][i]}.</span>
                <span class="display menu__t">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu__media" aria-hidden="true">
      {selection.map((p, i) => <Image src={p.src} alt="" widths={[600]} sizes="30vw" class:list={['menu__img', { 'is-on': i === 0 }]} data-menu-img={i} />)}
    </div>
    <div class="menu__foot" data-menu-foot>
      <div>
        <p class="label muted">Téléphone</p>
        <a href={telHref} class="title menu__tel">{site.telephone}</a>
      </div>
      <div>
        <p class="label muted">Instagram</p>
        <a href={instagram.url} class="link-u" target="_blank" rel="noopener">{instagram.compte}</a>
      </div>
      <div>
        <p class="label muted">Zone d’intervention</p>
        <p class="menu__zones">
          {zones.map((z, i) => <>{i > 0 && ' · '}<a href={u(`/${z.slug}/`)} class="link-u">{z.nom}</a></>)}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 120;
    padding-top: env(safe-area-inset-top);
    color: var(--basalte);
    transition:
      transform 0.8s var(--ease),
      color 0.4s;
  }
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--lin) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid color-mix(in srgb, var(--basalte) 8%, transparent);
    opacity: 0;
    transition:
      opacity 0.5s,
      background-color 0.4s;
  }
  .header.is-scrolled::before {
    opacity: 1;
  }
  .header.is-light {
    color: var(--lin);
  }
  .header.is-light::before {
    background: color-mix(in srgb, var(--basalte) 82%, transparent);
    border-color: rgb(243 239 232 / 0.08);
  }
  /* Menu ouvert : pas de bandeau translucide au-dessus du panneau */
  :global(.menu-open) .header::before {
    opacity: 0;
    transition: none;
  }
  .header.is-hidden {
    transform: translateY(-110%);
  }
  .header__in {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    height: 72px;
    max-width: none;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 14px;
    position: relative;
    z-index: 2;
  }
  .logo :global(.logo__mark) {
    font-size: 2.3rem;
  }
  .logo__name {
    padding-left: 14px;
    border-left: 1px solid currentColor;
    opacity: 0.8;
  }
  .header__nav {
    display: none;
    gap: 34px;
  }
  .header__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 28px;
    position: relative;
    z-index: 2;
  }
  .header__quote {
    display: none;
  }
  .burger {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  .burger__i {
    display: grid;
    gap: 6px;
    width: 24px;
  }
  .burger__i i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.6s var(--ease);
  }
  :global(.menu-open) .burger__i i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  :global(.menu-open) .burger__i i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  :global(.menu-open) .header {
    color: var(--basalte);
  }
  @media (min-width: 1100px) {
    .header__in {
      grid-template-columns: 1fr auto 1fr;
    }
    .header__nav,
    .header__quote {
      display: flex;
    }
  }

  /* Menu plein écran */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 110;
    clip-path: inset(0 0 100% 0);
    will-change: clip-path;
    visibility: hidden;
    pointer-events: none;
    color: var(--basalte);
  }
  :global(.menu-open) .menu {
    visibility: visible;
    pointer-events: auto;
  }
  .menu__bg {
    position: absolute;
    inset: 0;
    background: var(--lin-2);
  }
  .menu__in {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 32px;
    padding-top: calc(110px + env(safe-area-inset-top));
    padding-bottom: calc(28px + env(safe-area-inset-bottom));
    max-width: none;
    overflow-y: auto;
  }
  .menu__li {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .menu__a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0 10px;
  }
  .menu__n {
    width: 3.2em;
    opacity: 0.55;
  }
  .menu__t {
    display: block;
    font-size: clamp(2.2rem, 9.5vw, 5.4rem);
    will-change: transform;
  }
  .menu__a {
    transition: padding-left 0.6s var(--ease);
  }
  @media (hover: hover) {
    .menu__a:hover {
      padding-left: 18px;
    }
    .menu__a:hover .menu__t {
      font-style: italic;
    }
  }
  .menu__media {
    display: none;
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
  }
  .menu__tel {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  .menu__zones {
    margin-top: 4px;
  }
  @media (min-width: 1100px) {
    .menu__in {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: 1fr auto;
      column-gap: 6vw;
    }
    .menu__media {
      display: block;
      position: relative;
      align-self: center;
      aspect-ratio: 4 / 5;
      max-height: 62vh;
      overflow: hidden;
    }
    .menu__media :global(.menu__img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(1.06);
      transition:
        opacity 0.6s,
        transform 1.2s var(--ease-out);
    }
    .menu__media :global(.menu__img.is-on) {
      opacity: 1;
      transform: none;
    }
    .menu__foot {
      grid-column: 1 / -1;
    }
  }
</style>

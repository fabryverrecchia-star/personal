---
import { site, zones, telHref } from '../data/site';
import { u } from '../lib/url';
const nav = [
  { href: u('/#avant-apres'), label: 'Avant / après' },
  { href: u('/#realisations'), label: 'Réalisations' },
  { href: u('/#savoir-faire'), label: 'Savoir-faire' },
  { href: u('/#etapes'), label: 'Déroulement' },
  { href: u('/#contact'), label: 'Contact' },
];
---

<header class="header" data-header>
  <div class="header__in wrap">
    <a href={u('/')} class="logo" aria-label={`${site.nom}, accueil`}>
      <span class="logo__mono" aria-hidden="true">{site.monogramme}</span>
      <span class="logo__txt label">{site.nom}<br />Peinture &amp; finitions</span>
    </a>

    <nav class="header__nav label" aria-label="Navigation principale">
      {nav.map((l) => <a href={l.href} class="link-u">{l.label}</a>)}
    </nav>

    <div class="header__right">
      <a href={telHref} class="header__tel label link-u">{site.telephone}</a>
      <button class="burger label" data-burger aria-expanded="false" aria-controls="menu">
        <span class="burger__t" data-burger-label>Menu</span>
        <span class="burger__i" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu aria-hidden="true">
  <div class="menu__bg" data-menu-bg></div>
  <div class="menu__in wrap">
    <nav aria-label="Menu">
      <ul class="menu__main">
        {
          nav.map((l, i) => (
            <li class="menu__li">
              <a href={l.href} data-menu-link class="menu__a">
                <span class="label menu__n">({String(i + 1).padStart(2, '0')})</span>
                <span class="display">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu__foot" data-menu-link>
      <div>
        <p class="label menu__lab">Appeler</p>
        <a href={telHref} class="display menu__tel">{site.telephone}</a>
      </div>
      <div class="menu__zones">
        <p class="label menu__lab">Zone d’intervention</p>
        {zones.map((z) => <a href={u(`/${z.slug}/`)} class="link-u">{z.nom}</a>)}
      </div>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 120;
    padding-top: env(safe-area-inset-top);
    color: var(--noir);
    transition:
      transform 0.7s var(--ease),
      color 0.35s;
  }
  .header.is-light {
    color: var(--craie);
  }
  .header.is-hidden {
    transform: translateY(-110%);
  }
  .header__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 76px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    z-index: 2;
  }
  .logo__mono {
    font-family: var(--script);
    font-size: 2.5rem;
    line-height: 1;
    padding-top: 0.14em;
    letter-spacing: -0.06em;
    color: var(--bordeaux-vif);
  }
  .is-light .logo__mono {
    color: inherit;
  }
  .logo__txt {
    line-height: 1.35;
    opacity: 0.8;
  }
  .header__nav {
    display: none;
    gap: 28px;
  }
  .header__right {
    display: flex;
    align-items: center;
    gap: 28px;
    position: relative;
    z-index: 2;
  }
  .header__tel {
    display: none;
  }
  .burger {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 44px;
  }
  .burger__i {
    display: grid;
    gap: 6px;
    width: 26px;
  }
  .burger__i i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.6s var(--ease);
  }
  :global(.menu-open) .burger__i i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  :global(.menu-open) .burger__i i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  :global(.menu-open) .header {
    color: var(--craie);
  }
  :global(.menu-open) .logo__mono {
    color: var(--craie);
  }
  @media (min-width: 1100px) {
    .header__nav,
    .header__tel {
      display: flex;
    }
  }

  /* Menu plein écran bordeaux */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 110;
    color: var(--craie);
    visibility: hidden;
    pointer-events: none;
  }
  :global(.menu-open) .menu {
    visibility: visible;
    pointer-events: auto;
  }
  .menu__bg {
    position: absolute;
    inset: 0;
    background: var(--bordeaux);
    clip-path: inset(0 0 100% 0);
  }
  .menu__in {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding-top: calc(104px + env(safe-area-inset-top));
    padding-bottom: calc(28px + env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  .menu__li {
    overflow: hidden;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }
  .menu__a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 10px 0 6px;
  }
  .menu__a .display {
    font-size: clamp(2.9rem, 13vw, 7rem);
    transition: transform 0.6s var(--ease);
  }
  .menu__n {
    opacity: 0.55;
    width: 4ch;
  }
  @media (hover: hover) {
    .menu__a:hover .display {
      transform: translateX(16px);
    }
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
  }
  .menu__lab {
    opacity: 0.55;
    margin-bottom: 8px;
  }
  .menu__tel {
    font-size: clamp(2.2rem, 9vw, 4rem);
  }
  .menu__zones {
    display: grid;
    gap: 4px;
    align-content: start;
  }
</style>

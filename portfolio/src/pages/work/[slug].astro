---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { getProjects } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, client, year, category, role, url } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={`${title} — ${category} pour ${client} (${year}).`}>
  <article class="project">
    <!-- Visuel plein écran : cible du zoom depuis la grille -->
    <div class="project__hero" data-gl-hero-wrap>
      <ProjectMedia project={project} sizes="100vw" eager hover={false} />
      <div class="project__hero-inner container">
        <a href="/" class="project__close link" data-close>Fermer <span aria-hidden="true">✕</span></a>
        <h1 class="project__title display" data-reveal="lines">{title}</h1>
      </div>
    </div>

    <header class="project__head container grid">
      <dl class="project__meta">
        <div data-reveal><dt class="label">Client</dt><dd>{client}</dd></div>
        <div data-reveal><dt class="label">Année</dt><dd class="figures">{year}</dd></div>
        <div data-reveal><dt class="label">Type</dt><dd>{category}</dd></div>
        <div data-reveal><dt class="label">Rôle</dt><dd>{role.join(', ')}</dd></div>
        {
          url && (
            <div data-reveal>
              <dt class="label">En ligne</dt>
              <dd><a href={url} class="link" target="_blank" rel="noopener noreferrer">Voir le site ↗</a></dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="project__body container grid">
      <div class="prose" data-reveal="lines"><Content /></div>
    </div>

    <a href={`/work/${next.id}`} class="project__next container">
      <span class="label">Projet suivant</span>
      <span class="project__next-title display">{next.data.title} <em>→</em></span>
    </a>
  </article>
</Base>

<style>
  .project {
    margin-top: calc(-1 * var(--header-h));
  }
  .project__hero {
    position: relative;
    height: 100svh;
    color: #fff;
  }
  .project__hero :global(.media) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    height: 100%;
  }
  .project__hero-inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding-block: calc(var(--header-h) + 1rem) var(--margin);
  }
  .project__close {
    align-self: flex-end;
    font-size: var(--fs-sm);
  }
  .project__title {
    font-size: var(--fs-xxl);
    font-family: var(--font-display);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .project__head {
    padding-top: clamp(2rem, 6vw, 5rem);
  }
  .project__meta {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem var(--gutter);
    font-size: var(--fs-sm);
  }
  .project__body {
    margin-top: clamp(3rem, 8vw, 7rem);
  }
  .prose {
    grid-column: 4 / span 6;
    display: grid;
    gap: 1em;
    font-size: var(--fs-lg);
    line-height: 1.3;
  }
  .prose :global(h2) {
    margin-top: 1em;
    font-family: 'Garamond Swash', var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: var(--fs-xl);
    line-height: 1;
  }
  .project__next {
    display: block;
    margin-top: clamp(6rem, 12vw, 10rem);
  }
  .project__next-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--fs-xxl);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  @media (max-width: 800px) {
    .prose {
      grid-column: 1 / -1;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
import monogram from '../assets/svg/monogram.svg?raw';
const main = photo('duo', 'apiculteurs');
const detail = photo('ruche', 'tamis');
---

<section class="maison" id="maison">
  <div class="wrap maison__grid">
    <div class="maison__text">
      <p class="label muted" data-reveal>La maison</p>
      <h2 class="h2" data-split>Une apiculture <em>familiale,</em> à l’échelle de la ruche</h2>
      <p class="lead" data-reveal>
        Nathalie et Frédéric Baltzer veillent sur leurs colonies à Coat ar Bescond, au cœur des Côtes-d’Armor.
      </p>
      <p class="muted" data-reveal>
        Nous faisons le choix d’une production volontairement limitée, pour préserver nos abeilles et la nature qui les
        nourrit. Peu de pots chaque saison, mais un miel qui raconte le paysage où il est né.
      </p>
      <div class="maison__sign" data-reveal>
        <span class="maison__mono" set:html={monogram} />
        <span class="label muted">Nathalie &amp; Frédéric Baltzer</span>
      </div>
    </div>

    <figure class="maison__main" data-gl data-reveal-img data-gl-parallax="0.1">
      <Image src={main} alt="Nathalie et Frédéric Baltzer auprès d’une ruche" widths={[600, 1000, 1400]} sizes="(max-width: 800px) 92vw, 44vw" />
    </figure>

    <figure class="maison__detail" data-gl data-reveal-img data-gl-parallax="-0.08">
      <Image src={detail} alt="" widths={[400, 800]} sizes="(max-width: 800px) 50vw, 20vw" />
    </figure>
  </div>
</section>

<style>
  .maison {
    padding-bottom: clamp(120px, 16vw, 240px);
  }
  .maison__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 3rem;
    align-items: start;
  }
  .maison__text {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.8rem;
    align-self: center;
    max-width: 34rem;
  }
  .maison__text .h2 em {
    color: var(--gold);
  }
  .maison__sign {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
  }
  .maison__mono {
    width: 44px;
    height: 44px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .maison__mono :global(svg) {
    width: 100%;
    height: 100%;
  }
  .maison__main,
  .maison__detail {
    position: relative;
    overflow: hidden;
    background: var(--paper);
  }
  .maison__main {
    grid-column: 7 / span 6;
    aspect-ratio: 4 / 5;
  }
  .maison__detail {
    grid-column: 4 / span 3;
    aspect-ratio: 3 / 4;
    margin-top: -18%;
  }
  .maison__main :global(img),
  .maison__detail :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 800px) {
    .maison__text,
    .maison__main {
      grid-column: 1 / -1;
    }
    .maison__detail {
      grid-column: 6 / -1;
      margin-top: -30%;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import logo from '../assets/svg/logo.svg?raw';
import { photo } from '../lib/photos';
const slides = [
  { img: photo('duo', 'apiculteurs'), cap: 'Nathalie & Frédéric' },
  { img: photo('recolte', 'tamis'), cap: 'La récolte' },
  { img: photo('ruche', 'filet'), cap: 'Au cœur de la ruche' },
  { img: photo('fleur', 'cuillere'), cap: 'Les floraisons' },
];
---

<section class="hero" id="top" data-hero>
  <div class="hero__head wrap">
    <p class="label" data-hero-fade>Miel naturel · Côtes-d’Armor</p>
    <p class="label hero__year" data-hero-fade>Récolte 2026</p>
  </div>

  <h1 class="hero__title wrap">
    <span class="sr-only">Mel Ar Bescond — miel naturel des Côtes-d’Armor</span>
    <span class="hero__logo" data-hero-logo set:html={logo} />
  </h1>

  <div class="hero__stage" data-hero-stage>
    <figure class="hero__frame" data-hero-frame data-gl-slides data-gl-parallax="0.08">
      {
        slides.map((s, i) => (
          <Image src={s.img} alt={i === 0 ? 'Nathalie et Frédéric Baltzer auprès de leurs ruches' : ''} widths={[900, 1600, 2200]} sizes="100vw" loading="eager" data-slide={i} />
        ))
      }
    </figure>
    <div class="hero__caption wrap">
      <p class="hero__by" data-hero-fade>Par Nathalie &amp; Frédéric Baltzer</p>
      <p class="hero__slide label" data-hero-fade aria-hidden="true">
        <span class="hero__slide-n"><span data-slide-n>01</span> / 04</span>
        <span class="hero__slide-cap" data-slide-cap>{slides[0].cap}</span>
      </p>
      <a href="#commander" class="cta" data-hero-fade>Composer mon panier <span class="cta__line"></span></a>
    </div>
    <script type="application/json" data-slide-caps set:html={JSON.stringify(slides.map((s) => s.cap))} />
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(96px, 14vh, 150px);
  }
  .hero__head {
    display: flex;
    justify-content: space-between;
    color: var(--ink-soft);
  }
  .hero__title {
    margin-top: clamp(28px, 6vh, 64px);
  }
  .hero__logo {
    display: block;
    color: var(--ink);
  }
  .hero__logo :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero__logo :global(.glyph) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .hero__stage {
    position: relative;
    margin-top: clamp(40px, 7vh, 80px);
  }
  .hero__frame {
    --inset: var(--gutter);
    position: relative;
    height: 88svh;
    margin-inline: var(--inset);
    overflow: hidden;
    background: var(--paper);
  }
  .hero__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__frame :global(img:not([data-slide='0'])) {
    opacity: 0;
  }
  .hero__slide {
    display: flex;
    gap: 1.4rem;
    color: var(--ink-soft);
  }
  .hero__slide-n {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .hero__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.6rem 0;
  }
  .hero__by {
    font-size: var(--fs-lead);
    font-style: italic;
    font-weight: 300;
  }

  @media (max-width: 700px) {
    .hero__frame {
      height: 72svh;
    }
    .hero__caption {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

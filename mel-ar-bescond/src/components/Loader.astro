---
// Ouverture sur fond blanc : le monogramme NF se compose au rythme du chargement (son contour se trace,
// puis il se remplit d'encre), « Mel ar Bescond » apparaît, puis le rideau se lève sur le site.
import mono from '../assets/svg/monogram-fine.svg?raw';
import logo from '../assets/svg/logo.svg?raw';
const vb = mono.match(/viewBox="([^"]+)"/)![1];
const d = mono.match(/ d="([^"]+)"/)![1];
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader__center">
    <svg class="loader__mono" viewBox={vb} data-loader-mono>
      <path class="loader__ghost" d={d} data-mono-ghost></path>
      <path class="loader__fill" d={d} data-mono-fill></path>
      <path class="loader__stroke" d={d} pathLength="1" data-mono-stroke></path>
    </svg>
    <div class="loader__logo" data-loader-logo set:html={logo} />
  </div>
  <div class="loader__foot">
    <span class="loader__bar"><i data-loader-bar></i></span>
    <span class="label loader__pct"><span data-loader-pct>0</span></span>
  </div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: #fff;
    color: var(--ink);
  }
  :global(html:not(.js)) .loader {
    display: none;
  }
  .loader__center {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .loader__mono {
    width: clamp(92px, 11vw, 150px);
    height: auto;
    overflow: visible;
  }
  .loader__stroke {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .loader__fill {
    fill: var(--ink);
    opacity: 0;
  }
  /* empreinte du monogramme, visible dès l'affichage de la page, avant même le script */
  .loader__ghost {
    fill: var(--ink);
    opacity: 0.07;
    animation: breathe 2.4s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      opacity: 0.14;
    }
  }
  .loader__logo {
    position: absolute;
    top: calc(100% + clamp(24px, 3.4vh, 40px));
    left: 50%;
    translate: -50% 0;
    width: clamp(190px, 22vw, 300px);
  }
  .loader__logo :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .loader__logo :global(.glyph) {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .loader__foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(clamp(24px, 5vh, 48px) + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .loader__bar {
    position: relative;
    flex: 1;
    height: 1px;
    background: rgb(23 18 13 / 0.12);
    overflow: hidden;
  }
  .loader__bar i {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  .loader__pct {
    min-width: 3ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
</style>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  sizes?: string;
  eager?: boolean;
  /** Perspective au survol (désactivée pour le visuel plein écran) */
  hover?: boolean;
  /** false : visuel HTML simple, sans rendu WebGL */
  gl?: boolean;
  /** Couleur de fond forcée (sinon celle du projet) */
  tint?: string;
}
const {
  project,
  sizes = '(max-width: 800px) 100vw, 50vw',
  eager = false,
  hover = true,
  gl = true,
  tint,
} = Astro.props;
const { cover, title } = project.data;
const color = tint ?? project.data.color;
---

<div
  class="media"
  style={`--media-color: ${color}`}
  data-gl={gl ? '' : undefined}
  data-gl-id={project.id}
  data-gl-color={color}
  data-gl-title={title}
  data-gl-hover={hover ? undefined : 'off'}
>
  {
    cover ? (
      <Image
        src={cover}
        alt={title}
        widths={[480, 800, 1200, 1800]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <span class="media__placeholder italic">{title}</span>
    )
  }
</div>

<style>
  .media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    container-type: inline-size;
    background:
      radial-gradient(90% 80% at 68% 28%, rgb(255 250 240 / 0.28), transparent 70%),
      radial-gradient(closest-side, transparent 60%, rgb(20 18 14 / 0.22)),
      var(--media-color);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .media__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 9cqi;
    color: rgb(246 241 231 / 0.9);
  }
</style>

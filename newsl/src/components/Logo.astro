---
// Logo Soundslike vectorisé (brand/logos/soundslike.svg).
// animated : chaque contour est tracé séparément (ordre de lecture) pour
// l'animation « le logo s'écrit », puis le remplissage apparaît.
import source from '../../brand/logos/soundslike.svg?raw';

interface Props {
  animated?: boolean;
}

const { animated = false } = Astro.props;
const d = source.match(/ d="([^"]+)"/)![1];

const strokes = (d.match(/M[^M]*/g) ?? [])
  .map((path) => {
    const n = path.match(/-?\d+(?:\.\d+)?/g)!.map(Number);
    const xs = n.filter((_, i) => i % 2 === 0);
    const ys = n.filter((_, i) => i % 2 === 1);
    // « sounds » (ligne du haut) puis « like », de gauche à droite
    const row = Math.min(...ys) > 150 ? 1 : 0;
    return { path, key: row * 1000 + Math.min(...xs) };
  })
  .sort((a, b) => a.key - b.key)
  .map((s) => s.path);
---

<svg class:list={['logo', { 'logo--animated': animated }]} viewBox="0 0 543 266" role="img" aria-label="Soundslike">
  {
    animated && (
      <g class="logo__strokes" fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke">
        {strokes.map((p) => (
          <path d={p} />
        ))}
      </g>
    )
  }
  <path class="logo__fill" fill="currentColor" fill-rule="evenodd" d={d}></path>
</svg>

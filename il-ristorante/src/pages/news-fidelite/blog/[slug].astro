---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Media from '../../../components/Media.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { posts, type Post } from '../../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const others = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
---
<Base title={post.title} label={post.title} description={post.lead} image={post.img}>
  <PageHero image={post.img} alt={post.alt} crumbs={[{ label: 'Blog', href: '/news-fidelite/blog' }, { label: post.cat, href: `/news-fidelite/blog/${post.slug}` }]} short eyebrow={`${post.cat} · ${post.time}`}>
    <Fragment slot="title">{post.title}</Fragment>
    <Fragment slot="lead">{post.lead}</Fragment>
  </PageHero>
  <article class="section wrap t-dolce">
    <div class="grid">
      <div class="article" style="grid-column:3/span 8">
        {post.body.map((p, i) => <p class:list={{ 'article-first': i === 0 }} data-reveal>{p}</p>)}
      </div>
    </div>
  </article>
  <section class="section wrap t-dolce" style="padding-top:0">
    <div class="sec-head"><span class="eyebrow">À lire aussi</span><span class="idx">→</span></div>
    <div class="cards">
      {others.map((p) => (
        <a class="card" href={`/news-fidelite/blog/${p.slug}`} data-cursor="Lire" data-label={p.title} data-reveal>
          <Media src={p.img} alt={p.alt} />
          <div class="meta"><span>{p.cat}</span><span>{p.time}</span></div>
          <h3>{p.title}</h3>
        </a>
      ))}
    </div>
  </section>
  <CtaBand href="/restaurants" label="Réserver votre table">On vous garde <span class="script">une table ?</span></CtaBand>
</Base>

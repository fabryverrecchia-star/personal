---
import { Image } from 'astro:assets';
import { comparaisons } from '../data/site';
---

<div class="bax" data-bax>
  {
    comparaisons.length > 1 && (
      <div class="bax__tabs" role="tablist" aria-label="Choisir un chantier">
        {comparaisons.map((c, i) => (
          <button
            class="bax__tab"
            role="tab"
            id={`ba-tab-${c.id}`}
            aria-controls={`ba-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-ba-tab={i}
          >
            {c.onglet}
          </button>
        ))}
      </div>
    )
  }
  {
    comparaisons.map((c, i) => (
      <figure class="ba" data-ba id={`ba-${c.id}`} role="tabpanel" aria-labelledby={`ba-tab-${c.id}`} hidden={i !== 0}>
        <div class="ba__frame" style="--x:50%">
          <Image src={c.apres.src} alt={c.apres.alt} class="ba__img" widths={[540, 1080]} sizes="(min-width: 1024px) 40vw, 92vw" />
          <div class="ba__before">
            <Image src={c.avant.src} alt={c.avant.alt} class="ba__img" widths={[540, 1080]} sizes="(min-width: 1024px) 40vw, 92vw" />
          </div>
          <span class="ba__tag ba__tag--l">Avant</span>
          <span class="ba__tag ba__tag--r">Après</span>
          <input class="ba__range" type="range" min="0" max="100" value="50" step="0.5" aria-label={`Comparer avant et après : ${c.titre}`} data-ba-range />
          <span class="ba__line" aria-hidden="true">
            <span class="ba__knob">
              <svg viewBox="0 0 24 24"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </span>
          </span>
        </div>
        <figcaption class="ba__cap">
          <strong>{c.titre}</strong>
          <span>{c.texte}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .bax {
    display: grid;
    gap: 14px;
  }
  .bax__tabs {
    display: flex;
    gap: 2px;
    justify-self: start;
  }
  .bax__tab {
    height: 42px;
    padding: 0 16px;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background 0.4s,
      color 0.4s;
  }
  .bax__tab[aria-selected='true'] {
    background: var(--bordeaux);
    color: var(--craie);
    box-shadow: none;
  }
  .ba {
    display: grid;
    gap: 12px;
  }
  .ba[hidden] {
    display: none;
  }
  .ba__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
    background: var(--noir-2);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
  }
  .ba__frame :global(.ba__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--x)) 0 0);
  }
  .ba__before :global(.ba__img) {
    filter: grayscale(0.6) contrast(1.05);
  }
  .ba__tag {
    position: absolute;
    bottom: 14px;
    padding: 7px 10px;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--craie);
    color: var(--noir);
    pointer-events: none;
  }
  .ba__tag--l {
    left: 14px;
  }
  .ba__tag--r {
    right: 14px;
    background: var(--bordeaux);
    color: var(--craie);
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .ba__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 2px;
    margin-left: -1px;
    background: var(--craie);
    pointer-events: none;
  }
  .ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 58px;
    height: 58px;
    margin: -29px 0 0 -29px;
    border-radius: 50%;
    background: var(--bordeaux);
    color: var(--craie);
    display: grid;
    place-items: center;
    transition: transform 0.4s var(--ease-out);
  }
  .ba__knob svg {
    width: 22px;
  }
  .ba__frame:hover .ba__knob {
    transform: scale(1.12);
  }
  .ba__range:focus-visible ~ .ba__line .ba__knob {
    outline: 2px solid var(--craie);
    outline-offset: 3px;
  }
  .ba__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    font-size: var(--fs-s);
  }
  .ba__cap span {
    color: var(--muted);
  }
</style>

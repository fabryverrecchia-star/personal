---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
const duo = photo('duo', 'apiculteurs');
const pot = photo('pot');
import monogram from '../assets/svg/monogram.svg?raw';
---

<section class="maison" id="maison">
  <div class="wrap maison__grid">
    <figure class="maison__photo" data-clip-reveal>
      <div class="maison__photo-in" data-parallax="0.14">
        <Image src={duo} alt="Nathalie et Frédéric auprès de leurs ruches" widths={[480, 720, 1080]} sizes="(max-width: 800px) 92vw, 46vw" />
      </div>
      <figcaption class="label maison__cap">Coat ar Bescond — Louargat</figcaption>
    </figure>

    <div class="maison__text">
      <p class="label maison__kicker" data-reveal>La maison</p>
      <h2 class="h2" data-split>
        Une histoire <em>de famille,</em> de patience et de fleurs
      </h2>
      <p class="lead muted" data-reveal>
        Nathalie et Frédéric Baltzer veillent sur leurs ruches à Coat ar Bescond, au cœur des Côtes-d’Armor. Ici, pas de
        production intensive : chaque colonie est respectée, chaque récolte attendue.
      </p>
      <p class="muted" data-reveal>
        Nous faisons le choix d’une production volontairement limitée, pour préserver nos abeilles et la nature qui les
        nourrit. Le résultat : peu de pots chaque saison, mais un miel qui raconte le paysage où il est né.
      </p>

      <div class="maison__sign" data-reveal>
        <span class="maison__mono" set:html={monogram} />
        <span class="script">Nathalie &amp; Frédéric</span>
      </div>

      <figure class="maison__small" data-clip-reveal>
        <div data-parallax="-0.1">
          <Image src={pot} alt="Pot de miel Mel Ar Bescond" widths={[300, 600]} sizes="(max-width: 800px) 40vw, 16vw" />
        </div>
      </figure>
    </div>
  </div>

  <ul class="wrap maison__stats">
    <li data-reveal><span class="maison__num" data-count="2">2</span><span class="label">récoltes par an</span></li>
    <li data-reveal><span class="maison__num">22540</span><span class="label">Louargat, Côtes-d’Armor</span></li>
    <li data-reveal><span class="maison__num">100<small>%</small></span><span class="label">familial &amp; local</span></li>
  </ul>
</section>

<style>
  .maison {
    padding-block: clamp(60px, 10vw, 140px) clamp(100px, 14vw, 200px);
    background: var(--cream);
  }
  .maison__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .maison__photo {
    position: sticky;
    top: 12vh;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: clamp(160px, 20vw, 340px) clamp(160px, 20vw, 340px) 6px 6px;
    background: var(--paper);
  }
  .maison__photo-in,
  .maison__small > div {
    position: absolute;
    inset: -12% 0;
  }
  .maison__photo :global(img),
  .maison__small :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .maison__cap {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    color: var(--ivory);
    white-space: nowrap;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.3);
  }
  .maison__text {
    display: grid;
    gap: clamp(20px, 2.4vw, 32px);
    padding-top: clamp(20px, 8vw, 120px);
  }
  .maison__kicker {
    color: var(--amber);
  }
  .maison__text .h2 em {
    color: var(--amber);
  }
  .maison__sign {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .maison__sign .script {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    color: var(--brown);
    line-height: 1;
  }
  .maison__mono {
    width: 58px;
    height: 58px;
    padding: 9px;
    border: 1px solid var(--brown);
    border-radius: 50%;
    color: var(--brown);
  }
  .maison__mono :global(svg) {
    width: 100%;
    height: 100%;
  }
  .maison__small {
    position: relative;
    width: min(48%, 260px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 999px 999px 4px 4px;
    justify-self: end;
    margin-top: 2rem;
    background: var(--paper);
  }
  .maison__stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(80px, 10vw, 150px);
  }
  .maison__stats li {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .maison__num {
    font-size: clamp(3rem, 7vw, 6.4rem);
    line-height: 0.9;
    font-weight: 330;
    font-variant-numeric: lining-nums;
    color: var(--ink);
  }
  .maison__num small {
    font-size: 0.5em;
    vertical-align: super;
  }

  @media (max-width: 800px) {
    .maison__grid {
      grid-template-columns: 1fr;
    }
    .maison__photo {
      position: relative;
      top: 0;
    }
    .maison__text {
      padding-top: 0;
    }
    .maison__stats {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .maison__stats li {
      grid-template-columns: auto 1fr;
      align-items: end;
      gap: 1.2rem;
      padding-block: 1.2rem;
    }
  }
</style>

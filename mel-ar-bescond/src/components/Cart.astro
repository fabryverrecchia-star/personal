---
import { site } from '../site.config';
---

<div class="cart" data-cart aria-hidden="true" data-email={site.email}>
  <div class="cart__veil" data-cart-close></div>
  <aside class="cart__panel" role="dialog" aria-modal="true" aria-labelledby="cart-title" data-cart-panel>
    <header class="cart__head">
      <h2 id="cart-title" class="cart__title">Ma <em>demande</em></h2>
      <button class="cart__x label" type="button" data-cart-close>Fermer</button>
    </header>

    <div class="cart__scroll" data-lenis-prevent>
      <div class="cart__empty" data-cart-empty>
        <p class="muted">Votre panier est vide. Choisissez vos pots, puis revenez ici pour nous envoyer votre demande.</p>
        <a href="#commander" class="cta" data-cart-close>Composer mon panier <span class="cta__line"></span></a>
      </div>
      <ul class="cart__items" data-cart-items></ul>

      <form class="cart__form" id="cart-form" data-cart-form>
        <p class="label muted">Pour vous rappeler</p>
        <label class="field">
          <span class="label">Nom et prénom</span>
          <input id="f-name" name="name" required autocomplete="name" />
        </label>
        <label class="field">
          <span class="label">Téléphone</span>
          <input id="f-phone" name="phone" type="tel" required autocomplete="tel" />
        </label>
        <label class="field">
          <span class="label">E-mail (facultatif)</span>
          <input id="f-email" name="email" type="email" autocomplete="email" />
        </label>
        <fieldset class="field field--choice">
          <legend class="label">Récupération</legend>
          <label><input id="f-pick-1" type="radio" name="pickup" value="Retrait à Louargat" checked /> Retrait à Louargat</label>
          <label><input id="f-pick-2" type="radio" name="pickup" value="Remise en main propre, à convenir" /> À convenir</label>
        </fieldset>
        <label class="field">
          <span class="label">Message (facultatif)</span>
          <textarea id="f-msg" name="message" rows="2"></textarea>
        </label>
      </form>

      <div class="sent" data-sent hidden>
        <p class="sent__title">Merci.</p>
        <p class="muted">
          Votre messagerie devrait s’ouvrir avec la demande déjà rédigée. Si rien ne s’ouvre, copiez le message et
          envoyez-le à <span class="sent__mail">{site.email}</span>.
        </p>
        <textarea class="sent__text" id="sent-text" readonly rows="9" data-sent-text aria-label="Texte de la demande"></textarea>
        <div class="sent__actions">
          <button type="button" class="btn" data-sent-copy><span data-sent-copy-label>Copier le message</span></button>
          <button type="button" class="btn btn--line" data-sent-back>Modifier</button>
        </div>
      </div>
    </div>

    <footer class="cart__foot">
      <p class="cart__total"><span class="label muted">Estimation</span> <span data-cart-total>0 €</span></p>
      <button class="btn" type="submit" form="cart-form" data-cart-send>Envoyer ma demande</button>
      <p class="cart__note label muted">Aucun paiement en ligne</p>
    </footer>
  </aside>
</div>

<button class="dock" type="button" data-cart-open data-dock aria-label="Voir ma demande">
  <span class="label">Ma demande</span>
  <span class="dock__sum"><span data-cart-count>0</span> · <span data-cart-total>0 €</span></span>
</button>

<style>
  .cart {
    position: fixed;
    inset: 0;
    z-index: 80;
    visibility: hidden;
  }
  .cart__veil {
    position: absolute;
    inset: 0;
    background: rgb(18 14 10 / 0.4);
    opacity: 0;
  }
  .cart__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100%, 500px);
    display: flex;
    flex-direction: column;
    background: var(--ivory);
  }
  .cart__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: calc(28px + env(safe-area-inset-top, 0px)) 28px 20px;
    border-bottom: 1px solid var(--line);
  }
  .cart__title {
    font-size: 2.4rem;
    font-weight: 300;
    line-height: 1;
  }
  .cart__title em {
    font-style: italic;
    color: var(--gold);
  }
  .cart__scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 28px 28px;
  }
  .cart__empty {
    display: grid;
    gap: 1.4rem;
    padding-top: 2rem;
  }
  :global(html.has-items) .cart__empty {
    display: none;
  }
  .cart__items {
    list-style: none;
  }
  .cart__items :global(li) {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .cart__items :global(.ci-img) {
    width: 44px;
    height: 60px;
    object-fit: cover;
  }
  .cart__items :global(.ci-img.is-printemps) {
    filter: brightness(1.14) saturate(0.55) sepia(0.12);
  }
  .cart__items :global(.ci-name) {
    font-size: 1.3rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
  }
  .cart__items :global(.ci-meta) {
    font-family: var(--sans);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 0.3rem;
  }
  .cart__items :global(.ci-qty) {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--sans);
    font-size: 0.8rem;
  }
  .cart__items :global(.ci-qty button) {
    width: 26px;
    height: 26px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cart__form {
    display: none;
    gap: 1.2rem;
    margin-top: 2rem;
  }
  :global(html.has-items) .cart__form {
    display: grid;
  }
  .field {
    display: grid;
    gap: 0.3rem;
    border: 0;
    min-width: 0;
  }
  .field .label,
  .field legend {
    font-size: 0.6rem;
    color: var(--ink-soft);
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.15rem;
    outline: none;
    border-radius: 0;
    transition: border-color 0.4s;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--ink);
  }
  .field textarea {
    resize: none;
  }
  .field--choice {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
  }
  .field--choice legend {
    width: 100%;
    margin-bottom: 0.5rem;
  }
  .field--choice label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .field--choice input {
    accent-color: var(--ink);
  }
  .sent {
    display: grid;
    gap: 1rem;
    padding-top: 2rem;
  }
  .sent[hidden] {
    display: none;
  }
  .sent__title {
    font-size: 2.6rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1;
  }
  .sent__mail {
    color: var(--ink);
    user-select: all;
  }
  .sent__text {
    width: 100%;
    padding: 1rem;
    background: var(--paper);
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.6;
    resize: vertical;
  }
  .sent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  :global(.cart.is-sent) .cart__form,
  :global(.cart.is-sent) .cart__items,
  :global(.cart.is-sent) .cart__foot {
    display: none !important;
  }
  .cart__foot {
    display: grid;
    gap: 0.9rem;
    padding: 20px 28px calc(20px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
  }
  :global(html:not(.has-items)) .cart__foot {
    display: none;
  }
  .cart__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 1.9rem;
    font-weight: 300;
    line-height: 1;
  }
  .cart__note {
    text-align: center;
    font-size: 0.58rem;
  }

  /* Barre « Ma demande » */
  .dock {
    position: fixed;
    z-index: 58;
    right: var(--gutter);
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 1rem 1.4rem;
    background: var(--ink);
    color: var(--ivory);
    transform: translateY(180%);
    transition: transform 0.9s var(--ease);
  }
  :global(.dock.is-on) {
    transform: translateY(0);
  }
  :global(html.cart-open) .dock,
  :global(html.menu-open) .dock {
    transform: translateY(180%);
  }
  .dock__sum {
    font-size: 1.05rem;
    font-style: italic;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .dock {
      left: var(--gutter);
      justify-content: space-between;
    }
  }
</style>

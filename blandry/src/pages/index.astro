---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Fan from '../components/Fan.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { site, services, nuancier, zones, etapes, realisations, faqGenerale, teinte } from '../data/site';
import { u } from '../lib/url';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGenerale.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
const engagements = [
  { t: 'Visite et devis gratuits', d: 'Un devis détaillé poste par poste, sans engagement.' },
  { t: 'Un interlocuteur unique', d: 'La même personne du premier échange à la livraison.' },
  { t: 'Garantie décennale', d: 'Attestation d’assurance jointe à chaque devis.' },
  { t: 'Logement protégé', d: 'Sols et mobilier protégés, chantier rangé chaque soir.' },
];
const n2 = (i: number) => String(i + 1).padStart(2, '0');
---

<Base
  title={`${site.nom} — Peintre en bâtiment, peinture et finitions intérieures | Puy-de-Dôme`}
  description="Artisan peintre à Saint-Georges-de-Mons : peinture intérieure, préparation des supports, façades et boiseries. Interventions dans les Combrailles, à Riom et à Clermont-Ferrand. Visite et devis gratuits."
  schema={[faqLd]}
>
  <!-- ─── Hero ─────────────────────────────────── -->
  <section class="hero" data-hero>
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow eyebrow--dot hero__eye" data-hero-fade>
          Artisan peintre · {site.adresse.ville} (63)
        </p>
        <h1 class="hero__t serif" data-hero-title>
          <span class="line"><span class="line-inner">Peinture</span></span>
          <span class="line"><span class="line-inner">&amp; finitions,</span></span>
          <span class="line"><span class="line-inner"><em>du sol au plafond.</em></span></span>
        </h1>
        <p class="hero__lede" data-hero-fade>
          Nous préparons, protégeons et mettons en peinture votre intérieur avec la rigueur d’un artisan.
          Un seul interlocuteur, du premier échange à la livraison du chantier.
        </p>
        <div class="hero__ctas" data-hero-fade>
          <a href="#contact" class="btn" data-magnetic>
            Demander un devis gratuit
            <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
          </a>
          <a href="#realisations" class="btn btn--ghost">Voir nos réalisations</a>
        </div>
        <ul class="hero__proof" data-hero-fade>
          <li>Devis gratuit</li>
          <li>Garantie décennale</li>
          <li>{site.delaiReponse}</li>
        </ul>
      </div>
      <div class="hero__ba" data-hero-fade>
        <BeforeAfter eager />
      </div>
    </div>
  </section>

  <!-- ─── Réalisations ─────────────────────────── -->
  <section class="works section" id="realisations" aria-labelledby="works-t">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow eyebrow--dot muted">Réalisations</p>
        <h2 id="works-t" class="serif head__t" data-split>
          Des chantiers <em>livrés avec soin.</em>
        </h2>
        <p class="head__lede muted" data-reveal="fade">
          Une sélection de travaux récents. D’autres références peuvent vous être présentées lors de la
          visite.
        </p>
      </div>
      <ul class="works__grid">
        {
          realisations.map((r, i) => (
            <li class={`work work--${i}`} data-work>
              <div class="work__media" data-work-media>
                <Image src={r.image} alt={r.alt} widths={[400, 800]} sizes="(min-width: 1024px) 45vw, 100vw" class="work__img" />
              </div>
              <div class="work__cap">
                <h3 class="work__t">{r.titre}</h3>
                {r.lieu && <p class="work__lieu muted">{r.lieu}</p>}
                <ul class="work__tags">
                  {r.travaux.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ─── Étapes ───────────────────────────────── -->
  <section class="steps section" id="etapes" aria-labelledby="steps-t" data-steps>
    <div class="wrap steps__grid">
      <div class="steps__head">
        <p class="eyebrow eyebrow--dot">Déroulement</p>
        <h2 id="steps-t" class="serif head__t" data-split>
          De votre demande <em>à la livraison du chantier.</em>
        </h2>
        <p class="steps__lede" data-reveal="fade">
          Six étapes claires, pour savoir à chaque instant où en est votre projet.
        </p>
        <a href="#contact" class="btn btn--light steps__cta" data-reveal="fade">Commencer par l’étape 1</a>
      </div>
      <div class="steps__list">
        <span class="steps__rail" aria-hidden="true"><span data-steps-line></span></span>
        <ol class="steps__ol">
        {
          etapes.map((e, i) => (
            <li class="step" data-step>
              <span class="step__dot" aria-hidden="true" />
              <div class="step__top">
                <span class="step__n serif">{n2(i)}</span>
                <span class="step__badge">{e.duree}</span>
              </div>
              <h3 class="step__t">{e.titre}</h3>
              <p class="step__p">{e.texte}</p>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </section>

  <!-- ─── Engagements ──────────────────────────── -->
  <section class="engage" aria-label="Nos engagements">
    <ul class="wrap engage__list">
      {
        engagements.map((e) => (
          <li data-reveal="fade">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5 8 14.5 16 5.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            <strong>{e.t}</strong>
            <span class="muted">{e.d}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ─── Services ─────────────────────────────── -->
  <section class="services section" id="services" aria-labelledby="services-t">
    <div class="wrap head">
      <p class="eyebrow eyebrow--dot muted">Savoir-faire</p>
      <h2 id="services-t" class="serif head__t" data-split>
        La peinture, <em>et tout ce qui la prépare.</em>
      </h2>
    </div>
    <div class="wrap stack">
      {
        services.map((s, i) => {
          const t = teinte(s.teinte);
          return (
            <article class="card" id={s.id} data-card style={`--c:${t.hex};--i:${i}`}>
              <div class="card__in">
                <span class="card__band" aria-hidden="true" />
                <div class="card__top">
                  <span>{n2(i)} / {n2(services.length - 1)}</span>
                  <span>{s.court}</span>
                </div>
                <div class="card__body">
                  <h3 class="serif card__t">{s.titre}</h3>
                  <div class="card__text">
                    <p>{s.texte}</p>
                    <ul class="card__pts">
                      {s.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- ─── Conseil couleur (secondaire) ─────────── -->
  <section class="color section" id="nuancier" data-nuancier aria-labelledby="color-t">
    <div class="wrap color__grid">
      <div class="color__fan" aria-hidden="true">
        <Fan />
      </div>
      <div class="color__body">
        <p class="eyebrow eyebrow--dot">Conseil couleur</p>
        <h2 id="color-t" class="serif color__t" data-split>
          Choisir la teinte <em>dans la lumière de la pièce.</em>
        </h2>
        <p class="color__p">
          Nous apportons de vrais échantillons et les posons chez vous. Voici quelques teintes de
          référence, inspirées des matériaux de la région.
        </p>
        <p class="color__name serif" data-nu-name aria-live="polite">{nuancier[1].nom}</p>
        <p class="color__meta"><span data-nu-lieu>{nuancier[1].lieu}</span> · <span data-nu-hex>{nuancier[1].hex}</span></p>
        <div class="color__row" role="radiogroup" aria-label="Choisir une teinte">
          {
            nuancier.map((t, i) => (
              <button
                class="nu"
                role="radio"
                aria-checked={i === 1 ? 'true' : 'false'}
                aria-label={t.nom}
                data-nu
                data-hex={t.hex}
                data-ink={t.ink}
                data-nom={t.nom}
                data-lieu={t.lieu}
                style={`--c:${t.hex}`}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Zone d'intervention ──────────────────── -->
  <section class="zones section" id="secteurs" aria-labelledby="zones-t">
    <div class="wrap zones__grid">
      <div>
        <p class="eyebrow eyebrow--dot muted">Zone d’intervention</p>
        <h2 id="zones-t" class="serif head__t" data-split>Où nous <em>intervenons.</em></h2>
        <p class="head__lede muted" data-reveal="fade">
          Installés à {site.adresse.ville}, nous intervenons dans un rayon d’environ quarante
          kilomètres. Le déplacement pour la visite est gratuit.
        </p>
      </div>
      <ul class="zlist">
        {
          zones.map((z) => (
            <li style={`--c:${teinte(z.teinte).hex}`} data-reveal="fade">
              <a href={u(`/${z.slug}/`)} class="zrow">
                <span class="zrow__name serif">{z.nom}</span>
                <span class="zrow__court muted">{z.court}</span>
                <svg class="zrow__go" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq items={faqGenerale} />
  <Contact />
</Base>

<style>
  .head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .head__t {
    font-size: var(--fs-xl);
    max-width: 16ch;
    text-wrap: balance;
  }
  .head__lede {
    max-width: 46ch;
  }

  /* Hero */
  .hero {
    padding-top: calc(100px + env(safe-area-inset-top));
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .hero__grid {
    display: grid;
    gap: 40px;
  }
  .hero__text {
    display: grid;
    gap: 24px;
    align-content: center;
  }
  .hero__eye {
    color: var(--muted);
  }
  .hero__t {
    font-size: clamp(3rem, 12vw, 8.4rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }
  .hero__t em {
    color: var(--tuile);
  }
  .hero__lede {
    max-width: 44ch;
    font-size: 1.08rem;
    color: var(--muted);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: var(--fs-s);
    color: var(--muted);
  }
  .hero__proof li::before {
    content: '✓';
    margin-right: 6px;
    color: var(--sioule);
    font-weight: 700;
  }
  @media (min-width: 1024px) {
    .hero {
      min-height: 100svh;
      display: flex;
      align-items: center;
    }
    .hero__grid {
      grid-template-columns: 1.25fr 1fr;
      gap: clamp(40px, 6vw, 96px);
      align-items: center;
    }
    .hero__t {
      font-size: min(6.4vw, 7.6rem);
    }
    .hero__ba {
      max-width: 520px;
      justify-self: end;
      width: 100%;
    }
  }

  /* Réalisations */
  .works__grid {
    display: grid;
    gap: 40px 24px;
  }
  .work {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .work__media {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--chaux-2);
    aspect-ratio: 4 / 5;
    max-width: 100%;
  }
  .work--2 .work__media {
    aspect-ratio: 16 / 9;
  }
  .work__media :global(.work__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  @media (hover: hover) {
    .work:hover :global(.work__img) {
      transform: scale(1.04);
    }
  }
  .work__cap {
    display: grid;
    gap: 8px;
  }
  .work__t {
    font-size: var(--fs-m);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .work__lieu {
    font-size: var(--fs-s);
  }
  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .work__tags li {
    font-size: var(--fs-xs);
    padding: 5px 10px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (min-width: 800px) {
    .works__grid {
      grid-template-columns: repeat(12, 1fr);
    }
    .work--0 {
      grid-column: 1 / 7;
    }
    .work--1 {
      grid-column: 8 / -1;
      margin-top: 18vw;
    }
    .work--2 {
      grid-column: 3 / 11;
    }
  }

  /* Étapes */
  .steps {
    background: var(--ink);
    color: var(--chaux);
    --line: rgb(255 255 255 / 0.14);
    --muted: rgb(255 255 255 / 0.62);
  }
  .steps__grid {
    display: grid;
    gap: 48px;
  }
  .steps__head {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .steps__head .head__t em {
    color: var(--limagne);
  }
  .steps__lede {
    color: var(--muted);
    max-width: 36ch;
  }
  .steps__cta {
    justify-self: start;
    --b-bg: var(--chaux);
    --b-fg: var(--ink);
  }
  .steps__list {
    position: relative;
    padding-left: 36px;
  }
  .steps__ol {
    display: grid;
    gap: 44px;
  }
  .steps__rail {
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--line);
  }
  .steps__rail span {
    position: absolute;
    inset: 0;
    background: var(--limagne);
    transform-origin: 0 0;
    transform: scaleY(var(--p, 1));
  }
  .step {
    position: relative;
    display: grid;
    gap: 10px;
  }
  .step__dot {
    position: absolute;
    left: -36px;
    top: 10px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    transition: background 0.5s, box-shadow 0.5s;
  }
  .step.is-on .step__dot {
    background: var(--limagne);
    box-shadow: 0 0 0 5px rgb(192 138 62 / 0.22);
  }
  .step__top {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .step__n {
    font-size: 2.2rem;
    line-height: 1;
    font-style: italic;
    color: var(--limagne);
  }
  .step__badge {
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted);
  }
  .step__t {
    font-size: var(--fs-m);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .step__p {
    color: var(--muted);
    max-width: 52ch;
  }
  .js .step {
    opacity: 0.4;
    transition: opacity 0.6s;
  }
  .js .step.is-on {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .step {
      opacity: 1;
    }
  }
  @media (min-width: 1024px) {
    .steps__grid {
      grid-template-columns: 5fr 7fr;
      gap: 80px;
    }
    .steps__head {
      position: sticky;
      top: 120px;
      align-self: start;
    }
    .steps__ol {
      gap: 64px;
    }
  }

  /* Engagements */
  .engage {
    padding-block: clamp(48px, 7vw, 88px);
    border-bottom: 1px solid var(--line);
  }
  .engage__list {
    display: grid;
    gap: 28px;
  }
  .engage__list li {
    display: grid;
    gap: 6px;
    font-size: var(--fs-s);
  }
  .engage__list svg {
    width: 22px;
    height: 22px;
    color: var(--sioule);
    margin-bottom: 4px;
  }
  .engage__list strong {
    font-size: 1.05rem;
    font-weight: 550;
  }
  @media (min-width: 700px) {
    .engage__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .engage__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Services : cartes empilées sobres */
  .stack {
    display: grid;
    gap: 16px;
  }
  .card {
    position: sticky;
    top: calc(90px + var(--i) * 10px);
    scroll-margin-top: 90px;
  }
  .card__in {
    position: relative;
    overflow: hidden;
    background: #f7f4ee;
    border-radius: calc(var(--radius) * 1.5);
    padding: clamp(24px, 4vw, 56px);
    padding-top: clamp(36px, 5vw, 64px);
    min-height: min(520px, calc(100svh - 140px));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 36px;
    transform-origin: 50% 0;
    box-shadow:
      0 0 0 1px var(--line),
      0 -24px 60px -36px rgb(31 29 26 / 0.35);
    will-change: transform;
  }
  .card__band {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 8px;
    background: var(--c);
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card__body {
    display: grid;
    gap: 24px;
  }
  .card__t {
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .card__text {
    display: grid;
    gap: 18px;
    max-width: 50ch;
    color: var(--muted);
  }
  .card__pts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .card__pts li {
    font-size: var(--fs-s);
    color: var(--fg);
    padding: 7px 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (min-width: 1024px) {
    .card__body {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
    }
  }

  /* Conseil couleur */
  .color {
    --nu: #56595c;
    --nu-ink: #f3efe7;
    background: var(--nu);
    color: var(--nu-ink);
    transition: background-color 0.9s var(--ease), color 0.9s var(--ease);
    overflow: hidden;
  }
  .color__grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .color__fan {
    display: grid;
    place-items: center;
    padding-top: 20px;
  }
  .color__fan :global(.fan) {
    --w: clamp(48px, 10vw, 76px);
    --h: clamp(210px, 44vw, 340px);
  }
  .color__body {
    display: grid;
    gap: 18px;
  }
  .color__t {
    font-size: var(--fs-l);
    max-width: 18ch;
  }
  .color__p {
    max-width: 44ch;
    opacity: 0.8;
  }
  .color__name {
    margin-top: 12px;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
    font-style: italic;
  }
  .color__meta {
    font-size: var(--fs-s);
    opacity: 0.75;
  }
  .color__row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }
  .nu {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 1.5px color-mix(in srgb, currentColor 40%, transparent);
    transition: box-shadow 0.3s, transform 0.3s var(--ease-out);
  }
  .nu[aria-checked='true'] {
    box-shadow:
      0 0 0 3px var(--nu),
      0 0 0 5px currentColor;
    transform: scale(1.06);
  }
  @media (min-width: 1024px) {
    .color__grid {
      grid-template-columns: 1fr 1.2fr;
      gap: 80px;
    }
  }

  /* Zone d'intervention */
  .zones__grid {
    display: grid;
    gap: 40px;
  }
  .zlist {
    border-top: 1px solid var(--line);
    align-self: end;
  }
  .zrow {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease);
  }
  .zrow__name {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.05;
  }
  .zrow__name::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 14px;
    border-radius: 50%;
    background: var(--c);
    vertical-align: 0.3em;
  }
  .zrow__court {
    grid-column: 1;
    font-size: var(--fs-s);
    margin-top: 4px;
  }
  .zrow__go {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 18px;
    transition: transform 0.5s var(--ease);
  }
  @media (hover: hover) {

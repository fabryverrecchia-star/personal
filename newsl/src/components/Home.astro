---
import { asset, dicts, langPath, LANGS, type Lang } from '../i18n';
import { site } from '../site';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dicts[lang];
const photo = (name: string) => asset(`media/photos/${name}.webp`);
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const brands = ['chanel', 'dior', 'louis-vuitton', 'cartier', 'messika', 'balmain', 'guerlain', 'dolce-gabbana', 'mac'];
const brandNames: Record<string, string> = {
  chanel: 'Chanel',
  dior: 'Dior',
  'louis-vuitton': 'Louis Vuitton',
  cartier: 'Cartier',
  messika: 'Messika',
  balmain: 'Balmain',
  guerlain: 'Guerlain',
  'dolce-gabbana': 'Dolce & Gabbana',
  mac: 'MAC',
};
// Dimensions réelles des logos : la bande garde sa largeur même avant chargement
const logoSize: Record<string, [number, number]> = {
  chanel: [336, 216],
  dior: [518, 145],
  'louis-vuitton': [186, 225],
  cartier: [449, 129],
  messika: [512, 169],
  balmain: [448, 123],
  guerlain: [502, 70],
  'dolce-gabbana': [268, 132],
  mac: [493, 66],
};
const year = new Date().getFullYear();
---

<canvas id="gl" aria-hidden="true"></canvas>

<div class="cursor" aria-hidden="true">
  <div class="cursor__ring"><span class="cursor__label"></span></div>
  <div class="cursor__dot"></div>
</div>

<!-- Entrée : le logo s'écrit, puis le rideau s'ouvre -->
<div class="loader is-dark" data-loader aria-hidden="true">
  <div class="loader__curtain loader__curtain--a"></div>
  <div class="loader__curtain loader__curtain--b"></div>
  <div class="loader__logo" data-loader-logo><Logo animated /></div>
  <p class="loader__count label" dir="ltr"><span data-count>000</span></p>
</div>

<!-- En-tête -->
<header class="header">
  <a href={langPath(lang)} class="header__logo" aria-label="Soundslike" data-header-logo>
    <Logo />
  </a>
  <nav class="header__nav" aria-label="Navigation">
    <a href="#experiences" class="label" data-link>{t.nav.experiences}</a>
    <a href="#casting" class="label" data-link>{t.nav.casting}</a>
    <a href="#maison" class="label" data-link>{t.nav.maison}</a>
  </nav>
  <div class="header__tools">
    <div class="langs" role="list">
      {
        LANGS.map((l) => (
          <a
            role="listitem"
            href={langPath(l)}
            hreflang={l}
            lang={l}
            class:list={['langs__item label', { 'is-active': l === lang }]}
            aria-current={l === lang ? 'page' : undefined}
            title={dicts[l].langName}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </div>
    <button class="sound" data-sound aria-pressed="false" aria-label={t.sound.off} data-on={t.sound.on} data-off={t.sound.off}>
      <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="sound__label label" aria-hidden="true">{t.sound.label}</span>
    </button>
    <a href="#contact" class="btn header__cta" data-link><span class="label">{t.nav.contact}</span></a>
    <button class="burger" data-burger aria-expanded="false" aria-controls="menu">
      <span class="sr-only">{t.nav.menu}</span><i></i><i></i>
    </button>
  </div>
</header>

<div class="menu is-dark" id="menu" data-menu aria-hidden="true">
  <nav class="menu__nav">
    <a href="#experiences" data-link><span class="label label--gold">I</span>{t.nav.experiences}</a>
    <a href="#casting" data-link><span class="label label--gold">II</span>{t.nav.casting}</a>
    <a href="#maison" data-link><span class="label label--gold">III</span>{t.nav.maison}</a>
    <a href="#contact" data-link><span class="label label--gold">IV</span>{t.nav.contact}</a>
  </nav>
  <div class="menu__foot">
    <div class="langs">
      {
        LANGS.map((l) => (
          <a href={langPath(l)} hreflang={l} lang={l} class:list={['langs__item label', { 'is-active': l === lang }]}>
            {dicts[l].langName}
          </a>
        ))
      }
    </div>
    <a href={`tel:${site.phoneHref}`} class="label" dir="ltr">{site.phone}</a>
  </div>
</div>

<main>
  <!-- Ouverture -->
  <section class="hero is-dark" data-hero>
    <video
      class="hero__video"
      data-gl="video"
      data-video
      poster={asset('media/soiree-poster.webp')}
      muted
      loop
      playsinline
      preload="auto"
      crossorigin="anonymous"
      aria-hidden="true">
      <source src={asset('media/soiree.webm')} type="video/webm" />
      <source src={asset('media/soiree.mp4')} type="video/mp4" />
    </video>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__inner">
      <p class="hero__eyebrow label" data-hero-item>{t.hero.eyebrow}</p>
      <h1 class="hero__title" lang="en" dir="ltr">
        <span class="sr-only">Soundslike — </span>
        <span class="line-mask hero__l1"><span data-hero-line>Sounds</span></span>
        <span class="line-mask hero__l2"><span data-hero-line><em>like</em> you.</span></span>
      </h1>
      <div class="hero__foot">
        <p class="hero__sub" data-hero-item>{t.hero.sub}</p>
        <a href="#manifeste" class="hero__scroll label" data-link data-hero-item>
          <span>{t.hero.scroll}</span><i aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Manifeste -->
  <section class="manifesto" id="manifeste" data-tone="ivory">
    <p class="label label--gold manifesto__label" data-reveal="fade">{t.manifesto.label}</p>
    <p class="manifesto__text" data-words>{t.manifesto.text}</p>
    <ul class="manifesto__words" role="list">
      {t.manifesto.words.map((w, i) => (
        <li data-reveal="fade" style={`--i:${i}`}>
          <span class="label label--gold">{roman[i]}</span>
          <span class="serif">{w}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Expériences : défilement horizontal -->
  <section class="experiences" id="experiences" data-tone="bordeaux" data-hscroll>
    <div class="experiences__pin" data-hscroll-pin>
      <div class="experiences__track" data-hscroll-track>
        <div class="experiences__intro">
          <p class="label label--gold">{t.experiences.label}</p>
          <h2 class="h2" data-split>{t.experiences.title}</h2>
          <p class="lead" data-reveal="fade">{t.experiences.intro}</p>
          <p class="experiences__hint label" aria-hidden="true">
            <span>{t.experiences.drag}</span><i></i>
          </p>
        </div>
        {
          t.experiences.items.map((item, i) => (
            <article class="exp">
              <div class="exp__media">
                {item.video ? (
                  <video data-gl="media" data-inline-video muted loop playsinline preload="metadata" poster={asset(`media/${item.video}-poster.webp`)} aria-hidden="true">
                    <source src={asset(`media/${item.video}.webm`)} type="video/webm" />
                    <source src={asset(`media/${item.video}.mp4`)} type="video/mp4" />
                  </video>
                ) : (
                  <img data-gl="media" src={photo(item.image)} alt="" loading="lazy" decoding="async" />
                )}
              </div>
              <div class="exp__body">
                <p class="exp__num label label--gold">
                  {String(i + 1).padStart(2, '0')} / {String(t.experiences.items.length).padStart(2, '0')}
                </p>
                <h3 class="exp__title serif">{item.title}</h3>
                <p class="exp__where label">{item.where}</p>
                <p class="exp__text">{item.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Casting -->
  <section class="casting" id="casting" data-tone="ivory">
    <div class="section-head casting__head">
      <p class="label label--gold" data-reveal="fade">{t.casting.label}</p>
      <h2 class="h2" data-split>{t.casting.title}</h2>
      <p class="lead" data-reveal="fade">{t.casting.intro}</p>
    </div>
    <ol class="acts" role="list" data-acts>
      {
        t.casting.acts.map((act, i) => (
          <li class="act" data-act={i} data-image={photo(act.image)}>
            <span class="act__num label">{String(i + 1).padStart(2, '0')}</span>
            <span class="act__title serif">{act.title}</span>
            <img class="act__img" src={photo(act.image)} alt="" loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ol>
    <div class="acts-preview" aria-hidden="true" data-acts-preview>
      {t.casting.acts.map((act) => <img data-gl="cursor" src={photo(act.image)} alt="" loading="lazy" decoding="async" />)}
    </div>
  </section>

  <!-- La Maison : lieux et marques -->
  <section class="maison" id="maison" data-tone="gold">
    <div class="maison__top">
      <div class="section-head">
        <p class="label label--gold" data-reveal="fade">{t.venues.label}</p>
        <h2 class="h2" data-split>{t.venues.title}</h2>
        <p class="lead" data-reveal="fade">{t.venues.intro}</p>
      </div>
      <div class="maison__visuals">
        <figure class="maison__fig maison__fig--a" data-parallax="-0.12">
          <img data-gl="media" src={photo('salon-palace')} alt="" loading="lazy" decoding="async" />
        </figure>
        <figure class="maison__fig maison__fig--b" data-parallax="0.1">
          <img data-gl="media" src={photo('jazz-salle-doree')} alt="" loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>

    <ul class="venues" role="list">
      {
        t.venues.items.map((v) => (
          <li class="venue" data-reveal="line">
            <span class="venue__name serif" lang="fr" dir="auto">{v.name}</span>
            <span class="venue__mood label label--gold">{v.mood}</span>
            <span class="venue__line">{v.line}</span>
          </li>
        ))
      }
    </ul>

    <div class="brands">
      <p class="label brands__title" data-reveal="fade">{t.venues.brands}</p>
      <div class="marquee" data-marquee dir="ltr">
        {
          [0, 1].map((k) => (
            <div class="marquee__row" aria-hidden={k === 1 ? 'true' : undefined}>
              {brands.map((b) => (
                <img src={asset(`media/logos/${b}.png`)} alt={k === 0 ? brandNames[b] : ''} width={logoSize[b][0]} height={logoSize[b][1]} decoding="async" class={`brand brand--${b}`} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Méthode -->
  <section class="method" data-tone="ivory">
    <div class="method__head">
      <p class="label label--gold" data-reveal="fade">{t.method.label}</p>
      <h2 class="h2" data-split>{t.method.title}</h2>
    </div>
    <ol class="steps" role="list">
      {
        t.method.steps.map((s, i) => (
          <li class="step" data-reveal="line">
            <span class="step__num serif">{roman[i]}</span>
            <div>
              <h3 class="step__title label">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact" data-tone="forest">
    <div class="contact__grid">
      <div class="contact__aside">
        <p class="label label--gold" data-reveal="fade">{t.contact.label}</p>
        <h2 class="h2" data-split>{t.contact.title}</h2>
        <p class="lead" data-reveal="fade">{t.contact.intro}</p>
        <div class="contact__direct" data-reveal="fade">
          <p class="label">{t.contact.direct}</p>
          <a href={`tel:${site.phoneHref}`} dir="ltr" class="serif">{site.phone}</a>
          <a href={`mailto:${site.email}`} class="serif">{site.email}</a>
        </div>
      </div>

      <form class="form" data-form data-email={site.email} data-sent={t.contact.sent} novalidate>
        <div class="field">
          <input id="f-name" name="name" type="text" autocomplete="name" required placeholder=" " />
          <label for="f-name" class="label">{t.contact.fields.name}</label>
        </div>
        <div class="field">
          <input id="f-email" name="email" type="email" autocomplete="email" required placeholder=" " dir="ltr" />
          <label for="f-email" class="label">{t.contact.fields.email}</label>
        </div>
        <div class="field">
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder=" " dir="ltr" />
          <label for="f-phone" class="label">{t.contact.fields.phone}</label>
        </div>
        <div class="field">
          <input id="f-date" name="date" type="text" placeholder=" " />
          <label for="f-date" class="label">{t.contact.fields.date}</label>
        </div>
        <div class="field">
          <input id="f-place" name="place" type="text" placeholder=" " />
          <label for="f-place" class="label">{t.contact.fields.place}</label>
        </div>
        <div class="field">
          <input id="f-guests" name="guests" type="text" inputmode="numeric" placeholder=" " />
          <label for="f-guests" class="label">{t.contact.fields.guests}</label>
        </div>
        <fieldset class="field field--choices">
          <legend class="label">{t.contact.fields.occasion}</legend>
          <div class="chips">
            {
              t.contact.occasions.map((o, i) => (
                <label class="chip">
                  <input type="radio" name="occasion" value={o} checked={i === 0} />
                  <span>{o}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="field field--full">
          <textarea id="f-msg" name="message" rows="4" placeholder=" "></textarea>
          <label for="f-msg" class="label">{t.contact.fields.message}</label>
        </div>
        <div class="form__foot">
          <button type="submit" class="btn btn--solid" data-magnetic>
            <span class="label">{t.contact.submit}</span>
            <svg width="18" height="10" viewBox="0 0 18 10" aria-hidden="true" class="arrow"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" /></svg>
          </button>
          <p class="form__note">{t.contact.note}</p>
          <p class="form__status label label--gold" role="status" data-status></p>
        </div>
      </form>
    </div>
  </section>
</main>

<footer class="site-footer" data-tone="night">
  <div class="footer__top">
    <p class="footer__tagline serif" lang="en" dir="ltr" data-reveal="fade">Sounds <em>like</em> you.</p>
    <a href="#contact" class="btn" data-link data-magnetic><span class="label">{t.nav.contact}</span></a>
  </div>
  <div class="footer__cols">
    <div class="footer__brand">
      <a href={langPath(lang)} class="footer__logo" aria-label="Soundslike"><Logo /></a>
      <p class="label">{t.hero.eyebrow}</p>
    </div>
    <nav class="footer__col" aria-label={t.nav.menu}>
      <a href="#experiences" data-link>{t.nav.experiences}</a>
      <a href="#casting" data-link>{t.nav.casting}</a>
      <a href="#maison" data-link>{t.nav.maison}</a>
      <a href="#contact" data-link>{t.nav.contact}</a>
    </nav>
    <div class="footer__col">
      <p class="label">{t.contact.direct}</p>
      <a href={`tel:${site.phoneHref}`} dir="ltr">{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div class="footer__col">
      <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
  <div class="footer__bottom">
    <p class="label">© {year} Soundslike — {t.footer.rights}</p>
    <div class="langs">
      {LANGS.map((l) => (
        <a href={langPath(l)} hreflang={l} lang={l} class:list={['langs__item label', { 'is-active': l === lang }]}>{l.toUpperCase()}</a>
      ))}
    </div>
    <p class="label">
      {t.footer.credits} — <a href={site.credits.url} target="_blank" rel="noopener" class="label--gold">{site.credits.name}</a>
    </p>
  </div>
</footer>

<script>
  import '../scripts/app';
</script>

---
import { site, zones, services, telHref, instagram } from '../data/site';
import { u } from '../lib/url';
import Logo from './Logo.astro';
const annee = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="wrap">
    <div class="footer__brand">
      <p class="display footer__name" aria-hidden="true">{site.nom}</p>
      <p class="script footer__sign" aria-hidden="true">peinture &amp; finitions</p>
    </div>

    <div class="footer__cols">
      <div>
        <p class="label muted">L’atelier</p>
        <p>
          {site.metier}<br />
          {site.adresse.rue && <>{site.adresse.rue}<br /></>}
          {site.adresse.codePostal} {site.adresse.ville}<br />
          {site.adresse.departement}
        </p>
      </div>
      <div>
        <p class="label muted">Contact</p>
        <a href={telHref} class="link-u">{site.telephone}</a>
        <a href={`mailto:${site.email}`} class="link-u">{site.email}</a>
        <p class="label muted footer__h">Suivez-nous</p>
        <a href={instagram.url} class="link-u" target="_blank" rel="noopener me">Instagram · {instagram.compte}</a>
      </div>
      <div>
        <p class="label muted">Savoir-faire</p>
        {services.map((s) => <a href={u('/#savoir-faire')} class="link-u">{s.titre}</a>)}
      </div>
      <div>
        <p class="label muted">Zone d’intervention</p>
        {zones.map((z) => <a href={u(`/${z.slug}/`)} class="link-u">Peintre {z.dans}</a>)}
        <p class="muted">Chantiers {site.zoneIntervention}</p>
        <p class="label muted footer__h">Horaires</p>
        <p>{site.horaires}</p>
      </div>
    </div>

    <div class="footer__bottom label">
      <span>© {annee} {site.nom}{site.siret && <> · SIRET {site.siret}</>} · {site.assurance}</span>
      <Logo class="footer__mono" />
      <a href={u('/mentions-legales/')} class="link-u">Mentions légales</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(80px, 12vw, 160px);
    padding-bottom: calc(90px + env(safe-area-inset-bottom));
  }
  @media (min-width: 1100px) {
    .footer {
      padding-bottom: 28px;
    }
  }
  .footer__brand {
    text-align: center;
    position: relative;
  }
  .footer__name {
    font-size: clamp(3rem, 11.5vw, 11rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
  }
  .footer__sign {
    margin-top: -0.35em;
    font-size: clamp(2rem, 6vw, 4.6rem);
    color: var(--argile);
    line-height: 1;
  }
  .footer__cols {
    display: grid;
    gap: 36px;
    margin-top: clamp(64px, 9vw, 120px);
    padding-top: 36px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-s);
  }
  .footer__cols > div {
    display: grid;
    gap: 6px;
    align-content: start;
    justify-items: start;
  }
  .footer__cols .label {
    margin-bottom: 8px;
  }
  .footer__h {
    margin-top: 18px;
  }
  @media (min-width: 700px) {
    .footer__cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .footer__cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .footer__bottom {
    display: grid;
    gap: 14px;
    justify-items: start;
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .footer__bottom :global(.footer__mono) {
    font-size: 2.4rem;
    color: var(--lin);
  }
  @media (min-width: 900px) {
    .footer__bottom {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
    .footer__bottom > :last-child {
      justify-self: end;
    }
  }
</style>

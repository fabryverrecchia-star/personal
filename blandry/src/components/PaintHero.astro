---
import { Image } from 'astro:assets';
import { comparaisons, site } from '../data/site';
import { u } from '../lib/url';
const c = comparaisons[0];
---

<section class="phero" data-phero data-dark-hero aria-labelledby="phero-t">
  <div class="phero__media" aria-hidden="true">
    <Image src={c.apres.src} alt="" widths={[720, 1080]} sizes="100vw" loading="eager" class="phero__img phero__img--after" data-paint-after />
    <Image src={c.avant.src} alt="" widths={[720, 1080]} sizes="100vw" loading="eager" class="phero__img phero__img--before" data-paint-before />
    <canvas class="phero__canvas" data-paint></canvas>
  </div>

  <div class="phero__ui wrap">
    <div class="phero__top label" data-hero-fade>
      <span>(Avant) {c.titre}</span>
      <span class="phero__hint">Peignez l’écran pour révéler l’après</span>
    </div>

    <h1 id="phero-t" class="phero__t">
      <span class="phero__kicker label" data-hero-fade>Peintre en bâtiment · Puy-de-Dôme</span>
      <span class="display phero__big" data-hero-title>
        <span class="line"><span class="line-inner">Peindre</span></span>
        <span class="line"><span class="line-inner">juste<em>.</em></span></span>
      </span>
    </h1>

    <div class="phero__foot" data-hero-fade>
      <p class="phero__lede">
        Peinture et finitions intérieures, du sol au plafond. Un artisan, un interlocuteur, de la demande de
        devis à la livraison du chantier.
      </p>
      <div class="phero__actions">
        <div class="phero__meter label" aria-hidden="true">
          <span>Repeint</span>
          <span class="phero__pct display" data-paint-pct>0</span><span>%</span>
        </div>
        <button class="btn btn--line phero__all" data-paint-all type="button">Tout repeindre</button>
        <a href={u('/#contact')} class="btn btn--wine" data-magnetic>
          Devis gratuit
          <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
        </a>
      </div>
    </div>
  </div>
  <p class="sr-only">{site.nom} : {c.titre}. {c.texte}</p>
</section>

<style>
  .phero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--noir);
    color: var(--craie);
    touch-action: pan-y;
  }
  .phero__media,
  .phero__canvas,
  .phero__media :global(.phero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .phero__media :global(.phero__img) {
    object-fit: cover;
  }
  /* Sans JS : on montre l'après. Avec JS : le canvas prend le relais. */
  .phero__media :global(.phero__img--before) {
    display: none;
  }
  :global(.js) .phero__media :global(.phero__img) {
    visibility: hidden;
  }
  :global(.js) .phero.no-canvas .phero__media :global(.phero__img--after) {
    visibility: visible;
  }
  .phero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(14 13 12 / 0.55), transparent 22%),
      linear-gradient(to top, rgb(14 13 12 / 0.85), rgb(14 13 12 / 0.2) 55%, transparent 75%);
  }
  .phero__ui {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(92px + env(safe-area-inset-top));
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
    pointer-events: none;
  }
  .phero__ui a,
  .phero__ui button {
    pointer-events: auto;
  }
  .phero__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    opacity: 0.85;
  }
  .phero__hint {
    display: none;
  }
  .phero__t {
    display: grid;
    gap: 14px;
    margin-top: auto;
  }
  .phero__kicker {
    opacity: 0.85;
  }
  .phero__big {
    font-size: min(31vw, 30svh);
    line-height: 0.8;
  }
  .phero__big em {
    color: var(--bordeaux-vif);
  }
  .phero__foot {
    display: grid;
    gap: 20px;
    margin-top: 22px;
  }
  .phero__lede {
    max-width: 40ch;
    opacity: 0.85;
    font-size: 0.98rem;
  }
  .phero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .phero__meter {
    display: none;
    align-items: baseline;
    gap: 6px;
    margin-right: 12px;
  }
  .phero__pct {
    font-size: 2.6rem;
    font-variant-numeric: tabular-nums;
    min-width: 2ch;
    text-align: right;
  }
  .phero__all {
    --b-fg: var(--craie);
  }
  @media (min-width: 900px) {
    .phero__hint,
    .phero__meter {
      display: inline-flex;
    }
    .phero__foot {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>

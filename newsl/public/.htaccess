# Soundslike — cache
# Les pages HTML sont toujours revalidées (pour voir chaque mise à jour tout de suite).
# Les fichiers de assets/ ont un nom unique à chaque version : cache long.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

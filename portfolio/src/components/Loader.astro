---
import { site } from '../site.config';
---

<div class="loader" data-loader transition:persist="loader" aria-hidden="true">
  <div class="loader__inner container">
    <span class="loader__name">{site.name}</span>
    <span class="loader__count"><span data-loader-count>0</span></span>
  </div>
</div>

<style>
  .loader {
    display: none;
  }
  @media (scripting: enabled) {
    .loader {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 100;
      background: var(--bg);
    }
  }
  .loader.is-done {
    display: none;
  }
  .loader__inner {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: var(--margin);
  }
  .loader__name {
    font-size: var(--fs-sm);
  }
  .loader__count {
    font-size: var(--fs-xxl);
    line-height: 0.8;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
  }
</style>

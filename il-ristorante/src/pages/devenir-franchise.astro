---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import Sticker from '../components/Sticker.astro';
import Stats from '../components/Stats.astro';
import Rows from '../components/Rows.astro';
import Arrow from '../components/Arrow.astro';
import { pillars, conditions, contact, brochure } from '../data/site';

const support = [
  {
    title: 'Avant l’ouverture',
    script: 'pas à pas',
    items: [
      'Recherche d’un emplacement',
      'Remise d’un manuel architectural et opérationnel pour appliquer le concept',
      'Accompagnement de chantier',
      'Formation théorique et opérationnelle de 8 semaines minimum pour vous, votre directeur et votre chef',
      'Une équipe d’experts à vos côtés pendant 10 jours à l’ouverture',
    ],
  },
  {
    title: 'Une formation',
    script: 'sur-mesure',
    items: [
      'Franchisé ou directeur : 8 semaines minimum, dont 6 en succursale et 2 chez nos partenaires franchisés',
      'Chef : 8 semaines, dont 6 en succursale et 2 chez nos partenaires franchisés',
      'Un parcours adapté à votre connaissance du métier',
      'Formation continue pendant tout le contrat : nouvelles recettes, nouvelles techniques, innovations',
    ],
  },
  {
    title: 'Au quotidien',
    script: 'ensemble',
    items: [
      'Des outils de gestion mis à votre disposition',
      'Un animateur de franchise dédié pour piloter et animer votre restaurant',
      'Les services support : marketing local, réseaux sociaux, technique culinaire, approvisionnements',
      'Participation aux commissions avec le franchiseur et réunions franchisés',
    ],
  },
];

const cities = ['Lyon', 'Bordeaux', 'Nantes', 'Lille', 'Montpellier', 'Rennes', 'Toulouse', 'Strasbourg', 'chez vous'];
---
<Base title="Devenir franchisé" label="Devenir franchisé" description="Ouvrez votre restaurant Il Ristorante : chiffres clés 2025, conditions d’implantation, accompagnement et formation. Brochure franchise 2026.">
  <PageHero image="/img/logo-wall.webp" alt="Le mur en marbre d’un restaurant Il Ristorante et son logo calligraphié" crumbs={[{ label: 'Devenir franchisé', href: '/devenir-franchise' }]} eyebrow="Brochure 2026">
    <Fragment slot="title">Ouvrez votre<br />Ristorante, <span class="script">avec nous</span></Fragment>
    <Fragment slot="lead">En ouvrant un restaurant Il Ristorante, vous ne ferez pas que cuisiner. Vous partagerez un héritage : celui de la cucina italiana, telle qu’on la vit depuis 2006.</Fragment>
    <Sticker shape="stickers-06" style="right:calc(var(--gutter) + 5vw);top:20vh" spin>8<small>restaurants en franchise</small></Sticker>
  </PageHero>

  <section class="section wrap t-dolce">
    <div class="sec-head"><span class="eyebrow">Il Ristorante</span><span class="idx">I.</span></div>
    <div class="grid intro-grid">
      <p class="big" data-split>L’ambassadeur de l’Italie <em>chic, authentique et gourmande.</em></p>
      <div class="side body-text" data-reveal>
        <p>Notre promesse : un moment agréable et soigné, à table, qui rend accessible l’excellence de la cuisine italienne.</p>
        <p>Pour la tenir, on s’entoure de talents formidables et on choisit des produits d’excellence. C’est ce que vous reprenez avec l’enseigne.</p>
      </div>
    </div>
  </section>

  <section class="section wrap t-giardino">
    <div class="sec-head"><span class="eyebrow">Chiffres clés 2025</span><span class="idx">II.</span></div>
    <h2 class="display h-xxl" style="margin-bottom:clamp(40px,6vw,90px)" data-split>Une réussite qui parle <span class="script">d’elle-même</span></h2>
    <Stats />
  </section>

  <section class="section wrap t-dolce">
    <div class="sec-head"><span class="eyebrow">Nos 4 piliers</span><span class="idx">III.</span></div>
    <Rows rows={pillars.map((p) => ({ n: p.n, title: p.title, text: p.text, img: p.img }))} />
  </section>

  <section class="section wrap t-dolce" style="padding-top:0">
    <div class="split">
      <Media src="/img/chef-2.webp" alt="Un chef Il Ristorante prépare des champignons en cuisine" />
      <div class="txt">
        <p class="eyebrow">Notre engagement</p>
        <h2 class="display h-xl" data-split>Noi cuciniamo, <span class="script">nous cuisinons</span></h2>
        <ul class="body-text" style="display:grid;gap:1rem" data-reveal>
          <li>— Un sourcing direct auprès des producteurs italiens.</li>
          <li>— Une cuisine faite maison, avec des chefs de cuisine et des brigades.</li>
          <li>— Des appellations d’origine protégées : Prosciutto di Parma, Parmigiano Reggiano, Gorgonzola, Mozzarella di Bufala…</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap t-chianti" style="overflow:hidden">
    <div class="sec-head"><span class="eyebrow">La franchise</span><span class="idx">IV.</span></div>
    <div class="grid intro-grid" style="margin-bottom:clamp(40px,6vw,90px)">
      <h2 class="display h-xxl" style="grid-column:1/span 8" data-split>Les conditions <span class="script">d’implantation</span></h2>
      <p class="side lead" style="align-self:end" data-reveal>Agglomérations à partir de 70&#8239;000 habitants.</p>
    </div>
    <div class="stats">
      {conditions.map((c) => (
        <div class="stat" data-reveal>
          <span class="num">{c.value}</span>
          <p>{c.label}{c.note && <><br /><span class="muted">{c.note}</span></>}</p>
        </div>
      ))}
    </div>
    <Sticker shape="stickers-09" style="right:6vw;bottom:-3vw;width:clamp(130px,14vw,200px)">70&#8239;000<small>habitants minimum</small></Sticker>
  </section>

  <section class="section wrap t-dolce">
    <div class="sec-head"><span class="eyebrow">Accompagnement franchisé</span><span class="idx">V.</span></div>
    <h2 class="display h-xxl" style="margin-bottom:clamp(40px,6vw,90px);max-width:12ch" data-split>On ouvre <span class="script">ensemble</span></h2>
    <div class="cols">
      {support.map((s) => (
        <div class="col" data-reveal>
          <h3>{s.title}<span class="script">{s.script}</span></h3>
          <ul>{s.items.map((i) => <li><span>{i}</span></li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap t-cielo" style="text-align:center;overflow:hidden">
    <p class="eyebrow" data-reveal style="margin-bottom:2.5rem">Prévisions d’ouvertures 2026</p>
    <h2 class="display h-xxl" style="margin-top:1.5rem">
      <span data-split>Le prochain Ristorante</span><br />
      <span style="display:inline-grid;overflow:hidden;vertical-align:top;color:var(--chianti)" data-rotator>
        {cities.map((c) => <span style="grid-area:1/1" class:list={{ script: c === 'chez vous' }}>{c === 'chez vous' ? c : `à ${c}`}</span>)}
      </span>
    </h2>
    <p class="lead" style="margin:2rem auto 0" data-reveal>Des opportunités dans la France entière.</p>
  </section>

  <section class="section wrap t-giardino" id="candidature">
    <div class="sec-head"><span class="eyebrow">Candidature</span><span class="idx">VI.</span></div>
    <div class="grid" style="row-gap:4rem">
      <div style="grid-column:1/span 5;display:grid;gap:2rem;align-content:start">
        <h2 class="display h-xl" data-split>Parlons de votre <span class="script">projet</span></h2>
        <p class="body-text" data-reveal>Votre contact : {contact.name}, {contact.role}. Il vous rappelle pour un premier échange, sans engagement.</p>
        <div data-reveal style="display:grid;gap:.4rem;font-size:var(--fs-l)">
          <a class="link-u" href={`mailto:${contact.email}`} style="justify-self:start">{contact.email}</a>
          <a class="link-u" href={`tel:${contact.phoneHref}`} style="justify-self:start">{contact.phone}</a>
        </div>
        <div data-reveal><a class="btn" style="--b-bg:var(--dolce);--b-fg:var(--giardino)" href={brochure} download data-magnetic>Télécharger la brochure <Arrow /></a></div>
      </div>
      <form class="form" style="grid-column:7/span 6" data-franchise-form data-reveal>
        <div class="field"><label for="f-prenom">Prénom</label><input id="f-prenom" name="prenom" autocomplete="given-name" required /></div>
        <div class="field"><label for="f-nom">Nom</label><input id="f-nom" name="nom" autocomplete="family-name" required /></div>
        <div class="field"><label for="f-email">E-mail</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="f-tel">Téléphone</label><input id="f-tel" name="tel" type="tel" autocomplete="tel" required /></div>
        <div class="field"><label for="f-ville">Ville ou agglomération visée</label><input id="f-ville" name="ville" required /></div>
        <div class="field">
          <label for="f-apport">Apport personnel</label>
          <select id="f-apport" name="apport" required>
            <option value="">Choisir</option>
            <option>Moins de 350 K€</option>
            <option>350 à 500 K€</option>
            <option>Plus de 500 K€</option>
          </select>
        </div>
        <div class="field field--full">
          <label for="f-exp">Expérience en restauration</label>
          <select id="f-exp" name="experience" required>
            <option value="">Choisir</option>
            <option>Aucune, je me reconvertis</option>
            <option>Moins de 5 ans</option>
            <option>Plus de 5 ans</option>
            <option>J’ai déjà un restaurant ou une franchise</option>
          </select>
        </div>
        <div class="field field--full"><label for="f-msg">Votre projet en quelques mots</label><textarea id="f-msg" name="message"></textarea></div>
        <label class="consent"><input type="checkbox" required /> J’accepte que mes informations soient utilisées pour étudier ma candidature.</label>
        <div><button class="btn" style="--b-bg:var(--dolce);--b-fg:var(--giardino)" type="submit" data-magnetic>Envoyer ma candidature <Arrow /></button></div>
        <p class="form-msg" data-form-msg aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  @media (max-width: 900px) {
    form.form, form.form + * { grid-column: 1 / -1 !important; }
    .grid > div[style*='span 5'] { grid-column: 1 / -1 !important; }
  }
</style>

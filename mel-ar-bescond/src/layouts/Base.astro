---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${site.name} — ${site.tagline}`, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // filet de sécurité : si le script du site a planté, on n'affiche jamais un écran blanc.
      // On attend la fin du chargement de la page (même lent sur mobile) avant de juger.
      window.addEventListener('load', function () {
        setTimeout(function () {
          if (!document.documentElement.classList.contains('js-ready')) document.documentElement.classList.remove('js');
        }, 2500);
      });
    </script>
  </head>
  <body>
    <script is:inline>
      // Menu mobile autonome : il fonctionne même si le script principal du site tarde ou plante.
      (function () {
        var html = document.documentElement;
        function setMenu(open) {
          html.classList.toggle('menu-open', open);
          var b = document.querySelector('[data-menu-toggle]');
          var m = document.getElementById('menu');
          if (b) b.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (m) m.setAttribute('aria-hidden', open ? 'false' : 'true');
          document.body.style.overflow = open ? 'hidden' : '';
          try {
            window.dispatchEvent(new CustomEvent('mab:menu', { detail: open }));
          } catch (e) {}
        }
        window.__mabMenu = setMenu;
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || !t.closest) return;
          if (t.closest('[data-menu-toggle]')) {
            e.preventDefault();
            setMenu(!html.classList.contains('menu-open'));
          } else if (t.closest('[data-menu-link]') && html.classList.contains('menu-open')) {
            setMenu(false);
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && html.classList.contains('menu-open')) setMenu(false);
        });
      })();
    </script>
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>

---
import { site } from '../site.config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/work') : path.startsWith(href);
---

<!-- Barre éditoriale découpée par des filets (référence « Jolie Adams ») -->
<header class="header">
  <a href="/" class="header__cell header__name name">{site.name}</a>
  <p class="header__cell header__role label">{site.role}</p>
  <p class="header__cell header__time label" aria-label="Heure locale">
    {site.location} — <time class="figures" data-clock data-tz={site.timeZone}>--:--</time>
  </p>
  <nav class="header__cell header__nav" aria-label="Navigation principale">
    <ul class="label">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} class="link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href={`mailto:${site.email}`} class="link">Contact</a></li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    display: grid;
    grid-template-columns: 3fr 3fr 3fr 3fr;
    align-items: stretch;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .header__cell {
    display: flex;
    align-items: center;
    padding-inline: var(--margin);
  }
  .header__cell + .header__cell {
    border-left: 1px solid var(--line);
  }
  .header__name {
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }
  .header__nav {
    justify-content: flex-end;
  }
  .header__nav ul {
    display: flex;
    gap: 1.25rem;
    white-space: nowrap;
  }
  .header :global(.figures) {
    font-size: 1.15em;
    letter-spacing: 0.02em;
  }
  @media (max-width: 800px) {
    .header {
      grid-template-columns: 1fr auto;
    }
    .header__role,
    .header__time {
      display: none;
    }
    .header__nav ul {
      gap: 0.75rem;
    }
    .header__name {
      white-space: nowrap;
      font-size: 0.875rem;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
const slides = [
  { img: photo('duo', 'apiculteurs'), cap: 'Nathalie & Frédéric', alt: 'Nathalie et Frédéric Baltzer auprès de leurs ruches' },
  { img: photo('recolte', 'tamis'), cap: 'La récolte', alt: 'Désoperculation d’un cadre de miel' },
  { img: photo('ruche', 'filet'), cap: 'Au cœur de la ruche', alt: 'Abeilles sur les cadres de la ruche' },
  { img: photo('fleur', 'cuillere'), cap: 'Les floraisons', alt: 'Abeille sur une fleur de prunier' },
];
---

<section class="hero" id="top" data-hero data-theme="dark">
  <figure class="hero__frame" data-hero-frame data-gl-slides data-gl-shade data-gl-parallax="0.12">
    {
      slides.map((s, i) => (
        <Image src={s.img} alt={s.alt} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" data-slide={i} />
      ))
    }
  </figure>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content wrap" data-hero-content>
    <p class="hero__kicker label" data-hero-fade>Récolte 2026 · Louargat, Côtes-d’Armor</p>

    <h1 class="hero__title" data-hero-title>
      <span class="hero__line"><span>Le miel rare</span></span>
      <span class="hero__line"><span><em>du bocage</em> breton</span></span>
    </h1>

    <div class="hero__bottom">
      <div class="hero__intro" data-hero-fade>
        <p class="hero__by">Un miel de famille, récolté par Nathalie &amp; Frédéric Baltzer, en quantité limitée.</p>
        <a href="#commander" class="btn btn--light hero__btn">Composer mon panier</a>
      </div>

      <ol class="hero__nav" data-hero-nav aria-label="Photos">
        {
          slides.map((s, i) => (
            <li>
              <button type="button" class:list={['hero__dot', { 'is-on': i === 0 }]} data-goto={i} aria-label={`Photo ${i + 1} : ${s.cap}`}>
                <span class="hero__bar"><i data-bar /></span>
                <span class="hero__cap label">
                  <span class="hero__n">0{i + 1}</span> {s.cap}
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <a href="#manifeste" class="hero__scroll label" data-hero-fade aria-label="Découvrir">Découvrir</a>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    color: var(--ivory);
    background: var(--night);
    overflow: hidden;
  }
  .hero__frame {
    --inset: 0px;
    position: absolute;
    inset: var(--inset);
    overflow: hidden;
  }
  .hero__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__frame :global(img:not([data-slide='0'])) {
    opacity: 0;
  }
  /* voile de lisibilité (sans WebGL ; en WebGL l'assombrissement est dans le shader) */
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(18 14 10 / 0.7), rgb(18 14 10 / 0.05) 55%, rgb(18 14 10 / 0.3));
    pointer-events: none;
  }
  :global(html.gl) .hero__shade {
    display: none;
  }
  .hero__content {
    position: relative;
    z-index: 45;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: calc(110px + env(safe-area-inset-top, 0px));
    padding-bottom: clamp(28px, 5vh, 56px);
    pointer-events: none;
  }
  .hero__content a,
  .hero__content button {
    pointer-events: auto;
  }
  .hero__kicker {
    color: color-mix(in srgb, var(--ivory) 75%, transparent);
  }
  .hero__title {
    align-self: end;
    font-size: clamp(3.4rem, 10.5vw, 12.5rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.035em;
    margin-bottom: clamp(28px, 5vh, 64px);
  }
  .hero__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.06em;
  }
  .hero__line > span {
    display: inline-block;
  }
  .hero__title em {
    font-style: italic;
    color: #e9c98f;
  }
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgb(247 243 236 / 0.25);
  }
  .hero__intro {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .hero__by {
    max-width: 22rem;
    font-size: 1.15rem;
    line-height: 1.4;
    font-weight: 300;
    color: color-mix(in srgb, var(--ivory) 85%, transparent);
  }
  .hero__nav {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 150px));
    gap: 12px;
  }
  .hero__dot {
    display: grid;
    gap: 0.8rem;
    width: 100%;
    text-align: left;
    color: color-mix(in srgb, var(--ivory) 50%, transparent);
    transition: color 0.5s var(--ease);
  }
  .hero__dot.is-on,
  .hero__dot:hover {
    color: var(--ivory);
  }
  .hero__bar {
    position: relative;
    height: 1px;
    background: rgb(247 243 236 / 0.3);
    overflow: hidden;
  }
  .hero__bar i {
    position: absolute;
    inset: 0;
    background: var(--ivory);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__cap {
    font-size: 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hero__n {
    margin-right: 0.5em;
    font-variant-numeric: tabular-nums;
  }
  .hero__scroll {
    position: absolute;
    z-index: 45;
    right: var(--gutter);
    top: calc(110px + env(safe-area-inset-top, 0px));
    writing-mode: vertical-rl;
    color: color-mix(in srgb, var(--ivory) 75%, transparent);
  }
  .btn--light {
    background: var(--ivory);
    color: var(--ink);
  }
  @media (hover: hover) {
    .btn--light:hover {
      color: var(--ink);
    }
  }

  @media (max-width: 900px) {
    .hero__bottom {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 1.6rem;
      border-top: 0;
      padding-top: 0;
    }
    .hero__intro {
      flex-direction: column;
      align-items: stretch;
      gap: 1.2rem;
    }
    .hero__nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
    }
    .hero__cap {
      display: none;
    }
    .hero__dot.is-on .hero__cap {
      display: none;
    }
    .hero__scroll {
      display: none;
    }
    .hero__title {
      margin-bottom: 1.4rem;
    }
  }
</style>

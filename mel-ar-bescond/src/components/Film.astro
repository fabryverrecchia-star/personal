---
// Séquence film : le miel qui coule du rayon, en plein écran, qui s'ouvre au défilement.
import { getImage } from 'astro:assets';
import { photo } from '../lib/photos';
const poster = await getImage({ src: photo('miel-poster'), width: 1280, format: 'webp' });
---

<section class="film" data-film data-theme="dark" aria-label="Le miel qui coule du rayon">
  <div class="film__frame" data-film-frame>
    <video class="film__video" data-film-video poster={poster.src} muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="videos/miel.mp4" type="video/mp4" />
      <source src="videos/miel.webm" type="video/webm" />
    </video>
    <div class="film__shade" aria-hidden="true"></div>
  </div>
  <div class="film__text wrap" data-film-text>
    <p class="label film__kicker">Le temps du miel</p>
    <p class="film__title"><span>Goutte après goutte,</span> <em>il prend son temps</em></p>
  </div>
</section>

<style>
  .film {
    position: relative;
    height: 100svh;
    min-height: 520px;
    background: var(--night);
    color: var(--ivory);
    overflow: hidden;
  }
  .film__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(12% 14% 12% 14%);
  }
  .film__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);
  }
  .film__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(18 14 10 / 0.65), transparent 55%);
  }
  .film__text {
    position: absolute;
    z-index: 45;
    left: 0;
    right: 0;
    bottom: clamp(28px, 7vh, 72px);
    display: grid;
    gap: 1rem;
  }
  .film__kicker {
    color: color-mix(in srgb, var(--ivory) 70%, transparent);
  }
  .film__title {
    font-size: clamp(2.4rem, 6.4vw, 7rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .film__title em {
    font-style: italic;
    color: #e9c98f;
  }
  @media (max-width: 700px) {
    .film__frame {
      clip-path: inset(8% 6% 8% 6%);
    }
  }
</style>

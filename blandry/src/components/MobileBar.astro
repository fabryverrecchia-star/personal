---
import { telHref } from '../data/site';
import { u } from '../lib/url';
---

<div class="mbar label" data-mbar>
  <a href={telHref} class="mbar__call">Appeler</a>
  <a href={u('/#contact')} class="mbar__quote">Demander un devis</a>
</div>

<style>
  .mbar {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    background: var(--basalte);
    color: var(--lin);
    box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.45);
    transform: translateY(calc(100% + 30px));
    transition: transform 0.8s var(--ease-out);
  }
  .mbar.is-visible {
    transform: none;
  }
  .mbar a {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 54px;
  }
  .mbar__quote {
    background: var(--argile);
  }
  @media (min-width: 1100px) {
    .mbar {
      display: none;
    }
  }
</style>

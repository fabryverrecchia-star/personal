---
// Logo SADIK : SVG exact (rendu serveur) + composition WebGL au défilement.
// Sans JavaScript, sans WebGL ou avec « mouvement réduit », le SVG reste affiché tel quel.
import { sadikSvg } from '../brand/sadik';

interface Props {
  id?: string;
}
const { id = 'sadik' } = Astro.props;
const svg = sadikSvg({ id, attrs: 'class="sadik__svg" preserveAspectRatio="xMidYMid meet"' });
---

<section class="sadik" data-sadik aria-label="Logo SADIK">
  <div class="sadik__stage" data-sadik-stage>
    <div class="sadik__logo" data-sadik-logo set:html={svg} />
    <p class="sadik__hint" data-sadik-hint><span>Scroll down</span><i aria-hidden="true"></i></p>
  </div>
</section>

<style>
  .sadik {
    --sadik-bg: #0f110e;
    position: relative;
    /* Passe sous l'en-tête fixe (main réserve sa hauteur) */
    margin-top: calc(var(--header-h) * -1);
    background: var(--sadik-bg);
    color: #efede8;
  }
  /* Piste de défilement : n'existe que lorsque la composition WebGL est active */
  .sadik.is-live {
    height: calc(var(--sadik-vh, 100svh) * 5);
  }

  .sadik__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: var(--sadik-vh, 100svh);
    padding: calc(var(--header-h) + 1rem) var(--margin) var(--margin);
    overflow: hidden;
  }
  .sadik.is-live .sadik__stage {
    position: sticky;
    top: 0;
    height: var(--sadik-vh, 100svh);
  }
  /* Page intégrée qui ne défile pas elle-même : la scène est maintenue à l'écran en JS */
  .sadik.is-embedded .sadik__stage {
    position: absolute;
    inset: 0 0 auto 0;
    will-change: transform;
  }
  .sadik__stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Emplacement final du logo (proportions 1662 × 442), aussi utilisé comme repère par le WebGL */
  .sadik__logo {
    position: relative;
    z-index: 1;
    width: min(100%, 1400px, (100svh - var(--header-h) - 6rem) * 3.76);
    aspect-ratio: 1662 / 442;
  }
  .sadik__logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sadik.is-live .sadik__logo {
    opacity: 0;
  }
  .sadik__hint {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: max(var(--margin, 24px), 24px);
    translate: -50% 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font: 500 13px/1 ui-monospace, 'SFMono-Regular', Menlo, monospace;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #ece7da;
    white-space: nowrap;
    pointer-events: none;
    animation: sadik-hint-in 0.9s 0.6s both ease-out;
  }
  /* Reste lisible quand une pièce passe dessous */
  .sadik__hint :global(span) {
    padding: 8px 6px 8px 10px;
    background: rgb(15 17 14 / 0.72);
  }
  /* Fil qui descend : invite à faire défiler */
  .sadik__hint :global(i) {
    position: relative;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgb(236 231 218 / 0.2);
  }
  .sadik__hint :global(i)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #f89000;
    animation: sadik-hint-line 1.6s infinite cubic-bezier(0.65, 0, 0.35, 1);
  }
  @keyframes sadik-hint-in {
    from { opacity: 0; transform: translateY(8px); }
  }
  @keyframes sadik-hint-line {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sadik__hint, .sadik__hint :global(i)::after { animation: none; }
  }
  .sadik:not(.is-live) .sadik__hint {
    display: none;
  }

  @media (max-width: 800px), (orientation: portrait) {
    .sadik.is-live {
      height: calc(var(--sadik-vh, 100svh) * 4.2);
    }
    .sadik__stage {
      padding-inline: 16px;
    }
    .sadik__logo {
      width: 100%;
    }
  }
</style>

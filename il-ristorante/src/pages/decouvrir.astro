---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import Sticker from '../components/Sticker.astro';
import Rows from '../components/Rows.astro';
import CtaBand from '../components/CtaBand.astro';
import { pillars } from '../data/site';

const menu = [
  { title: 'Antipasti', text: 'À poser au milieu de la table : jambon de Parme coupé à la minute, mozzarella di bufala, légumes rôtis.', img: '/img/bruschetta.webp' },
  { title: 'Pizze', text: 'Une pâte étalée à la main, croustillante et alvéolée, qui sort du four en crépitant.', img: '/img/pizza-top.webp' },
  { title: 'Pasta', text: 'Des formes choisies pour leur sauce, servies al dente, nappées juste comme il faut.', img: '/img/pasta.webp' },
  { title: 'Secondi', text: 'Viandes et poissons saisis, rôtis ou mijotés, selon la saison.', img: '/img/table.webp' },
  { title: 'Dolci', text: 'Un tiramisù crémeux, une glace dense et fondante : on garde toujours une place.', img: '/img/gelato.webp' },
];
---
<Base title="Découvrir" description="Il Ristorante depuis 2006 : notre promesse, nos 4 piliers, nos produits AOP et notre carte de saison.">
  <PageHero image="/img/interior-logo.webp" alt="Salle d’un restaurant Il Ristorante, mur de marbre et logo calligraphié" crumbs={[{ label: 'Découvrir', href: '/decouvrir' }]}>
    <Fragment slot="title">Depuis 2006,<br />on passe <span class="script">à table</span></Fragment>
    <Fragment slot="lead">Une aventure qui commence par une idée simple : rendre accessible l’excellence de la cuisine et des produits italiens.</Fragment>
  </PageHero>

  <section class="section wrap t-dolce" style="overflow:hidden">
    <div class="sec-head"><span class="eyebrow">Notre promesse</span><span class="idx">I.</span></div>
    <p class="manifesto" data-split>Un moment agréable et soigné, à table, qui rend accessible <span class="script">l’excellence</span> de la cuisine italienne.</p>
    <Sticker shape="stickers-02" style="right:8vw;bottom:6vh;color:var(--dolce)">Fatto<br />in casa</Sticker>
  </section>

  <section class="section wrap t-dolce" style="padding-top:0">
    <div class="mosaic">
      <Media src="/img/interior-teal.webp" alt="Banquettes bleu canard et tables en marbre" />
      <Media src="/img/bar.webp" alt="Le bar et ses étagères de bouteilles" />
      <Media src="/img/dough.webp" alt="Pâte à pizza étalée à la main" class="media--r" />
      <Media src="/img/chef.webp" alt="Un chef en cuisine" />
      <Media src="/img/shelves.webp" alt="Étagères de produits italiens et de vins" />
    </div>
  </section>

  <section class="section wrap t-cielo">
    <div class="sec-head"><span class="eyebrow">Nos 4 piliers</span><span class="idx">II.</span></div>
    <Rows rows={pillars.map((p) => ({ n: p.n, title: p.title, text: p.text, img: p.img }))} />
  </section>

  <section class="section wrap t-dolce">
    <div class="split split--rev">
      <Media src="/img/parmesan.webp" alt="Meules de Parmigiano Reggiano en affinage" class="media--r" />
      <div class="txt">
        <p class="eyebrow">Le produit au centre</p>
        <h2 class="display h-xl" data-split>36 mois <span class="script">d’affinage</span></h2>
        <div class="body-text" data-reveal>
          <p>Notre Parmigiano Reggiano a pris son temps. Granuleux, légèrement salé, il se râpe à la dernière minute sur vos pâtes.</p>
          <p>On achète directement aux producteurs italiens et on choisit parmi les grandes appellations protégées : Prosciutto di Parma, Parmigiano Reggiano, Gorgonzola, Mozzarella di Bufala.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap t-dolce" style="padding-top:0">
    <div class="sec-head"><span class="eyebrow">La carte, au fil des saisons</span><span class="idx">III.</span></div>
    <Rows rows={menu} />
  </section>

  <CtaBand href="/restaurants" label="Réserver votre table" eyebrow="Ce midi, ce soir, jeudi ?">On vous garde <span class="script">une table ?</span></CtaBand>
</Base>

---
// Ouverture : le logo apparaît, un filet se trace, le rideau se lève.
import logo from '../assets/svg/logo.svg?raw';
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader__logo" data-loader-logo set:html={logo} />
  <div class="loader__bar"><i data-loader-bar></i></div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2.4rem;
    background: var(--night);
    color: var(--ivory);
  }
  :global(html:not(.js)) .loader {
    display: none;
  }
  .loader__logo {
    width: min(64vw, 380px);
  }
  .loader__logo :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .loader__logo :global(.glyph) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .loader__bar {
    position: relative;
    width: min(64vw, 380px);
    height: 1px;
    background: var(--night-line);
    overflow: hidden;
  }
  .loader__bar i {
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>

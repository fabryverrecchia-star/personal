---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PaintHero from '../components/PaintHero.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Marquee from '../components/Marquee.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { site, services, zones, etapes, realisations as reals, photos, faqGenerale } from '../data/site';
import { u } from '../lib/url';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGenerale.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
// La chambre sous combles (photo HD) en premier
const realisations = [...reals].sort((a, b) => Number(b.titre.includes('combles')) - Number(a.titre.includes('combles')));
const n2 = (i: number) => String(i + 1).padStart(2, '0');
const engagements = ['Visite & devis gratuits', 'Garantie décennale', 'Réponse sous 48 h', 'Un seul interlocuteur'];
---

<Base
  title={`${site.nom} — Peintre en bâtiment, peinture et finitions | Puy-de-Dôme`}
  description="Artisan peintre à Saint-Georges-de-Mons : peinture intérieure, préparation des supports, façades et boiseries. Interventions dans les Combrailles, à Riom et à Clermont-Ferrand. Visite et devis gratuits."
  schema={[faqLd]}
>
  <PaintHero />

  <Marquee items={['Poncer', 'Enduire', 'Protéger', 'Peindre', 'Livrer']} label="Les gestes du métier" />

  <!-- 01 · Le métier -->
  <section class="intro section" aria-labelledby="intro-t">
    <div class="wrap">
      <div class="row-head label">
        <span>(01) Le métier</span>
        <span class="muted">{site.adresse.ville} · Puy-de-Dôme</span>
      </div>
      <h2 id="intro-t" class="sr-only">Notre métier : la peinture</h2>
      <p class="intro__t" data-words>
        Notre spécialité n’est pas la rénovation générale&nbsp;: <em>notre métier est la peinture.</em> Nous
        préparons, protégeons et mettons en couleur chaque pièce avec l’exigence d’un artisan, du sol au plafond.
      </p>
      <ul class="intro__facts label">
        {engagements.map((e) => <li data-reveal="fade">{e}</li>)}
      </ul>
    </div>
  </section>

  <!-- 02 · Le geste (vidéo qui s'ouvre au défilement) -->
  <section class="geste dark" data-geste aria-labelledby="geste-t">
    <div class="geste__sticky">
      <div class="geste__frame" data-geste-frame>
        <video
          class="geste__video"
          data-autovideo
          muted
          loop
          playsinline
          preload="none"
          poster={u('/videos/metier-poster.jpg')}
          aria-label="Blandry au travail : ponçage d’un plafond, application d’enduit, reprise des joints"
        >
          <source src={u('/videos/metier-1280.mp4')} type="video/mp4" data-src-sm={u('/videos/metier-720.mp4')} />
        </video>
      </div>
      <div class="geste__words display" aria-hidden="true">
        <span data-geste-l>Le</span>
        <span data-geste-r>geste</span>
      </div>
      <div class="geste__cap wrap label">
        <h2 id="geste-t">(02) Le geste</h2>
        <span>Ponçage · Enduit · Joints</span>
      </div>
    </div>
  </section>

  <!-- 03 · Avant / après -->
  <section class="ba-sec section dark" id="avant-apres" aria-labelledby="ba-t">
    <div class="wrap">
      <div class="row-head label">
        <span>(03) Avant / après</span>
        <span class="muted">Faites glisser</span>
      </div>
      <div class="ba-sec__grid">
        <div class="ba-sec__head">
          <h2 id="ba-t" class="display ba-sec__t" data-split>La preuve <em>par l’image.</em></h2>
          <p class="ba-sec__p" data-reveal="fade">
            La qualité d’une peinture se joue avant la première couche : préparation des supports, reprise des
            murs et des plafonds, protection du logement.
          </p>
        </div>
        <div class="ba-sec__slider" data-reveal="fade">
          <BeforeAfter />
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · Réalisations -->
  <section class="works section" id="realisations" aria-labelledby="works-t" data-works>
    <div class="wrap">
      <div class="row-head label">
        <span>(04) Réalisations</span>
        <span class="muted">{String(realisations.length).padStart(2, '0')} chantiers récents</span>
      </div>
      <h2 id="works-t" class="display works__t" data-split>Chantiers <em>livrés.</em></h2>
      <ul class="works__list">
        {
          realisations.map((r, i) => (
            <li class="work" data-work>
              <div class="work__media">
                <Image src={r.image} alt={r.alt} widths={[600, 1080]} sizes="(min-width: 1024px) 30vw, 92vw" class="work__img" />
              </div>
              <div class="work__row">
                <span class="label work__n">({n2(i)})</span>
                <h3 class="display work__title">{r.titre}</h3>
                <p class="label work__tags">{r.travaux.join(' · ')}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="works__float" data-works-float aria-hidden="true">
      {realisations.map((r) => <Image src={r.image} alt="" widths={[600]} sizes="30vw" class="works__fimg" />)}
    </div>
  </section>

  <!-- 05 · Savoir-faire -->
  <section class="skills section" id="savoir-faire" aria-labelledby="skills-t">
    <div class="wrap">
      <div class="row-head label">
        <span>(05) Savoir-faire</span>
        <span class="muted">{String(services.length).padStart(2, '0')} prestations</span>
      </div>
      <h2 id="skills-t" class="display skills__t" data-split>La peinture <em>et tout ce qui la prépare.</em></h2>
      <ul class="skills__list">
        {
          services.map((s, i) => (
            <li class="skill" data-reveal="fade">
              <span class="label skill__n">({n2(i)})</span>
              <h3 class="display skill__title">{s.titre}</h3>
              <div class="skill__body">
                <p>{s.texte}</p>
                <p class="label skill__pts">{s.points.join(' · ')}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Bande lumière -->
  <section class="band" aria-label="Finitions" data-parallax-wrap>
    <Image src={photos.finition.src} alt={photos.finition.alt} widths={[800, 1587]} sizes="100vw" class="band__img" data-parallax />
    <p class="band__t display wrap" data-split>La lumière révèle <em>chaque défaut.</em></p>
  </section>

  <!-- 06 · Déroulement -->
  <section class="steps dark" id="etapes" aria-labelledby="steps-t" data-steps>
    <div class="steps__pin">
      <div class="wrap steps__head">
        <div class="row-head label">
          <span>(06) Déroulement</span>
          <span class="muted">De la demande de devis à la livraison</span>
        </div>
        <h2 id="steps-t" class="display steps__t" data-split>Six étapes, <em>zéro surprise.</em></h2>
      </div>
      <ol class="steps__track" data-steps-track>
        {
          etapes.map((e, i) => (
            <li class="step">
              <span class="step__n display" aria-hidden="true">{n2(i)}</span>
              <div class="step__body">
                <span class="label step__d">{e.duree}</span>
                <h3 class="step__t">{e.titre}</h3>
                <p class="step__p">{e.texte}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="wrap steps__bar" aria-hidden="true"><span data-steps-bar></span></div>
    </div>
  </section>

  <!-- 07 · Zone -->
  <section class="zones section" id="secteurs" aria-labelledby="zones-t">
    <div class="wrap">
      <div class="row-head label">
        <span>(07) Zone d’intervention</span>
        <span class="muted">~ 40 km autour de {site.adresse.ville}</span>
      </div>
      <div class="zones__grid">
        <h2 id="zones-t" class="display zones__t" data-split>Où nous <em>intervenons.</em></h2>
        <div>
          <p class="zones__p" data-reveal="fade">
            Installés à {site.adresse.ville}, nous intervenons dans les Combrailles, à Riom, à Clermont-Ferrand et
            dans leurs environs. Le déplacement pour la visite et le devis est gratuit.
          </p>
          <ul class="zlist">
            {
              zones.map((z) => (
                <li data-reveal="fade">
                  <a href={u(`/${z.slug}/`)} class="zrow">
                    <span class="display zrow__name">{z.nom}</span>
                    <span class="label zrow__c">{z.court}</span>
                    <svg class="zrow__go" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqGenerale} num="08" />
  <Contact num="09" />
</Base>

<style>
  /* 01 · Intro */
  .intro__t {
    font-size: clamp(1.9rem, 4.6vw, 4.4rem);
    font-weight: 500;
    font-stretch: 88%;
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 22ch;
    text-wrap: balance;
  }
  .intro__t em {
    font-style: normal;
    color: var(--bordeaux);
  }
  .intro__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: clamp(36px, 5vw, 64px);
  }
  .intro__facts li {
    padding: 10px 14px;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  /* 02 · Le geste */
  .geste {
    height: 240vh;
  }
  .geste__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .geste__frame {
    position: absolute;
    inset: 0;
    clip-path: inset(22% 18% 22% 18%);
    will-change: clip-path;
  }
  .geste__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .geste__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(14 13 12 / 0.25);
  }
  .geste__words {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 0.18em;
    font-size: clamp(4.6rem, 20vw, 20rem);
    color: var(--craie);
    text-shadow: 0 10px 60px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }
  .geste__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(22px + env(safe-area-inset-bottom));
    z-index: 2;
    display: flex;
    justify-content: space-between;
  }
  .geste__cap h2 {
    font: inherit;
  }

  /* 03 · Avant / après */
  .ba-sec {
    --line: rgb(255 255 255 / 0.16);
    --muted: rgb(255 255 255 / 0.62);
  }
  .ba-sec__grid {
    display: grid;
    gap: 36px;
  }
  .ba-sec__head {
    display: grid;
    gap: 22px;
    align-content: start;
  }
  .ba-sec__t {
    font-size: var(--fs-xl);
  }
  .ba-sec__p {
    color: var(--muted);
    max-width: 40ch;
  }
  @media (min-width: 1024px) {
    .ba-sec__grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
    .ba-sec__head {
      position: sticky;
      top: 110px;
      align-self: start;
    }
    .ba-sec__slider {
      max-width: 620px;
      width: 100%;
      justify-self: end;
    }
  }

  /* 04 · Réalisations : liste + image flottante */
  .works__t {
    font-size: var(--fs-xxl);
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .works__list {
    border-top: 1px solid var(--line);
  }
  .work {
    border-bottom: 1px solid var(--line);
    padding: 20px 0 24px;
    display: grid;
    gap: 16px;
  }
  .work__media {
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
  }
  .work__media :global(.work__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .work__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 14px;
    align-items: baseline;
  }
  .work__title {
    font-size: clamp(2.4rem, 9vw, 7.4rem);
    transition:
      transform 0.6s var(--ease),
      color 0.4s;
  }
  .work__tags {
    grid-column: 2;
    color: var(--muted);
  }
  .works__float {
    display: none;
  }
  @media (hover: hover) and (min-width: 1024px) {
    .work {
      padding: 26px 0;
    }
    .work__media {
      display: none;
    }
    .work__row {
      grid-template-columns: 6rem 1fr auto;
    }
    .work__tags {
      grid-column: 3;
      text-align: right;
    }
    .work:hover .work__title {
      color: var(--bordeaux);
      transform: translateX(24px);
    }
    .works__float {
      display: block;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 50;
      width: 22vw;
      aspect-ratio: 4 / 5;
      pointer-events: none;
      overflow: hidden;
      clip-path: inset(50% 50% 50% 50%);
      transition: clip-path 0.6s var(--ease);
    }
    .works__float.is-on {
      clip-path: inset(0 0 0 0);
    }
    .works__float :global(.works__fimg) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .works__float :global(.works__fimg.is-on) {
      opacity: 1;
    }
  }

  /* 05 · Savoir-faire */
  .skills__t {
    font-size: var(--fs-xl);
    max-width: 14ch;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .skills__list {
    border-top: 1px solid var(--line);
  }
  .skill {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 14px;
    padding: 24px 0 28px;
    border-bottom: 1px solid var(--line);
  }
  .skill__n {
    padding-top: 0.5em;
    color: var(--bordeaux);
  }
  .skill__title {
    font-size: clamp(2.2rem, 7vw, 5.6rem);
  }
  .skill__body {
    grid-column: 2;
    display: grid;
    gap: 12px;
    max-width: 52ch;
    color: var(--muted);
  }
  .skill__pts {
    color: var(--fg);
  }
  @media (min-width: 1024px) {
    .skill {
      grid-template-columns: 6rem 1.2fr 1fr;
      align-items: start;
      padding: 32px 0;
    }
    .skill__body {
      grid-column: 3;
      padding-top: 0.4em;
    }
  }

  /* Bande lumière */
  .band {
    position: relative;
    height: clamp(460px, 95svh, 900px);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .band :global(.band__img) {
    position: absolute;
    inset: -10% 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
  }
  .band__t {
    position: relative;
    font-size: clamp(3.2rem, 12vw, 12rem);
    padding-bottom: clamp(24px, 4vw, 48px);
    color: var(--noir);
  }

  /* 06 · Déroulement : piste horizontale au bureau */
  .steps {
    --line: rgb(255 255 255 / 0.16);
    --muted: rgb(255 255 255 / 0.6);
    padding-block: clamp(88px, 12vw, 140px) clamp(64px, 8vw, 100px);
    overflow: hidden;
  }
  .steps__t {
    font-size: var(--fs-xl);
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .steps__track {
    display: grid;
    gap: 0;
    padding-inline: var(--gutter);
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .step__n {
    font-size: clamp(4rem, 18vw, 11rem);
    line-height: 0.78;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.5);
    min-width: 1.1em;
  }
  .step__body {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .step__d {
    color: var(--bordeaux-vif);
  }
  .step__t {
    font-size: var(--fs-m);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .step__p {
    color: var(--muted);
    max-width: 40ch;
  }
  .steps__bar {
    display: none;
  }
  @media (min-width: 1024px) {
    .steps {
      padding-block: 0;
    }
    .steps__pin {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .steps__track {
      display: flex;
      width: max-content;
      gap: 0;
    }
    .step {
      width: 34vw;
      grid-template-columns: 1fr;
      padding: 28px 40px 0 0;
      margin-right: 3vw;
    }
    .step__n {
      font-size: 12vw;
    }
    .steps__bar {
      display: block;
      margin-top: 40px;
    }
    .steps__bar span {
      display: block;
      height: 2px;
      background: var(--bordeaux-vif);
      transform-origin: 0 0;
      transform: scaleX(0);
    }
  }

  /* 07 · Zone */
  .zones__grid {
    display: grid;
    gap: 32px;
  }
  .zones__t {
    font-size: var(--fs-xl);
  }
  .zones__p {
    max-width: 44ch;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .zlist {
    border-top: 1px solid var(--line);
  }
  .zrow {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 16px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.3s;
  }
  .zrow__name {
    font-size: clamp(2rem, 5vw, 3.6rem);
  }
  .zrow__c {
    color: var(--muted);
  }
  .zrow__go {
    grid-row: 1 / span 2;
    grid-column: 2;
    width: 18px;
    transition: transform 0.5s var(--ease);
  }
  .zrow:hover {
    color: var(--bordeaux);
  }
  .zrow:hover .zrow__go {
    transform: rotate(45deg);
  }
  @media (min-width: 1024px) {
    .zones__grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }
</style>

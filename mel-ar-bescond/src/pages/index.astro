---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Maison from '../components/Maison.astro';
import Engagements from '../components/Engagements.astro';
import Recolte from '../components/Recolte.astro';
import Crystal from '../components/Crystal.astro';
import Shop from '../components/Shop.astro';
import Terroir from '../components/Terroir.astro';
import Order from '../components/Order.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
---

<Base>
  <Loader />
  <Header />
  <main>
    <Hero />
    <Manifesto />
    <Maison />
    <Engagements />
    <Recolte />
    <Crystal />
    <Shop />
    <Terroir />
    <Order />
  </main>
  <Footer />
  <Cart />
  <div class="cursor" data-cursor aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__txt" data-cursor-txt></span></div>
</Base>

<style is:global>
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 95;
    pointer-events: none;
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .cursor {
      display: block;
    }
  }
  .cursor__dot {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--honey);
    transition:
      transform 0.5s var(--ease),
      background 0.3s;
  }
  .cursor.is-hover .cursor__dot {
    transform: rotate(-45deg) scale(2.2);
    background: color-mix(in srgb, var(--honey) 55%, transparent);
  }
  .cursor.has-txt .cursor__dot {
    transform: rotate(-45deg) scale(7);
    background: var(--honey);
  }
  .cursor__txt {
    position: absolute;
    transform: translate(-50%, -50%);
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cursor.has-txt .cursor__txt {
    opacity: 1;
  }
</style>

<script>
  import '../scripts/main';
</script>

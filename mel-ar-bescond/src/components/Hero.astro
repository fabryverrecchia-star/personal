---
import { Image } from 'astro:assets';
import logo from '../assets/svg/logo.svg?raw';
import { photo } from '../lib/photos';
const hero = photo('hero', 'duo', 'apiculteurs');
---

<section class="hero" id="top" data-hero>
  <div class="hero__head wrap">
    <p class="label" data-hero-fade>Miel naturel · Côtes-d’Armor</p>
    <p class="label hero__year" data-hero-fade>Récolte 2026</p>
  </div>

  <h1 class="hero__title wrap">
    <span class="sr-only">Mel Ar Bescond — miel naturel des Côtes-d’Armor</span>
    <span class="hero__logo" data-hero-logo set:html={logo} />
  </h1>

  <div class="hero__stage" data-hero-stage>
    <figure class="hero__frame" data-hero-frame>
      <div class="hero__img" data-hero-img>
        <Image src={hero} alt="Nathalie et Frédéric Baltzer auprès de leurs ruches" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
      </div>
    </figure>
    <div class="hero__caption wrap">
      <p class="hero__by" data-hero-fade>Par Nathalie &amp; Frédéric Baltzer</p>
      <a href="#commander" class="cta" data-hero-fade>Composer mon panier <span class="cta__line"></span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(96px, 14vh, 150px);
  }
  .hero__head {
    display: flex;
    justify-content: space-between;
    color: var(--ink-soft);
  }
  .hero__title {
    margin-top: clamp(28px, 6vh, 64px);
  }
  .hero__logo {
    display: block;
    color: var(--ink);
  }
  .hero__logo :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero__logo :global(.glyph) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .hero__stage {
    position: relative;
    margin-top: clamp(40px, 7vh, 80px);
  }
  .hero__frame {
    position: relative;
    height: 88svh;
    overflow: hidden;
    clip-path: inset(0 var(--gutter) 0 var(--gutter));
  }
  .hero__img {
    position: absolute;
    inset: -8% 0;
  }
  .hero__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .hero__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.6rem 0;
  }
  .hero__by {
    font-size: var(--fs-lead);
    font-style: italic;
    font-weight: 300;
  }

  @media (max-width: 700px) {
    .hero__frame {
      height: 72svh;
    }
    .hero__caption {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { site, zones, services, etapes, selection, galerie, visuel, type Zone } from '../data/site';
import { u } from '../lib/url';

export function getStaticPaths() {
  return zones.map((z) => ({ params: { zone: z.slug }, props: { z } }));
}
const { z } = Astro.props as { z: Zone };
const autres = zones.filter((o) => o.slug !== z.slug);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const listeCommunes = z.communes.slice(0, -1).join(', ') + ' et ' + z.communes.at(-1);
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const heroImg = { 'plaquiste-peintre-combrailles': 'placo-vissage', 'plaquiste-peintre-riom': 'carrelage-salle-de-bain', 'plaquiste-peintre-clermont-ferrand': 'finition-lumiere' }[z.slug] ?? 'placo-vissage';
const hero = visuel(heroImg);
const words = z.dans.split(' ');

const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', serviceType: ['Plâtrerie', 'Peinture en bâtiment', 'Carrelage'], name: `${site.metierCourt} ${z.dans}`, provider: { '@id': `${site.url}/#entreprise` }, areaServed: z.communes.map((c) => ({ '@type': 'City', name: c })), url: pageUrl },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: z.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: `${site.metierCourt} ${z.dans}`, item: pageUrl }] },
];
---

<Base title={`${z.titreSeo} | ${site.nom}`} description={z.descriptionSeo} schema={schema}>
  <section class="zhero">
    <div class="zhero__text">
      <nav class="label muted" aria-label="Fil d’Ariane" data-hero-fade>
        <a href={u('/')} class="link-u">Accueil</a> / <span aria-current="page">{site.metierCourt} {z.dans}</span>
      </nav>
      <h1 class="display zhero__t" data-hero-title>
        <span class="line"><span class="line-inner">Placo &amp; peinture</span></span>
        <span class="line"><span class="line-inner"><em>{words.join(' ')}</em></span></span>
      </h1>
      <p class="zhero__p" data-hero-fade>{z.intro}</p>
      <div class="zhero__ctas" data-hero-fade>
        <a href="#contact" class="btn btn--solid" data-magnetic>Demander un devis</a>
        <a href={u('/realisations/')} class="cta">Nos réalisations</a>
      </div>
    </div>
    <figure class="zhero__media" data-parallax-wrap data-hero-fade>
      <Image src={hero} alt="" widths={[600, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" class="zhero__img" data-parallax />
    </figure>
  </section>

  <section class="section alt">
    <div class="wrap zapp">
      <div>
        <p class="label muted" data-reveal="fade">Notre approche</p>
        <h2 class="title zapp__t" data-split>Un travail adapté <em>à votre logement</em></h2>
      </div>
      <ol class="zapp__list">
        {
          z.terrain.map((c, i) => (
            <li data-reveal="fade">
              <span class="zapp__n">{roman[i]}.</span>
              <h3 class="zapp__h">{c.titre}</h3>
              <p class="muted">{c.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap zba">
      <h2 class="display zba__t" data-split>Avant, après</h2>
      <div class="zba__slider" data-reveal="fade"><BeforeAfter /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="label muted" data-reveal="fade">Réalisations</p>
      <ul class="zworks">
        {
          selection.slice(0, 3).map((p) => (
            <li>
              <div class="zworks__media" data-reveal="img" data-view>
                <Image src={p.src} alt="Chantier de peinture réalisé par Benjamin Landry" widths={[500, 900]} sizes="(min-width: 900px) 30vw, 92vw" />
              </div>
            </li>
          ))
        }
      </ul>
      <div class="zmore"><a href={u('/realisations/')} class="btn" data-magnetic>Voir toutes les réalisations</a></div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap zsteps">
      <div>
        <p class="label muted" data-reveal="fade">Déroulement</p>
        <h2 class="title zsteps__t" data-split>De la demande de devis <em>à la livraison</em></h2>
      </div>
      <ol class="zsteps__list">
        {
          etapes.map((e, i) => (
            <li data-reveal="fade">
              <span class="zapp__n">{roman[i]}.</span>
              <span class="zsteps__h">{e.titre}</span>
              <span class="label muted">{e.duree}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap zcom">
      <p class="label muted">Communes desservies</p>
      <p class="title zcom__p" data-reveal="fade">
        Nous intervenons notamment à {listeCommunes}.
      </p>
      <p class="prose" data-reveal="fade">
        Votre commune n’apparaît pas ? Nous intervenons {site.zoneIntervention}, et la visite reste gratuite.
      </p>
      <p class="zcom__links" data-reveal="fade">
        {autres.map((o) => <a href={u(`/${o.slug}/`)} class="cta">{site.metierCourt} {o.dans}</a>)}
      </p>
    </div>
  </section>

  <Faq items={z.faq} />
  <Contact zone={z.dans} />
</Base>

<style>
  .zhero {
    display: grid;
  }
  .zhero__text {
    display: grid;
    gap: 24px;
    align-content: end;
    padding: calc(140px + env(safe-area-inset-top)) var(--gutter) 56px;
  }
  .zhero__t {
    font-size: clamp(2.8rem, 11vw, 7.4rem);
  }
  .zhero__p {
    max-width: 46ch;
    color: var(--muted);
  }
  .zhero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }
  .zhero__media {
    position: relative;
    height: 70svh;
    overflow: hidden;
  }
  .zhero__media :global(.zhero__img) {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }
  @media (min-width: 1024px) {
    .zhero {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
    .zhero__text {
      align-content: center;
      padding-bottom: 80px;
    }
    .zhero__media {
      height: auto;
    }
  }
  .zapp,
  .zsteps {
    display: grid;
    gap: 40px;
  }
  .zapp__t,
  .zsteps__t {
    font-size: var(--fs-l);
    max-width: 14ch;
    margin-top: 16px;
  }
  .zapp__list,
  .zsteps__list {
    border-top: 1px solid var(--line);
  }
  .zapp__list li {
    display: grid;
    grid-template-columns: 2.8rem 1fr;
    gap: 6px 10px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .zapp__list p {
    grid-column: 2;
    max-width: 52ch;
  }
  .zapp__n {
    font-family: var(--serif);
    color: var(--muted);
  }
  .zapp__h,
  .zsteps__h {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
  }
  .zsteps__list li {
    display: grid;
    grid-template-columns: 2.8rem 1fr auto;
    align-items: baseline;
    gap: 10px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 1024px) {
    .zapp,
    .zsteps {
      grid-template-columns: 5fr 7fr;
      gap: 7vw;
    }
  }
  .zba {
    display: grid;
    justify-items: center;
  }
  .zba__t {
    position: relative;
    z-index: 2;
    font-size: clamp(3rem, 12vw, 10rem);
    margin-bottom: clamp(-2.6rem, -3.6vw, -1rem);
    pointer-events: none;
    text-align: center;
  }
  .zba__slider {
    width: min(100%, 500px);
  }
  .zworks {
    display: grid;
    gap: 36px;
    margin-top: 32px;
  }
  .zworks li {
    display: grid;
    gap: 12px;
  }
  .zworks__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    max-width: 100%;
  }
  .zworks__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zworks__cap {
    font-family: var(--serif);
  }
  @media (min-width: 900px) {
    .zworks {
      grid-template-columns: repeat(3, 1fr);
    }
    .zworks li:nth-child(2) {
      margin-top: 8vw;
    }
  }
  .zmore {
    display: flex;
    justify-content: center;
    margin-top: 64px;
  }
  .zcom {
    display: grid;
    gap: 22px;
    max-width: 980px;
  }
  .zcom__p {
    font-size: var(--fs-m);
  }
  .zcom__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
  }
</style>

---
import { site, zones, services, telHref } from '../data/site';
import { u } from '../lib/url';
const annee = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="wrap">
    <div class="footer__cols">
      <div>
        <p class="label muted">Entreprise</p>
        <address>
          {site.nom} — {site.metier}<br />
          {site.adresse.rue && <>{site.adresse.rue}<br /></>}
          {site.adresse.codePostal} {site.adresse.ville}<br />
          Puy-de-Dôme
        </address>
      </div>
      <div>
        <p class="label muted">Contact</p>
        <a href={telHref} class="link-u">{site.telephone}</a>
        <a href={`mailto:${site.email}`} class="link-u">{site.email}</a>
        <span class="muted">{site.horaires}</span>
      </div>
      <div>
        <p class="label muted">Savoir-faire</p>
        {services.map((s) => <a href={u(`/#savoir-faire`)} class="link-u">{s.titre}</a>)}
      </div>
      <div>
        <p class="label muted">Zone d’intervention</p>
        {zones.map((z) => <a href={u(`/${z.slug}/`)} class="link-u">Peintre {z.dans}</a>)}
      </div>
    </div>
  </div>

  <p class="footer__giant display" aria-hidden="true" data-fit>{site.nom}</p>

  <div class="wrap footer__bottom label">
    <span>© {annee} {site.nom}{site.siret && <> · SIRET {site.siret}</>} · {site.assurance}</span>
    <a href={u('/mentions-legales/')} class="link-u">Mentions légales</a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(64px, 9vw, 120px);
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
    overflow: hidden;
  }
  @media (min-width: 1100px) {
    .footer {
      padding-bottom: 24px;
    }
  }
  .footer__cols {
    display: grid;
    gap: 36px;
    font-size: 0.95rem;
  }
  .footer__cols > div {
    display: grid;
    gap: 6px;
    align-content: start;
    justify-items: start;
  }
  .footer__cols .label {
    margin-bottom: 6px;
  }
  address {
    font-style: normal;
    line-height: 1.6;
  }
  @media (min-width: 700px) {
    .footer__cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .footer__cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .footer__giant {
    margin-top: clamp(48px, 8vw, 110px);
    font-size: 27vw;
    line-height: 0.76;
    text-align: center;
    white-space: nowrap;
    color: var(--bordeaux-vif);
    letter-spacing: -0.03em;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 28px;
    color: var(--muted);
  }
</style>

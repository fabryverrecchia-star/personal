---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site, zones, services } from '../data/site';
import { u } from '../lib/url';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  theme?: string;
}
const { title, description, schema = [], theme = '#0e0d0c' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  '@id': `${site.url}/#entreprise`,
  name: site.nom,
  description: `${site.metier} dans les Combrailles, à Riom et à Clermont-Ferrand : peinture intérieure, façades, volets et boiseries, décoration.`,
  url: site.url + '/',
  telephone: site.telephone.replace(/\s/g, ''),
  email: site.email,
  image: `${site.url}/og.png`,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adresse.rue || undefined,
    postalCode: site.adresse.codePostal,
    addressLocality: site.adresse.ville,
    addressRegion: site.adresse.region,
    addressCountry: 'FR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Combrailles' },
    ...zones.flatMap((z) => z.communes.map((c) => ({ '@type': 'City', name: c }))),
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '18:00',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Travaux de peinture',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.titre, description: s.court },
    })),
  },
  ...(site.siret ? { identifier: { '@type': 'PropertyValue', name: 'SIRET', value: site.siret } } : {}),
  ...(Object.keys(site.reseaux).length ? { sameAs: Object.values(site.reseaux) } : {}),
};
const ld = [business, ...schema];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="geo.region" content="FR-63" />
    <meta name="geo.placename" content={`${site.adresse.ville}, Puy-de-Dôme`} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={theme} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a href="#main" class="skip">Aller au contenu</a>
    <div class="curtain" data-curtain aria-hidden="true">
      <div class="curtain__paint"></div>
      <div class="curtain__in">
        <span class="curtain__mono">{site.monogramme}</span>
        <span class="curtain__count display" data-count>00</span>
      </div>
    </div>
    <div class="cursor" data-cursor aria-hidden="true"><span></span><em class="label">Peindre</em></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 500;
    padding: 0.7em 1em;
    background: var(--noir);
    color: var(--craie);
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }

  /* Rideau : chargement (compteur) et transitions de page */
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 400;
    pointer-events: none;
    visibility: hidden;
    color: var(--craie);
  }
  .js .curtain {
    visibility: visible;
  }
  .js:not(.ready) .curtain {
    animation: curtain-safety 0s 4s forwards;
  }
  @keyframes curtain-safety {
    to {
      visibility: hidden;
    }
  }
  .curtain__paint {
    position: absolute;
    inset: -2px;
    background: var(--curtain, var(--noir));
  }
  .curtain__in {
    position: absolute;
    inset: auto var(--gutter) calc(var(--gutter) + env(safe-area-inset-bottom));
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .curtain__mono {
    font-family: var(--script);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1;
    color: var(--bordeaux-vif);
  }
  .curtain__count {
    font-size: clamp(6rem, 26vw, 22rem);
    font-variant-numeric: tabular-nums;
  }

  /* Curseur (souris uniquement) */
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 350;
    pointer-events: none;
    display: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cursor.is-on {
    opacity: 1;
  }
  .cursor span {
    display: block;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--bordeaux-vif);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.3s,
      border-color 0.3s;
  }
  .cursor em {
    position: absolute;
    left: 18px;
    top: -6px;
    font-style: normal;
    color: var(--craie);
    opacity: 0;
    transition: opacity 0.3s;
    white-space: nowrap;
  }
  .cursor.is-link span {
    transform: scale(3.6);
  }
  .cursor.is-brush span {
    transform: scale(7);
    background: transparent;
    border: 1px solid var(--craie);
  }
  .cursor.is-brush em {
    opacity: 1;
    left: 44px;
  }
  @media (hover: hover) and (pointer: fine) {
    .has-cursor .cursor {
      display: block;
    }
  }
</style>

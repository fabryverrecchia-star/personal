# Airtable Personal Access Token — create at https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
# Access: the workspace where new lead bases should be created
AIRTABLE_TOKEN=
# Workspace ID (starts with "wsp") — open the workspace in Airtable, it's in the URL
AIRTABLE_WORKSPACE_ID=
# Optional: path to a Chromium/Chrome binary if `playwright install chromium` isn't used
# CHROMIUM_PATH=

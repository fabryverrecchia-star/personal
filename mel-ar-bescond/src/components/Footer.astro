---
import logo from '../assets/svg/logo.svg?raw';
import { site } from '../site.config';
---

<footer class="footer" data-theme="dark">
  <div class="wrap footer__wrap">
    <div class="footer__cols">
      <div>
        <p class="label footer__h">La maison</p>
        <p>{site.owners}</p>
        <p>{site.address.street}</p>
        <p>{site.address.zip} {site.address.city}</p>
      </div>
      <div>
        <p class="label footer__h">Contact</p>
        <p class="footer__mail">{site.email}</p>
        {site.phone && <p>{site.phone}</p>}
        {site.instagram && <p><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></p>}
      </div>
      <div>
        <p class="label footer__h">Commander</p>
        <p>Demande sans paiement en ligne, retrait à Louargat.</p>
        <p><a href="#commander" class="cta footer__cta">Composer mon panier <span class="cta__line"></span></a></p>
      </div>
    </div>

    <div class="footer__logo" data-footer-logo set:html={logo} aria-hidden="true" />

    <div class="footer__legal label">
      <span>© {site.harvest} {site.name}</span>
      <span>SIRET {site.siret}</span>
      <a href="#top">Haut de page</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--night);
    color: var(--ivory);
    padding-top: clamp(90px, 10vw, 150px);
    padding-bottom: calc(28px + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
  }
  .footer__wrap {
    display: grid;
    gap: clamp(60px, 8vw, 120px);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    font-weight: 300;
  }
  .footer__h {
    color: color-mix(in srgb, var(--ivory) 50%, transparent);
    margin-bottom: 1rem;
  }
  .footer__mail {
    user-select: all;
  }
  .footer__cta {
    margin-top: 1rem;
  }
  .footer__logo :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .footer__logo :global(.glyph) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--night-line);
    color: color-mix(in srgb, var(--ivory) 50%, transparent);
  }

  @media (max-width: 800px) {
    .footer__cols {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;

// Composition « désordonnée » sur 12 colonnes : colonne de départ, largeur,
// format, décalages vertical / horizontal (en vw). Les décalages négatifs font
// légèrement chevaucher certains projets. Le motif se répète au-delà de 16.
const layout = [
  { c: 2, s: 4, ar: '4 / 5', y: 0, x: 0 },
  { c: 7, s: 3, ar: '1 / 1', y: 9, x: 0 },
  { c: 11, s: 2, ar: '3 / 4', y: -2, x: 0 },
  { c: 1, s: 3, ar: '3 / 4', y: -7, x: 0 },
  { c: 5, s: 4, ar: '4 / 3', y: 3, x: -2 },
  { c: 10, s: 3, ar: '4 / 5', y: -9, x: 0 },
  { c: 3, s: 4, ar: '16 / 10', y: -4, x: 0 },
  { c: 7, s: 2, ar: '3 / 4', y: 7, x: -1.5 },
  { c: 9, s: 3, ar: '1 / 1', y: -3, x: 0 },
  { c: 1, s: 3, ar: '1 / 1', y: -6, x: 0 },
  { c: 4, s: 3, ar: '4 / 5', y: 4, x: -1 },
  { c: 8, s: 5, ar: '16 / 10', y: -8, x: -2 },
  { c: 2, s: 4, ar: '4 / 3', y: -3, x: 0 },
  { c: 6, s: 2, ar: '3 / 4', y: 6, x: -2 },
  { c: 8, s: 3, ar: '4 / 5', y: -5, x: 0 },
  { c: 11, s: 2, ar: '1 / 1', y: 4, x: -1 },
];

// Lettres de légende (a) … (z), comme sur une planche
const letter = (i: number) => String.fromCharCode(97 + (i % 26));
---

<section class="work" data-work data-view="grid" aria-labelledby="work-title">
  <div class="work__bar container">
    <h2 id="work-title" class="label">Index — <span class="figures">{projects.length}</span> projets</h2>
    <p class="work__lede">
      Une observation de projets récents : identités, sites et expériences. Chaque fragment se lit
      séparément.
    </p>
    <div class="work__toggle label" role="group" aria-label="Affichage">
      <button type="button" class="link" data-view-btn="grid" aria-pressed="true">Planche</button>
      <button type="button" class="link" data-view-btn="list" aria-pressed="false">Liste</button>
    </div>
  </div>

  <ul class="work__items container">
    {
      projects.map((project, i) => {
        const l = layout[i % layout.length];
        return (
          <li
            class="item"
            data-flip-id={project.id}
            style={`--c:${l.c};--s:${l.s};--ar:${l.ar};--y:${l.y}vw;--x:${l.x}vw;--i:${i}`}
          >
            <a href={`/work/${project.id}`} class="item__link">
              <span class="item__index caption">({letter(i)}).</span>
              <div class="item__media" data-media>
                <ProjectMedia project={project} eager={i < 3} />
              </div>
              <span class="item__title label">{project.data.title}</span>
              <span class="item__cat">{project.data.category}</span>
              <span class="item__year label figures">{project.data.year}</span>
            </a>
          </li>
        );
      })
    }
  </ul>

  <!-- Légende de la planche -->
  <ol class="work__legend container">
    {
      projects.map((project, i) => (
        <li>
          <a href={`/work/${project.id}`} class="link">
            <span class="caption">({letter(i)}).</span> {project.data.title.toLowerCase()}
            <span class="work__legend-cat">— {project.data.category.toLowerCase()}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .work {
    position: relative;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .work__bar {
    display: grid;
    grid-template-columns: 1fr minmax(0, 26rem) 1fr;
    align-items: start;
    gap: var(--gutter);
    padding-block: 1.25rem;
  }
  .work__lede {
    font-size: var(--fs-sm);
    line-height: 1.3;
  }
  .work__toggle {
    justify-self: end;
    display: flex;
    gap: 1rem;
  }
  .work__toggle button[aria-pressed='false'] {
    color: var(--muted);
  }

  /* ---------- Planche désordonnée ---------- */
  .work__items {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 1.5vw;
    padding-block: 5vw 8vw;
  }
  .item {
    position: relative;
    grid-column: var(--c) / span var(--s);
    margin-top: var(--y);
    margin-left: var(--x);
    z-index: calc(2 + var(--i));
  }
  .item:hover {
    z-index: 100;
  }
  .item__link {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      'media media media'
      'title year index';
    column-gap: 0.75rem;
    align-items: baseline;
  }
  .item__media {
    grid-area: media;
    margin-bottom: 0.45rem;
  }
  .item__media :global(.media) {
    aspect-ratio: var(--ar);
  }
  .item__title {
    grid-area: title;
  }
  .item__index {
    grid-area: index;
    font-size: var(--fs-xs);
  }
  .item__cat {
    display: none;
  }
  .item__year {
    grid-area: year;
    color: var(--muted);
  }

  /* ---------- Légende ---------- */
  .work__legend {
    columns: 4 14rem;
    column-gap: var(--gutter);
    padding-block: 1.5rem 3rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    list-style: none;
  }
  .work__legend li {
    break-inside: avoid;
    padding-block: 0.1rem;
  }
  .work__legend-cat {
    color: var(--muted);
  }

  /* ---------- Liste ---------- */
  [data-view='list'] .work__items {
    grid-template-columns: 1fr;
    gap: 0;
    padding-block: 0 4rem;
  }
  [data-view='list'] .item {
    grid-column: 1 / -1;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  [data-view='list'] .item__link {
    grid-template-columns: 3rem 5rem minmax(0, 1fr) minmax(0, 1fr) auto;
    grid-template-areas: 'index media title cat year';
    align-items: center;
    padding-block: 0.75rem;
    transition: color 0.4s var(--ease-out);
  }
  [data-view='list'] .item__media {
    margin: 0;
  }
  [data-view='list'] .item__media :global(.media) {
    aspect-ratio: 4 / 3;
  }
  [data-view='list'] .item__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--fs-lg);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  [data-view='list'] .item__cat {
    display: block;
    grid-area: cat;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  [data-view='list'] .work__legend {
    display: none;
  }
  @media (hover: hover) {
    [data-view='list'] .work__items:hover .item__link {
      color: var(--muted);
    }
    [data-view='list'] .work__items .item__link:hover {
      color: var(--fg);
    }
  }

  @media (max-width: 800px) {
    .work__bar {
      grid-template-columns: 1fr auto;
    }
    .work__lede {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .work__items {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 4vw;
    }
    .item {
      grid-column: 1 / span 4;
      margin: 0;
    }
    .item:nth-child(even) {
      grid-column: 3 / span 4;
      margin-top: -8vw;
    }
    .item:nth-child(3n) {
      grid-column: 2 / span 5;
    }
    [data-view='list'] .item__link {
      grid-template-columns: 2.5rem 4rem minmax(0, 1fr) auto;
      grid-template-areas: 'index media title year';
    }
    [data-view='list'] .item__cat {
      display: none;
    }
  }
</style>

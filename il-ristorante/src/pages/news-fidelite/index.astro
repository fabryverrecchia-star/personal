---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Rows from '../../components/Rows.astro';
import { nav } from '../../data/site';
const texts: Record<string, string> = {
  'Nos engagements': 'D’où viennent nos produits, comment on les travaille, ce qu’on fait pour durer.',
  Blog: 'Des produits, des gestes, des recettes et les personnes qui les font vivre.',
  'Fidélité UNICA': 'Votre carte de fidélité, valable dans tous nos restaurants.',
};
const imgs = ['/img/parmesan.webp', '/img/lemons.webp', '/img/drinks.webp'];
const children = nav.find((n) => n.href === '/news-fidelite')!.children!;
---
<Base title="News & Fidélité" label="News & Fidélité">
  <PageHero image="/img/pasta.webp" alt="Assiettes de pâtes vues du dessus" crumbs={[{ label: 'News & Fidélité', href: '/news-fidelite' }]} short>
    <Fragment slot="title">Les nouvelles<br /><span class="script">de la maison</span></Fragment>
    <Fragment slot="lead">Ce qui se passe en cuisine, ce qu’on a dans nos assiettes, et ce qu’on vous réserve.</Fragment>
  </PageHero>
  <section class="section wrap t-dolce">
    <Rows rows={children.map((c, i) => ({ title: c.label, text: texts[c.label], img: imgs[i], href: c.href }))} />
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { site, zones, services, teinte, type Zone } from '../data/site';
import { u } from '../lib/url';

export function getStaticPaths() {
  return zones.map((z) => ({ params: { zone: z.slug }, props: { z } }));
}
const { z } = Astro.props as { z: Zone };
const t = teinte(z.teinte);
const autres = zones.filter((o) => o.slug !== z.slug);
const dans = z.dans;
const listeCommunes = z.communes.slice(0, -1).join(', ') + ' et ' + z.communes.at(-1);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Peinture en bâtiment',
    name: `Peintre en bâtiment ${dans}`,
    provider: { '@id': `${site.url}/#entreprise` },
    areaServed: z.communes.map((c) => ({ '@type': 'City', name: c })),
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: z.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: `Peintre ${dans}`, item: pageUrl },
    ],
  },
];
---

<Base title={`${z.titreSeo} | ${site.nom}`} description={z.descriptionSeo} schema={schema} theme={t.hex}>
  <section class="zhero" style={`--c:${t.hex};--ink:${t.ink}`} data-zhero data-dark-hero={t.ink.toLowerCase() !== '#1f1d1a' ? '' : undefined}>
    <div class="wrap zhero__in">
      <div class="zchip" data-zchip aria-hidden="true">
        <span class="zchip__c"></span>
        <span class="zchip__n">{t.nom}</span>
        <span class="zchip__h">{t.hex.slice(1)} · {z.nom}</span>
      </div>
      <nav class="crumbs" aria-label="Fil d’Ariane" data-hero-fade>
        <a href={u('/')} class="link-u">Accueil</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Peintre {dans}</span>
      </nav>

      <h1 class="zhero__t serif" data-hero-title>
        <span class="line"><span class="line-inner">Peintre en bâtiment</span></span>
        <span class="line"><span class="line-inner"><em>{dans}</em></span></span>
      </h1>

      <div class="zhero__foot" data-hero-fade>
        <p class="zhero__lede">{z.accroche}</p>
        <a href="#contact" class="btn zhero__btn" data-magnetic>
          Demander un devis gratuit
          <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
        </a>
      </div>
    </div>
  </section>


  <section class="section">
    <div class="wrap grid">
      <p class="eyebrow eyebrow--dot muted zintro__eye">{z.nom}</p>
      <p class="zintro__t serif" data-words>{z.intro}</p>
    </div>
  </section>

  <section class="section zterrain" aria-labelledby="terrain-t">
    <div class="wrap">
      <h2 id="terrain-t" class="serif zsec__t" data-split>
        Un travail adapté <em>à votre logement.</em>
      </h2>
      <ul class="tcards">
        {
          z.terrain.map((c, i) => (
            <li class="tcard" data-reveal="fade" style={`--c:${t.hex}`}>
              <span class="tcard__n serif">0{i + 1}</span>
              <h3 class="tcard__t">{c.titre}</h3>
              <p class="muted">{c.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section zserv" aria-labelledby="zserv-t">
    <div class="wrap">
      <h2 id="zserv-t" class="serif zsec__t" data-split>
        Nos services <em>{dans}</em>
      </h2>
      <ul class="slist">
        {
          services.map((s) => {
            const st = teinte(s.teinte);
            return (
              <li data-reveal="fade">
                <a href={u(`/#${s.id}`)} class="srow">
                  <span class="srow__dot" style={`--c:${st.hex}`} />
                  <span class="srow__t serif">{s.titre}</span>
                  <span class="srow__c muted">{s.court}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section zcom" aria-labelledby="zcom-t">
    <div class="wrap grid">
      <div class="zcom__head">
        <h2 id="zcom-t" class="serif zsec__t" data-split>
          Communes <em>desservies</em>
        </h2>
      </div>
      <p class="zcom__p" data-reveal="fade">
        Nous intervenons notamment à {listeCommunes}. Votre commune n’apparaît pas ? Contactez-nous :
        la visite reste gratuite dans un rayon d’environ quarante kilomètres autour de {site.adresse.ville}.
      </p>
    </div>
  </section>

  <Faq items={z.faq} titre={`Peintre ${dans} : vos questions`} />

  <section class="section zother" aria-labelledby="zother-t">
    <div class="wrap">
      <p id="zother-t" class="eyebrow eyebrow--dot muted">Nous intervenons également</p>
      <ul class="olist">
        {
          autres.map((o) => {
            const ot = teinte(o.teinte);
            return (
              <li>
                <a href={u(`/${o.slug}/`)} class="orow" style={`--c:${ot.hex}`}>
                  <span class="serif">{o.nom === 'Combrailles' ? 'Dans les Combrailles' : `À ${o.nom}`}</span>
                  <span class="muted">{o.court}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <Contact zone={dans} />
</Base>

<style>
  .zhero {
    background: var(--c);
    color: var(--ink);
    --muted: color-mix(in srgb, var(--ink) 70%, transparent);
    --line: color-mix(in srgb, var(--ink) 25%, transparent);
    min-height: 92svh;
    display: flex;
    padding-top: calc(110px + env(safe-area-inset-top));
    padding-bottom: 40px;
  }
  .zchip {
    position: relative;
    align-self: flex-end;
    margin: -8px 6px -40px 0;
    width: clamp(92px, 16vw, 230px);
    padding: 8px 8px 12px;
    border-radius: 10px;
    background: #fbf9f5;
    color: #1f1d1a;
    transform: rotate(6deg);
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.5);
    display: grid;
    gap: 4px;
    font-size: clamp(10px, 1.2vw, 13px);
    line-height: 1.2;
  }
  .crumbs {
    order: -1;
  }
  @media (min-width: 1024px) {
    .zchip {
      position: absolute;
      right: var(--gutter);
      top: 140px;
      margin: 0;
    }
  }
  .zchip__c {
    aspect-ratio: 1 / 1.1;
    border-radius: 5px;
    margin-bottom: 6px;
    background: linear-gradient(to bottom, var(--c) 0 62%, color-mix(in srgb, var(--c) 55%, #fbf9f5) 62% 81%, color-mix(in srgb, var(--c) 25%, #fbf9f5) 81%);
  }
  .zchip__n {
    font-weight: 600;
  }
  .zchip__h {
    opacity: 0.55;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .zhero {
    position: relative;
    overflow: hidden;
  }
  .zhero__in {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: var(--fs-s);
    color: var(--muted);
  }
  .zhero__t {
    font-size: clamp(3rem, 11.5vw, 11rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .zhero__foot {
    display: grid;
    gap: 22px;
  }
  .zhero__lede {
    font-size: var(--fs-m);
    line-height: 1.3;
    max-width: 30ch;
  }
  .zhero__btn {
    --b-bg: var(--ink);
    --b-fg: var(--c);
    justify-self: start;
  }
  @media (min-width: 1024px) {
    .zhero__foot {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  .zintro__eye {
    grid-column: 1 / -1;
    margin-bottom: 28px;
  }
  .zintro__t {
    grid-column: 1 / -1;
    font-size: clamp(1.9rem, 4.6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  @media (min-width: 1024px) {
    .zintro__eye {
      grid-column: 1 / 3;
      margin-top: 1em;
    }
    .zintro__t {
      grid-column: 3 / -1;
    }
  }

  .zsec__t {
    font-size: var(--fs-xl);
    max-width: 16ch;
  }
  .zterrain,
  .zserv,
  .zcom {
    padding-top: 0;
  }
  .tcards {
    display: grid;
    gap: 14px;
    margin-top: 48px;
  }
  .tcard {
    position: relative;
    display: grid;
    gap: 12px;
    padding: 28px;
    border-radius: calc(var(--radius) * 1.4);
    background: var(--chaux-2);
    overflow: hidden;
  }
  .tcard::before {
    content: '';
    position: absolute;
    right: -40px;
    top: -40px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--c);
  }
  .tcard__n {
    font-size: 2.8rem;
    line-height: 1;
    font-style: italic;
  }
  .tcard__t {
    font-size: var(--fs-m);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  @media (min-width: 900px) {
    .tcards {
      grid-template-columns: repeat(3, 1fr);
    }
    .tcard {
      padding: 40px;
      min-height: 360px;
      align-content: end;
    }
  }

  .slist {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .srow {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 16px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease);
  }
  .srow__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
    grid-row: span 2;
  }
  .srow__t {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
  }
  .srow__c {
    font-size: var(--fs-s);
    margin-top: 4px;
  }
  @media (min-width: 900px) {
    .srow {
      grid-template-columns: auto 1fr 1fr;
    }
    .srow__dot {
      grid-row: auto;
    }
    .srow__c {
      margin: 0;
    }
  }
  @media (hover: hover) {
    .srow:hover {
      padding-left: 16px;
    }
  }

  .zcom__head,
  .zcom__p {
    grid-column: 1 / -1;
    margin-top: 28px;
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 60ch;
  }
  @media (min-width: 1024px) {
    .zcom__p {
      grid-column: 7 / -1;
      margin-top: 0;
    }
  }
  .clist {
    grid-column: 1 / -1;
  }
  .zcom__lede {
    margin-top: 20px;
    max-width: 40ch;
  }
  .clist {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 36px;
  }
  .clist li {
    padding: 10px 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--fs-s);
  }
  @media (min-width: 1024px) {
    .zcom__head {
      grid-column: 1 / 6;
    }
    .clist {
      grid-column: 7 / -1;
      margin-top: 0;
      align-content: start;
    }
  }

  .olist {
    margin-top: 24px;
    display: grid;
    gap: 12px;
  }
  .orow {
    display: grid;
    gap: 6px;
    padding: 28px;
    border-radius: calc(var(--radius) * 1.4);
    box-shadow: inset 0 0 0 1px var(--line);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition: color 0.5s;
  }
  .orow::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.6s var(--ease);
  }
  .orow .serif {
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
  }
  @media (hover: hover) {
    .orow:hover::before {
      transform: none;
    }
  }
  @media (min-width: 900px) {
    .olist {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { comparaisons } from '../data/site';
---

<div class="bax" data-bax>
  {
    comparaisons.length > 1 && (
      <div class="bax__tabs" role="tablist" aria-label="Choisir un chantier">
        {comparaisons.map((c, i) => (
          <button
            class="bax__tab"
            role="tab"
            id={`ba-tab-${c.id}`}
            aria-controls={`ba-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-ba-tab={i}
          >
            {c.onglet}
          </button>
        ))}
      </div>
    )
  }
  {
    comparaisons.map((c, i) => (
      <figure class="ba" data-ba id={`ba-${c.id}`} role="tabpanel" aria-labelledby={`ba-tab-${c.id}`} hidden={i !== 0}>
        <div class="ba__frame" style="--x:50%">
          <Image src={c.apres.src} alt={c.apres.alt} class="ba__img" widths={[540, 1080]} sizes="(min-width: 1024px) 40vw, 92vw" />
          <div class="ba__before">
            <Image src={c.avant.src} alt={c.avant.alt} class="ba__img" widths={[540, 1080]} sizes="(min-width: 1024px) 40vw, 92vw" />
          </div>
          <span class="ba__tag ba__tag--l">Avant</span>
          <span class="ba__tag ba__tag--r">Après</span>
          <input class="ba__range" type="range" min="0" max="100" value="50" step="0.5" aria-label={`Comparer avant et après : ${c.titre}`} data-ba-range />
          <span class="ba__line" aria-hidden="true">
            <span class="ba__knob">
              <svg viewBox="0 0 24 24"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </span>
          </span>
        </div>
        <figcaption class="ba__cap">
          <strong>{c.titre}</strong>
          <span>{c.texte}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .bax {
    display: grid;
    gap: 18px;
  }
  .bax__tabs {
    order: 3;
    display: flex;
    gap: 26px;
    justify-self: center;
  }
  .bax__tab {
    position: relative;
    padding: 8px 0;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.5;
    transition: opacity 0.4s;
  }
  .bax__tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.6s var(--ease);
  }
  .bax__tab[aria-selected='true'] {
    opacity: 1;
  }
  .bax__tab[aria-selected='true']::after {
    transform: scaleX(1);
  }
  .ba {
    display: grid;
    gap: 14px;
  }
  .ba[hidden] {
    display: none;
  }
  .ba__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
    background: var(--basalte-2);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
  }
  .ba__frame :global(.ba__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--x)) 0 0);
  }
  .ba__before :global(.ba__img) {
    filter: grayscale(0.85) contrast(1.05) brightness(0.92);
  }
  .ba__tag {
    position: absolute;
    top: 16px;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lin);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
    pointer-events: none;
  }
  .ba__tag--l {
    left: 16px;
  }
  .ba__tag--r {
    right: 16px;
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .ba__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 1px;
    background: var(--lin);
    pointer-events: none;
  }
  .ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    border: 1px solid var(--lin);
    background: rgb(26 25 23 / 0.25);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--lin);
    display: grid;
    place-items: center;
    transition: transform 0.5s var(--ease-out);
  }
  .ba__knob svg {
    width: 20px;
  }
  .ba__frame:hover .ba__knob {
    transform: scale(1.12);
  }
  .ba__range:focus-visible ~ .ba__line .ba__knob {
    outline: 1px solid var(--argile);
    outline-offset: 4px;
  }
  .ba__cap {
    display: grid;
    gap: 4px;
    text-align: center;
  }
  .ba__cap strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.25rem;
  }
  .ba__cap span {
    color: var(--muted);
    font-size: var(--fs-s);
  }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { site, zones, services, etapes, realisations, comparaisons, type Zone } from '../data/site';
import { u } from '../lib/url';

export function getStaticPaths() {
  return zones.map((z) => ({ params: { zone: z.slug }, props: { z } }));
}
const { z } = Astro.props as { z: Zone };
const autres = zones.filter((o) => o.slug !== z.slug);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const listeCommunes = z.communes.slice(0, -1).join(', ') + ' et ' + z.communes.at(-1);
const n2 = (i: number) => String(i + 1).padStart(2, '0');
const heroImg = comparaisons[0].apres;
// Taille du nom de ville : le mot le plus long remplit la largeur
const longest = Math.max(...z.dans.split(' ').map((w) => w.length));
const bigSize = `min(${Math.min(26, 86 / (longest * 0.47)).toFixed(1)}vw, 15rem)`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Peinture en bâtiment',
    name: `Peintre en bâtiment ${z.dans}`,
    provider: { '@id': `${site.url}/#entreprise` },
    areaServed: z.communes.map((c) => ({ '@type': 'City', name: c })),
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: z.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: `Peintre ${z.dans}`, item: pageUrl },
    ],
  },
];
---

<Base title={`${z.titreSeo} | ${site.nom}`} description={z.descriptionSeo} schema={schema}>
  <section class="zhero" data-dark-hero>
    <div class="zhero__media" data-parallax-wrap aria-hidden="true">
      <Image src={heroImg.src} alt="" widths={[720, 1080]} sizes="100vw" loading="eager" class="zhero__img" data-parallax />
    </div>
    <div class="wrap zhero__ui">
      <nav class="crumbs label" aria-label="Fil d’Ariane" data-hero-fade>
        <a href={u('/')} class="link-u">Accueil</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Peintre {z.dans}</span>
      </nav>
      <h1 class="zhero__t">
        <span class="label zhero__kicker" data-hero-fade>Peintre en bâtiment</span>
        <span class="display zhero__big" data-hero-title style={`font-size:${bigSize}`}>
          {z.dans.split(' ').map((w, i, arr) => (
            <span class="line"><span class="line-inner">{i === arr.length - 1 ? <em>{w}</em> : w}</span></span>
          ))}
        </span>
      </h1>
      <div class="zhero__foot" data-hero-fade>
        <p>{z.accroche}</p>
        <a href="#contact" class="btn btn--wine" data-magnetic>
          Devis gratuit
          <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head label"><span>(01) {z.nom}</span><span class="muted">{site.adresse.ville}</span></div>
      <p class="zintro" data-words>{z.intro}</p>
    </div>
  </section>

  <section class="section dark zba">
    <div class="wrap">
      <div class="row-head label"><span>(02) Avant / après</span><span class="muted">Faites glisser</span></div>
      <div class="zba__grid">
        <h2 class="display zsec__t" data-split>La preuve <em>par l’image.</em></h2>
        <div class="zba__slider" data-reveal="fade"><BeforeAfter /></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head label"><span>(03) Notre approche</span><span class="muted">Peintre {z.dans}</span></div>
      <h2 class="display zsec__t" data-split>Un travail adapté <em>à votre logement.</em></h2>
      <ul class="tlist">
        {
          z.terrain.map((c, i) => (
            <li class="titem" data-reveal="fade">
              <span class="label titem__n">({n2(i)})</span>
              <h3 class="titem__t">{c.titre}</h3>
              <p class="muted">{c.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section zworks">
    <div class="wrap">
      <div class="row-head label"><span>(04) Réalisations</span><span class="muted">Chantiers récents</span></div>
      <ul class="zworks__grid">
        {
          realisations.slice(0, 3).map((r, i) => (
            <li class="zwork" data-reveal="fade">
              <div class="zwork__media">
                <Image src={r.image} alt={r.alt} widths={[600, 1080]} sizes="(min-width: 900px) 30vw, 92vw" />
              </div>
              <p class="label">({n2(i)}) {r.titre}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head label"><span>(05) Prestations</span><span class="muted">{services.length} savoir-faire</span></div>
      <ul class="slist">
        {
          services.map((s, i) => (
            <li data-reveal="fade">
              <a href={u('/#savoir-faire')} class="srow">
                <span class="label">({n2(i)})</span>
                <span class="display srow__t">{s.titre}</span>
                <span class="srow__c muted">{s.court}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap">
      <div class="row-head label"><span>(06) Déroulement</span><span class="muted">De la demande à la livraison</span></div>
      <ol class="zsteps">
        {
          etapes.map((e, i) => (
            <li data-reveal="fade">
              <span class="display zsteps__n">{n2(i)}</span>
              <strong>{e.titre}</strong>
              <span class="label zsteps__d">{e.duree}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head label"><span>(07) Communes desservies</span><span class="muted">~ 40 km</span></div>
      <p class="zcom" data-reveal="fade">
        Nous intervenons notamment à {listeCommunes}. Votre commune n’apparaît pas&nbsp;? Contactez-nous&nbsp;: la
        visite reste gratuite dans un rayon d’environ quarante kilomètres autour de {site.adresse.ville}.
      </p>
      <ul class="olist">
        {
          autres.map((o) => (
            <li>
              <a href={u(`/${o.slug}/`)} class="orow">
                <span class="label">Nous intervenons également</span>
                <span class="display">Peintre {o.dans}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq items={z.faq} num="08" />
  <Contact zone={z.dans} num="09" />
</Base>

<style>
  .zhero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--noir);
    color: var(--craie);
  }
  .zhero__media {
    position: absolute;
    inset: 0;
  }
  .zhero__media :global(.zhero__img) {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }
  .zhero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(14 13 12 / 0.55), transparent 25%),
      linear-gradient(to top, rgb(14 13 12 / 0.9), rgb(14 13 12 / 0.25) 60%);
  }
  .zhero__ui {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(96px + env(safe-area-inset-top));
    padding-bottom: calc(26px + env(safe-area-inset-bottom));
  }
  .crumbs {
    display: flex;
    gap: 10px;
    opacity: 0.85;
  }
  .zhero__t {
    display: grid;
    gap: 14px;
    margin-top: auto;
  }
  .zhero__big {
    font-size: clamp(3.6rem, 15vw, 15rem);
  }
  .zhero__big {
    color: rgb(239 235 228 / 0.55);
  }
  .zhero__big :global(em) {
    color: var(--craie);
  }
  .zhero__foot {
    display: grid;
    gap: 18px;
    margin-top: 22px;
  }
  .zhero__foot p {
    max-width: 40ch;
    opacity: 0.85;
  }
  .zhero__foot .btn {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .zhero__foot {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .zintro {
    font-size: clamp(1.7rem, 3.8vw, 3.6rem);
    font-weight: 500;
    font-stretch: 88%;
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 26ch;
  }
  .zsec__t {
    font-size: var(--fs-xl);
    max-width: 14ch;
  }
  .zba {
    --line: rgb(255 255 255 / 0.16);
    --muted: rgb(255 255 255 / 0.62);
  }
  .zba__grid {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 1024px) {
    .zba__grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
    .zba__slider {
      max-width: 560px;
      width: 100%;
      justify-self: end;
    }
  }
  .tlist {
    margin-top: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line);
  }
  .titem {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 14px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .titem__n {
    color: var(--bordeaux);
    padding-top: 0.35em;
  }
  .titem__t {
    font-size: var(--fs-m);
    font-weight: 600;
  }
  .titem p {
    grid-column: 2;
    max-width: 56ch;
  }
  @media (min-width: 1024px) {
    .titem {
      grid-template-columns: 6rem 1fr 1.2fr;
    }
    .titem p {
      grid-column: 3;
    }
  }
  .zworks__grid {
    display: grid;
    gap: 24px;
  }
  .zwork {
    display: grid;
    gap: 10px;
  }
  .zwork__media {
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
  }
  .zwork__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .zwork:hover :global(img) {
    transform: scale(1.04);
  }
  @media (min-width: 900px) {
    .zworks__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .slist {
    border-top: 1px solid var(--line);
  }
  .srow {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 14px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.3s;
  }
  .srow__t {
    font-size: clamp(2rem, 5vw, 3.8rem);
  }
  .srow__c {
    grid-column: 2;
  }
  .srow:hover {
    color: var(--bordeaux);
  }
  @media (min-width: 1024px) {
    .srow {
      grid-template-columns: 6rem 1fr auto;
    }
    .srow__c {
      grid-column: 3;
    }
  }
  .zsteps {
    display: grid;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .zsteps li {
    display: grid;
    grid-template-columns: 3.4rem 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }
  .zsteps__n {
    font-size: 2.6rem;
    color: var(--bordeaux-vif);
  }
  .zsteps__d {
    opacity: 0.6;
    text-align: right;
  }
  @media (min-width: 900px) {
    .zsteps {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 32px;
    }
  }
  .zcom {
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    max-width: 62ch;
    color: var(--muted);
  }
  .olist {
    margin-top: 40px;
    display: grid;
    gap: 8px;
  }
  .orow {
    display: grid;
    gap: 8px;
    padding: 24px;
    background: var(--noir);
    color: var(--craie);
    transition: background 0.4s;
  }
  .orow .label {
    opacity: 0.6;
  }
  .orow .display {
    font-size: clamp(2rem, 5vw, 3.6rem);
  }
  .orow:hover {
    background: var(--bordeaux);
  }
  @media (min-width: 900px) {
    .olist {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { site, zones, services, telHref, photos } from '../data/site';
interface Props {
  zone?: string;
}
const { zone } = Astro.props;
const communes = zones.flatMap((z) => z.communes);
---

<section class="contact" id="contact" aria-labelledby="contact-t">
  <div class="contact__media" data-parallax-wrap>
    <Image src={photos.arche.src} alt={photos.arche.alt} widths={[600, 1000]} sizes="(min-width: 1024px) 45vw, 100vw" class="contact__img" data-parallax />
  </div>

  <div class="contact__body">
    <p class="label muted">Contact</p>
    <h2 id="contact-t" class="display contact__t" data-split>Parlons de <em>votre projet</em></h2>
    <p class="prose contact__p">
      Décrivez-nous les pièces, les surfaces et vos délais. Nous vous rappelons pour convenir d’une visite{zone ? ` ${zone}` : ''},
      à l’issue de laquelle vous recevez un devis détaillé, gratuit et sans engagement.
    </p>

    <a href={telHref} class="contact__tel title" data-magnetic>{site.telephone}</a>
    <p class="contact__mail"><a href={`mailto:${site.email}`} class="link-u">{site.email}</a></p>

    <form class="form" data-form novalidate>
      <div class="field">
        <label for="f-nom" class="label">Nom</label>
        <input id="f-nom" name="nom" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-tel" class="label">Téléphone</label>
        <input id="f-tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" required />
      </div>
      <div class="field field--full">
        <label for="f-commune" class="label">Commune du chantier</label>
        <input id="f-commune" name="commune" list="communes" autocomplete="address-level2" />
        <datalist id="communes">{communes.map((c) => <option value={c} />)}</datalist>
      </div>
      <fieldset class="field field--full">
        <legend class="label">Nature des travaux</legend>
        <div class="chips">
          {
            services.map((s) => (
              <label class="chip">
                <input type="checkbox" name="travaux" value={s.titre} />
                <span>{s.titre}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="field field--full">
        <label for="f-msg" class="label">Votre projet</label>
        <textarea id="f-msg" name="message" rows="3"></textarea>
      </div>
      <div class="form__foot field--full">
        <button type="submit" class="btn btn--solid" data-magnetic>Envoyer la demande</button>
        <p class="form__note label muted" data-form-note role="status">{site.delaiReponse}</p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    display: grid;
    background: var(--lin-2);
  }
  .contact__media {
    position: relative;
    height: 62svh;
    overflow: hidden;
  }
  .contact__media :global(.contact__img) {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }
  .contact__body {
    display: grid;
    gap: 22px;
    align-content: center;
    padding: clamp(64px, 10vw, 140px) var(--gutter);
  }
  .contact__t {
    font-size: var(--fs-xl);
  }
  .contact__tel {
    justify-self: start;
    margin-top: 12px;
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-variant-numeric: lining-nums;
    border-bottom: 1px solid var(--line);
    padding-bottom: 6px;
    transition: color 0.4s;
  }
  @media (hover: hover) and (pointer: fine) {
    .contact__tel:hover {
      color: var(--argile);
    }
  }
  .contact__mail {
    font-size: var(--fs-s);
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 5fr 7fr;
      min-height: 100vh;
    }
    .contact__media {
      height: auto;
    }
    .contact__body {
      padding-inline: clamp(48px, 7vw, 120px);
    }
  }
  .form {
    display: grid;
    gap: 22px;
    margin-top: 28px;
  }
  @media (min-width: 700px) {
    .form {
      grid-template-columns: 1fr 1fr;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: grid;
    gap: 4px;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .field .label {
    color: var(--muted);
    padding: 0;
    margin-bottom: 4px;
  }
  .field input,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: 1.05rem;
    color: inherit;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    padding: 8px 0 12px;
    resize: vertical;
    transition: border-color 0.3s;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--basalte);
  }
  .field [aria-invalid='true'] {
    border-color: #9b3b2b;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    position: relative;
  }
  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .chip span {
    display: inline-block;
    padding: 9px 14px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--fs-s);
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .chip input:checked + span {
    background: var(--basalte);
    color: var(--lin);
  }
  .chip input:focus-visible + span {
    outline: 1px solid var(--argile);
    outline-offset: 2px;
  }
  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 8px;
  }
</style>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Rows from '../../components/Rows.astro';
import CtaBand from '../../components/CtaBand.astro';
const jobs = [
  { title: 'Chef de cuisine', text: 'Vous menez la brigade, construisez la carte de saison avec nous et transmettez les bons gestes.', img: '/img/chef.webp', href: '#' },
  { title: 'Cuisinier, commis', text: 'Pétrir, trancher, saisir, dresser : vous apprenez une cuisine faite maison, du produit brut à l’assiette.', img: '/img/chef-2.webp', href: '#' },
  { title: 'Pizzaiolo', text: 'La pâte, le four, le bon geste au bon moment. Une pizza étalée à la main, à chaque commande.', img: '/img/dough.webp', href: '#' },
  { title: 'Serveur, chef de rang', text: 'Vous accueillez, conseillez et racontez nos plats. Le lien direct avec nos convives, c’est vous.', img: '/img/table.webp', href: '#' },
  { title: 'Barman', text: 'Aperitivo, vins italiens, cafés : le bar est souvent le premier sourire de la soirée.', img: '/img/bar.webp', href: '#' },
  { title: 'Directeur de restaurant', text: 'Vous pilotez une équipe, un lieu, des résultats, avec l’appui des équipes support.', img: '/img/interior-teal.webp', href: '#' },
];
---
<Base title="Nos métiers" description="Cuisine, salle, direction : découvrez les métiers d’Il Ristorante.">
  <PageHero image="/img/chef.webp" alt="Un chef dresse une assiette" crumbs={[{ label: 'Il Ristorante recrute', href: '/recrute' }, { label: 'Nos métiers', href: '/recrute/nos-metiers' }]} short>
    <Fragment slot="title">Nos <span class="script">métiers</span></Fragment>
    <Fragment slot="lead">En cuisine comme en salle, des métiers de gestes, de produits et de rencontres.</Fragment>
  </PageHero>
  <section class="section wrap t-dolce">
    <div class="sec-head"><span class="eyebrow">En restaurant</span><span class="idx">{jobs.length}</span></div>
    <Rows rows={jobs} />
  </section>
  <CtaBand href="#" label="Postuler" eyebrow="Votre métier n’est pas dans la liste ?">Écrivez-<span class="script">nous</span></CtaBand>
</Base>

---
interface Props {
  items: readonly { q: string; r: string }[];
  titre?: string;
  num?: string;
}
const { items, titre = 'Questions fréquentes', num = '07' } = Astro.props;
---

<section class="faq section" aria-labelledby="faq-t">
  <div class="wrap">
    <div class="row-head label">
      <span>({num}) Questions</span>
      <span class="muted">{items.length} réponses</span>
    </div>
    <div class="faq__grid">
      <h2 id="faq-t" class="display faq__t" data-split>{titre}</h2>
      <div class="faq__list">
        {
          items.map((it, i) => (
            <details class="faq__item" data-reveal="fade">
              <summary>
                <span class="label muted">{String(i + 1).padStart(2, '0')}</span>
                <h3>{it.q}</h3>
                <span class="faq__plus" aria-hidden="true" />
              </summary>
              <div class="faq__a">
                <p>{it.r}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: 40px;
  }
  .faq__t {
    font-size: clamp(2.8rem, 7vw, 6.4rem);
  }
  @media (min-width: 1024px) {
    .faq__grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }
    .faq__t {
      position: sticky;
      top: 110px;
      align-self: start;
    }
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 2.4rem 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 24px 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-size: var(--fs-m);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .faq__plus {
    position: relative;
    width: 16px;
    height: 16px;
    align-self: center;
    transition: transform 0.6s var(--ease);
  }
  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 16px;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
  }
  .faq__plus::after {
    transform: rotate(90deg);
  }
  details.is-open .faq__plus,
  html:not(.js) details[open] .faq__plus {
    transform: rotate(135deg);
    color: var(--bordeaux);
  }
  .faq__a {
    overflow: hidden;
  }
  .faq__a > p {
    max-width: 60ch;
    padding: 0 0 26px 2.4rem;
    color: var(--muted);
  }
</style>

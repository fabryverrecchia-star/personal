---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title: string; description?: string; label?: string; image?: string }
const {
  title,
  description = 'Il Ristorante, la cucina italiana depuis 2006 : produits italiens, cuisine faite maison, 23 restaurants en France. Réservez votre table.',
  label = title,
  image = '/img/site/home-hero.webp',
} = Astro.props;
const fullTitle = title === 'Accueil' ? 'Il Ristorante — La Cucina Italiana' : `${title} — Il Ristorante`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11573b" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Inter-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/MeaCulpa-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SaloPaolo-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-label={label}>
    <div class="loader" transition:persist="loader" data-loader>
      <div class="loader-inner">
        <img class="loader-medal" src="/brand/monogramme/medaillon-dolce-on-giardino.svg" alt="" />
        <p class="loader-count"><small>Depuis</small><span data-loader-count>2006</span></p>
      </div>
      <div class="loader-bar"><i data-loader-bar></i></div>
    </div>

    <canvas class="gl" transition:persist="gl" data-gl-canvas aria-hidden="true"></canvas>

    <div transition:persist="chrome">
      <Header />
      <div class="fab">
        <a class="book" href="/reserver" data-magnetic>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
          <span>Réserver votre table</span>
        </a>
        <a class="bag" href="https://commandes.ilristorante.fr/home/places" target="_blank" rel="noopener" aria-label="Commander en Click & Collect" data-magnetic>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>
        </a>
      </div>
      <div class="curtain" data-curtain aria-hidden="true">
        <div class="curtain-panel" data-curtain-panel></div>
        <div class="curtain-panel" data-curtain-panel></div>
        <div class="curtain-label" data-curtain-label>
          <img src="/brand/monogramme/medaillon-lisere-dolce.svg" alt="" />
          <span data-curtain-text></span>
        </div>
      </div>
      <dialog class="player" data-player aria-label="Lecteur vidéo">
        <button class="player-close" type="button" data-player-close aria-label="Fermer la vidéo">×</button>
        <video controls playsinline data-player-video></video>
        <p class="player-title" data-player-title></p>
      </dialog>
      <div class="cursor" data-cursor aria-hidden="true">
        <div class="cursor-dot"></div>
        <div class="cursor-label" data-cursor-label></div>
      </div>
    </div>

    <main data-page>
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
